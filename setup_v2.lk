// Phase 1 Step 2 — migrate v1 (pages/posts) → v2 versioned content core.
// Re-renders body_html from body_md (option B) and reports any diff vs the stored
// v1 body_html (the golden-gate check, migration version). Zero diff = clean.
use db;
use "lib/migrate.lk";
use "lib/markdown.lk";
use "src/hooks.lk";                    // extension seam
use "extensions/commerce/schema.lk";  // registers commerce migrate/seed hooks (routes-free)
use json;
use date;
use type;
use string;
use auth;
use array;

$c = db::connect(env("DB_DSN"));

// ── v2 schema ───────────────────────────────────────────────────────────────
$migrations = [
    ["id" => "v2_0001_content", "create_table" => "content", "columns" => [
        "id"            => "pk",
        "type"          => "string(40)",
        "slug"          => "string(200)",
        "lang"          => "string(8) default=tr",
        "status"        => "string(20) default=draft",
        "current_rev"   => "int default=0",
        "published_rev" => "int default=0",
        "created_at"    => "int default=0",
        "updated_at"    => "int default=0"
    ]],
    ["id" => "v2_0002_revisions", "create_table" => "revisions", "columns" => [
        "id"          => "pk",
        "content_id"  => "int",
        "rev_no"      => "int",
        "title"       => "string(200)",
        "body_md"     => "text",
        "body_html"   => "text",
        "fields_json" => "text",
        "author_id"   => "int default=0",
        "created_at"  => "int default=0",
        "note"        => "string(200)"
    ]],
    ["id" => "v2_0003_types", "create_table" => "content_types", "columns" => [
        "id"          => "pk",
        "slug"        => "string(40) unique",
        "label"       => "string(80)",
        "url_pattern" => "string(120)",
        "fields_json" => "text"
    ]],
    ["id" => "v2_0006_users", "create_table" => "users", "columns" => [
        "id"            => "pk",
        "username"      => "string(80) unique",
        "password_hash" => "text",
        "role"          => "string(20) default=editor",
        "created_at"    => "int default=0"
    ]],
    ["id" => "v2_0007_settings", "create_table" => "settings", "columns" => [
        "id"   => "pk",
        "ns"   => "string(40)",
        "skey" => "string(80)",
        "sval" => "text"
    ]],
    ["id" => "v2_0008_form_submissions", "create_table" => "form_submissions", "columns" => [
        "id"         => "pk",
        "form_key"   => "string(80)",
        "data_json"  => "text",
        "created_at" => "int default=0"
    ]],
    ["id" => "v2_0010_roles", "create_table" => "roles", "columns" => [
        "id"        => "pk",
        "name"      => "string(40) unique",
        "label"     => "string(80)",
        "perms"     => "text",
        "is_system" => "int default=0"
    ]],
    ["id" => "v2_0011_forms", "create_table" => "forms", "columns" => [
        "id"          => "pk",
        "fkey"        => "string(80) unique",
        "title"       => "string(120)",
        "fields_json" => "text",
        "created_at"  => "int default=0"
    ]],
    ["id" => "v2_0012_menus", "create_table" => "menus", "columns" => [
        "id"         => "pk",
        "location"   => "string(40) unique",
        "items_json" => "text"
    ]]
];
migrate_run($c, $migrations);
// Commerce (orders / order_items / coupons) is an EXTENSION — it owns its schema.
// The extension overrides xp_migrate (commerce/schema.lk); the core default is a no-op.
xp_migrate($c);
// Composite uniqueness: a slug is unique per (lang, type) — a page and a post may
// share a slug (different URL namespaces). migrate has no composite-unique DSL, so
// create it directly.
db::exec($c, "CREATE UNIQUE INDEX IF NOT EXISTS idx_content_lang_type_slug ON content(lang, type, slug)", []);
db::exec($c, "CREATE UNIQUE INDEX IF NOT EXISTS idx_settings_ns_key ON settings(ns, skey)", []);

// Idempotent column add (SQLite has no ADD COLUMN IF NOT EXISTS) — a small
// migration primitive so tables can grow columns on later releases safely.
function ensure_column($c, $table, $col, $decl) {
    $info = db::query($c, "PRAGMA table_info(" . $table . ")", []);
    $found = false;
    foreach ($info as $ci) { if ($ci["name"] == $col) { $found = true; } }
    if (!$found) { db::exec($c, "ALTER TABLE " . $table . " ADD COLUMN " . $col . " " . $decl, []); }
}
// (commerce's orders/order_items/coupons columns are defined in its own schema hook)

// Scheduled publishing: a nullable ISO datetime ("YYYY-MM-DD HH:MM:SS"). When set
// and in the future, save_content holds published_rev at 0 (not publicly visible);
// a per-request before_route sweep (activate_scheduled) flips it live once due. No
// new read query needed — visibility stays gated by published_rev > 0.
ensure_column($c, "content", "publish_at", "TEXT");
db::exec($c, "CREATE INDEX IF NOT EXISTS idx_content_publish_at ON content(publish_at)", []);

// Modül konfigürasyonu (spine): content_types.config_json — sidebar grubu, ikon,
// tekil/çoğul etiket, liste kolonları, filtreler, sıra, public bayrağı. Tüm anahtarlar
// opsiyonel; eksikler load_type() içinde varsayılanla dolar (src/types.lk).
ensure_column($c, "content_types", "config_json", "TEXT");

// Wave 2 — İletişim modülü: gönderim yaşam döngüsü (Destek Biletleri). status
// acik|islemde|kapali, notes düz metin (satır-satır eklenir), updated_at son işlem.
// Eski satırlar DEFAULT ile 'acik' kalır; idempotent.
ensure_column($c, "form_submissions", "status", "VARCHAR(20) DEFAULT 'acik'");
ensure_column($c, "form_submissions", "notes", "TEXT");
ensure_column($c, "form_submissions", "updated_at", "INTEGER DEFAULT 0");
db::exec($c, "CREATE INDEX IF NOT EXISTS idx_form_subs_key_status ON form_submissions(form_key, status)", []);

// Media library (uploads — NOT versioned content). The v1 baseline (setup.lk) created
// this table, so the live DB already has it; but a FRESH v2-only clone would not, and
// /admin/media + upload would 500 ("first example doesn't run"). Create it idempotently
// so a clean clone works out of the box; on the live DB this is a no-op.
db::exec($c, "CREATE TABLE IF NOT EXISTS media (id INTEGER PRIMARY KEY AUTOINCREMENT, sha_name VARCHAR(80) UNIQUE, original VARCHAR(255), mime VARCHAR(80), size INTEGER DEFAULT 0, created_at INTEGER DEFAULT 0)", []);

// ── seed built-in types ─────────────────────────────────────────────────────
function seed_type($c, $slug, $label, $url, $fields) {
    $ex = db::query($c, "SELECT id FROM content_types WHERE slug = ?", [$slug]);
    if (count($ex) == 0) {
        db::exec($c, "INSERT INTO content_types (slug, label, url_pattern, fields_json) VALUES (?, ?, ?, ?)",
            [$slug, $label, $url, json::encode($fields)]);
    }
}
// Modül şablonu: tip yoksa fields+config ile oluştur; varsa ve config_json boşsa
// SADECE config'i doldur (mevcut alan tanımlarına/içeriğe dokunmaz — idempotent).
function seed_module($c, $slug, $label, $url, $fields, $config) {
    $ex = db::query($c, "SELECT id, config_json FROM content_types WHERE slug = ?", [$slug]);
    if (count($ex) == 0) {
        db::exec($c, "INSERT INTO content_types (slug, label, url_pattern, fields_json, config_json) VALUES (?, ?, ?, ?, ?)",
            [$slug, $label, $url, json::encode($fields), json::encode($config)]);
        return;
    }
    ensure_module_config($c, $slug, $config);
}
// Var olan bir tipe config_json yoksa yaz (eski kurulumlar: page/post/haber/… ve
// uzantı tipleri, ör. commerce'in product'ı).
function ensure_module_config($c, $slug, $config) {
    $ex = db::query($c, "SELECT id, config_json FROM content_types WHERE slug = ?", [$slug]);
    if (count($ex) == 0) { return; }
    $cur = $ex[0]["config_json"];
    if ($cur == null || $cur == "" || $cur == "null") {
        db::exec($c, "UPDATE content_types SET config_json = ? WHERE slug = ?", [json::encode($config), $slug]);
    }
}
function mod_cfg($group, $icon, $singular, $plural, $order, $public, $cols, $filters) {
    return ["group" => $group, "icon" => $icon, "singular" => $singular, "plural" => $plural,
            "order" => $order, "public" => $public, "list_columns" => $cols, "filters" => $filters];
}
$common = [
    ["name" => "title", "type" => "text",     "required" => true],
    ["name" => "body",  "type" => "markdown", "required" => false]
];
$std_cols = ["title", "status", "updated_at"];
seed_module($c, "page", "Sayfalar", "/{slug}", $common,
    mod_cfg("kurumsal", "📄", "Sayfa", "Sayfalar", 10, true, $std_cols, ["status"]));
seed_module($c, "post", "Blog Yazıları", "/blog/{slug}", $common,
    mod_cfg("icerik", "✍", "Blog Yazısı", "Blog Yazıları", 5, true, $std_cols, ["status"]));

// ── module templates (spine) — a universal install starts with these modules ──
// Each is a full module (auto CRUD + API + optional public URL). Idempotent: an
// existing type keeps its fields/content; only a missing config_json is filled.
seed_module($c, "slider", "Slider", "", [
    ["name" => "image",    "type" => "image", "required" => true],
    ["name" => "title",    "type" => "text",  "required" => true],
    ["name" => "subtitle", "type" => "text"],
    ["name" => "link",     "type" => "url"],
    ["name" => "order",    "type" => "int"]
], mod_cfg("kurumsal", "🖼", "Slayt", "Slider", 20, false, ["image", "title", "order", "status"], ["status"]));
seed_module($c, "haber", "Haberler", "/haber/{slug}", [
    ["name" => "title", "type" => "text",     "required" => true],
    ["name" => "image", "type" => "image"],
    ["name" => "body",  "type" => "markdown"]
], mod_cfg("icerik", "📰", "Haber", "Haberler", 10, true, ["image", "title", "status", "updated_at"], ["status"]));
seed_module($c, "duyuru", "Duyurular", "/duyuru/{slug}", $common,
    mod_cfg("icerik", "📢", "Duyuru", "Duyurular", 20, true, $std_cols, ["status"]));
seed_module($c, "galeri", "Galeri", "/galeri/{slug}", [
    ["name" => "title",  "type" => "text",    "required" => true],
    ["name" => "images", "type" => "gallery"]
], mod_cfg("icerik", "🖼", "Galeri", "Galeri", 30, true, ["title", "images", "status", "updated_at"], ["status"]));
seed_module($c, "video", "Videolar", "/video/{slug}", [
    ["name" => "title",       "type" => "text", "required" => true],
    ["name" => "url",         "type" => "url",  "required" => true],
    ["name" => "description", "type" => "textarea"]
], mod_cfg("icerik", "🎬", "Video", "Videolar", 40, true, ["title", "url", "status", "updated_at"], ["status"]));
seed_module($c, "proje", "Projeler", "/proje/{slug}", [
    ["name" => "title",   "type" => "text",     "required" => true],
    ["name" => "body",    "type" => "markdown"],
    ["name" => "image",   "type" => "image"],
    ["name" => "gallery", "type" => "gallery"]
], mod_cfg("icerik", "🏗", "Proje", "Projeler", 50, true, ["image", "title", "status", "updated_at"], ["status"]));
seed_module($c, "etkinlik", "Etkinlikler", "/etkinlik/{slug}", [
    ["name" => "title",    "type" => "text",     "required" => true],
    ["name" => "body",     "type" => "markdown"],
    ["name" => "date",     "type" => "date"],
    ["name" => "location", "type" => "text"],
    ["name" => "image",    "type" => "image"]
], mod_cfg("icerik", "📅", "Etkinlik", "Etkinlikler", 60, true, ["title", "date", "location", "status"], ["status", "location"]));

// ── seed built-in roles (RBAC) ────────────────────────────────────────────────
// admin = superuser (perms implicit, see src/rbac.lk can()); editor = a sensible
// content-focused default. Both is_system (can't be deleted). Custom roles are
// created in /admin/roles.
function seed_role($c, $name, $label, $perms, $sys) {
    $ex = db::query($c, "SELECT id FROM roles WHERE name = ?", [$name]);
    if (count($ex) == 0) {
        db::exec($c, "INSERT INTO roles (name, label, perms, is_system) VALUES (?, ?, ?, ?)", [$name, $label, json::encode($perms), $sys]);
    }
}
seed_role($c, "admin",  "Yönetici", [], 1);
seed_role($c, "editor", "Editör",   ["content", "media", "forms"], 1);

// ── seed the first admin user (once) from ADMIN_PASSWORD ──────────────────────
// The env var is the SEED password for the initial `admin` account; change it
// afterwards from /admin/users. If ADMIN_PASSWORD is unset, no admin is seeded
// (fail-loud — admin login stays disabled until a user exists).
$has_user = db::query($c, "SELECT id FROM users LIMIT 1", []);
if (count($has_user) == 0) {
    $seedpw = env("ADMIN_PASSWORD", "");
    if ($seedpw != "") {
        db::exec($c, "INSERT INTO users (username, password_hash, role, created_at) VALUES ('admin', ?, 'admin', ?)",
            [auth::hash($seedpw), date::timestamp()]);
        print("=== seeded admin user (username: admin) ===\n");
    }
}

// ── demo content (opt-in: LOOKPRESS_SEED=1, once) — a populated first run and the
// fixtures the smoke suite asserts (a tr + en product under the same slug). ──────
function seed_demo_item($c, $type, $slug, $lang, $title, $body, $fields) {
    $ex = db::query($c, "SELECT id FROM content WHERE type = ? AND slug = ? AND lang = ?", [$type, $slug, $lang]);
    if (count($ex) > 0) { return 0; }
    $ts = date::timestamp();
    db::exec($c, "INSERT INTO content (type, slug, lang, status, created_at, updated_at) VALUES (?, ?, ?, 'published', ?, ?)", [$type, $slug, $lang, $ts, $ts]);
    $cid = db::last_id($c);
    // Gövde markdown olarak yorumlanır (düz metin yine <p>…</p> olur); alan değerleri
    // (image/gallery/date/icerik-blocks JSON string) fields_json'a olduğu gibi yazılır.
    $body_html = ""; if ($body != "") { $body_html = markdown_to_html($body); }
    db::exec($c, "INSERT INTO revisions (content_id, rev_no, title, body_md, body_html, fields_json, author_id, created_at, note) VALUES (?, 1, ?, ?, ?, ?, 0, ?, 'demo seed')", [$cid, $title, $body, $body_html, json::encode($fields), $ts]);
    $rid = db::last_id($c);
    db::exec($c, "UPDATE content SET current_rev = ?, published_rev = ? WHERE id = ?", [$rid, $rid, $cid]);
    return 1;
}
// Form tanımı seed'i: fkey varsa dokunma (idempotent).
function seed_form($c, $key, $title, $fields) {
    if (count(db::query($c, "SELECT id FROM forms WHERE fkey = ?", [$key])) > 0) { return; }
    db::exec($c, "INSERT INTO forms (fkey, title, fields_json, created_at) VALUES (?, ?, ?, ?)", [$key, $title, json::encode($fields), date::timestamp()]);
}
// Bir tipe alan tanımı ekle — sadece o isimde alan YOKSA (idempotent; mevcut
// alanlara/içeriğe dokunmaz). Sayfaların blok-kompoze edilebilmesi için kullanılır.
function ensure_type_field($c, $type, $field) {
    $ex = db::query($c, "SELECT id, fields_json FROM content_types WHERE slug = ?", [$type]);
    if (count($ex) == 0) { return; }
    $defs = json::decode($ex[0]["fields_json"]);
    if ($defs == null || !type::is_array($defs)) { $defs = []; }
    foreach ($defs as $f) { if ($f["name"] == $field["name"]) { return; } }
    $defs = array::push($defs, $field);
    db::exec($c, "UPDATE content_types SET fields_json = ? WHERE slug = ?", [json::encode($defs), $type]);
}
// Ayar varsayılanı: (ns=core, skey) satırı YOKSA yaz; kullanıcının değerine dokunmaz.
function seed_setting_default($c, $key, $val) {
    if (count(db::query($c, "SELECT id FROM settings WHERE ns = 'core' AND skey = ?", [$key])) > 0) { return; }
    db::exec($c, "INSERT INTO settings (ns, skey, sval) VALUES ('core', ?, ?)", [$key, $val]);
}
// Menü: konum satırı YOKSA ya da öğe listesi boşsa yaz (idempotent).
function seed_menu_if_empty($c, $loc, $items) {
    $rows = db::query($c, "SELECT id, items_json FROM menus WHERE location = ?", [$loc]);
    if (count($rows) > 0) {
        $cur = json::decode($rows[0]["items_json"]);
        if ($cur != null && type::is_array($cur) && count($cur) > 0) { return; }
        db::exec($c, "UPDATE menus SET items_json = ? WHERE location = ?", [json::encode($items), $loc]);
        return;
    }
    db::exec($c, "INSERT INTO menus (location, items_json) VALUES (?, ?)", [$loc, json::encode($items)]);
}
// Blok kısayolu: {"type": t, "data": d}
function blk($t, $d) { return ["type" => $t, "data" => $d]; }
// Bugünden N gün sonrası, "YYYY-MM-DD" (etkinlik tarihleri hep gelecekte kalsın).
function seed_future_date($days) { return date::format(date::timestamp() + ($days * 86400), "Y-m-d"); }
// picsum.photos — telifsiz yer-tutucu görsel (seed'e göre sabit).
function pic($seed, $w, $h) { return "https://picsum.photos/seed/" . $seed . "/" . $w . "/" . $h; }
if (env("LOOKPRESS_SEED", "0") == "1") {
    // Core demo: a plain page + a few example content types so the grouped
    // "İçerik Yönetimi" sidebar is visible out of the box. Each is a full module
    // (auto CRUD + API + public URL) — delete them or set LOOKPRESS_SEED=0 for a
    // clean start. This is exactly how you'd add "haberler / duyurular / ekipler".
    seed_demo_item($c, "page", "about", "en", "About us", "LookPress is a pure-LOOK web platform.", []);
    seed_type($c, "haber",  "Haberler",  "/haber/{slug}",  $common);
    seed_type($c, "duyuru", "Duyurular", "/duyuru/{slug}", $common);
    seed_type($c, "ekip",   "Ekipler",   "/ekip/{slug}",   $common);
    // demo forms (form builder) — visible at /forms/<key>; idempotent (fkey unique)
    seed_form($c, "basvuru", "İş Başvurusu", [
        ["name" => "ad",      "label" => "Ad Soyad", "type" => "text",     "required" => true],
        ["name" => "email",   "label" => "E-posta",  "type" => "email",    "required" => true],
        ["name" => "telefon", "label" => "Telefon",  "type" => "tel",      "required" => false],
        ["name" => "mesaj",   "label" => "Mesaj",    "type" => "textarea", "required" => false]
    ]);
    // Wave 2 — İletişim grubu gerçek olsun: iletişim formu + iş başvurusu (cv_url)
    seed_form($c, "iletisim", "İletişim", [
        ["name" => "ad",    "label" => "Ad Soyad", "type" => "text",     "required" => true],
        ["name" => "email", "label" => "E-posta",  "type" => "email",    "required" => true],
        ["name" => "konu",  "label" => "Konu",     "type" => "text",     "required" => true],
        ["name" => "mesaj", "label" => "Mesaj",    "type" => "textarea", "required" => true]
    ]);
    seed_form($c, "is-basvuru", "İş Başvurusu", [
        ["name" => "ad",       "label" => "Ad Soyad",      "type" => "text",     "required" => true],
        ["name" => "email",    "label" => "E-posta",       "type" => "email",    "required" => true],
        ["name" => "telefon",  "label" => "Telefon",       "type" => "tel",      "required" => false],
        ["name" => "pozisyon", "label" => "Pozisyon",      "type" => "text",     "required" => true],
        ["name" => "cv_url",   "label" => "CV bağlantısı", "type" => "url",      "required" => false],
        ["name" => "mesaj",    "label" => "Mesaj",         "type" => "textarea", "required" => false]
    ]);
    print("=== seeded core demo content (en page) + example types (haber/duyuru/ekip) + demo forms (basvuru/iletisim/is-basvuru) ===\n");
}

// ── Dikey demo preset'leri (LOOKPRESS_PRESET = kurumsal | haber | eticaret) ────
// Kapı yine LOOKPRESS_SEED=1. Varsayılan `kurumsal` (bugünkü seed, davranış aynı).
// Hepsi slug bazında idempotent; preset değiştirmek = taze veritabanı (içerik
// birikir, menü/ayar varsayılanları ilk yazanın kalır).
function seed_preset_kurumsal($c) {
    // ── Wave 3: dolu kurumsal demo site (slug bazında idempotent) ─────────────
    // Sayfalar blok-kompoze edilebilsin: page tipine `icerik` (blocks) alanı — yoksa.
    ensure_type_field($c, "page", ["name" => "icerik", "type" => "blocks", "required" => false]);

    // Slider (3 slayt; modül public:false — sadece slider bloğu okur)
    seed_demo_item($c, "slider", "slayt-1", "tr", "Geleceği birlikte inşa ediyoruz", "",
        ["image" => pic("lp-slide1", 1600, 700), "title" => "Geleceği birlikte inşa ediyoruz", "subtitle" => "25 yıllık deneyim, 120'den fazla tamamlanmış proje", "link" => "/proje", "order" => "1"]);
    seed_demo_item($c, "slider", "slayt-2", "tr", "Sürdürülebilir çözümler", "",
        ["image" => pic("lp-slide2", 1600, 700), "title" => "Sürdürülebilir çözümler", "subtitle" => "Enerji verimli tasarım, yerel malzeme, uzun ömürlü yapılar", "link" => "/hakkimizda", "order" => "2"]);
    seed_demo_item($c, "slider", "slayt-3", "tr", "Ekibimize katılın", "",
        ["image" => pic("lp-slide3", 1600, 700), "title" => "Ekibimize katılın", "subtitle" => "Açık pozisyonlar için başvurunuzu bekliyoruz", "link" => "/forms/is-basvuru", "order" => "3"]);

    // Haberler (4)
    seed_demo_item($c, "haber", "yeni-genel-mudurluk-binamiz-acildi", "tr", "Yeni genel müdürlük binamız açıldı",
        "İstanbul Maslak'taki yeni genel müdürlük binamız düzenlenen törenle hizmete girdi. LEED Gold sertifikalı bina, 400 çalışanımıza ev sahipliği yapacak.\n\nBina, yağmur suyu geri kazanımı ve çatı güneş panelleriyle enerji ihtiyacının yüzde 30'unu kendi üretiyor.",
        ["image" => pic("lp-haber1", 1200, 700)]);
    seed_demo_item($c, "haber", "2026-surdurulebilirlik-raporu-yayinlandi", "tr", "2026 Sürdürülebilirlik Raporu yayınlandı",
        "Karbon ayak izimizi 2020'ye göre yüzde 42 azalttık. Raporun tamamına web sitemizden ulaşabilirsiniz.\n\nRapor, tedarik zincirimizdeki 85 firmanın verisini de kapsıyor.",
        ["image" => pic("lp-haber2", 1200, 700)]);
    seed_demo_item($c, "haber", "ankara-lojistik-merkezi-projesinde-ilk-kazma", "tr", "Ankara Lojistik Merkezi projesinde ilk kazma vuruldu",
