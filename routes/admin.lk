// ── admin: primary navigation menu (8 label/url slots, no JS) ─────────────────
route("GET", "/admin/menu", function() {
    if (!is_admin()) { return response::redirect("/admin/login"); }
    if (!can("settings")) { return response::status(403, "Yetkiniz yok."); }
    $c = conn();
    $items = menu_items($c, "primary");
    $slots = [];
    foreach ([0, 1, 2, 3, 4, 5, 6, 7] as $idx) {
        $lbl = ""; $url = "";
        if ($idx < count($items)) { $lbl = $items[$idx]["label"]; $url = $items[$idx]["url"]; }
        $slots = array::push($slots, ["n" => $idx, "label" => $lbl, "url" => $url]);
    }
    return response::html(admin_view("admin_menu.html", ["slots" => $slots]));
});
route("POST", "/admin/menu", function() {
    if (!is_admin()) { return response::redirect("/admin/login"); }
    if (!can("settings")) { return response::status(403, "Yetkiniz yok."); }
    $c = conn();
    $items = [];
    foreach ([0, 1, 2, 3, 4, 5, 6, 7] as $idx) {
        $lbl = string::trim(request::post("label_" . $idx));
        $url = string::trim(request::post("url_" . $idx));
        if ($lbl != "" && $url != "") { $items = array::push($items, ["label" => $lbl, "url" => $url]); }
    }
    $ij = json::encode($items);
    if (count(db::query($c, "SELECT id FROM menus WHERE location = 'primary'", [])) > 0) {
        db::exec($c, "UPDATE menus SET items_json = ? WHERE location = 'primary'", [$ij]);
    } else {
        db::exec($c, "INSERT INTO menus (location, items_json) VALUES ('primary', ?)", [$ij]);
    }
    return response::redirect("/admin/menu");
});

// ── admin: settings (role 'admin' only) ──────────────────────────────────────
route("GET", "/admin/settings", function() {
    if (!is_admin()) { return response::redirect("/admin/login"); }
    if (!can("settings")) { return response::status(403, "Yetkiniz yok."); }
    $c = conn();
    $cur_theme = setting_get($c, "theme", "default");
    $topts = "";
    foreach (cfg_themes() as $th) {
        $sa = ""; if ($th == $cur_theme) { $sa = " selected"; }
        $topts = $topts . "<option value=\"" . $th . "\"" . $sa . ">" . $th . "</option>";
    }
    $cur_skin = setting_get($c, "skin", "default");
    $kopts = "";
    foreach (cfg_skins() as $sk) {
        $sa = ""; if ($sk == $cur_skin) { $sa = " selected"; }
        $kopts = $kopts . "<option value=\"" . $sk . "\"" . $sa . ">" . $sk . "</option>";
    }
    return response::html(admin_view("admin_settings.html", [
        "s_title"    => setting_get($c, "site_title", cfg_default_title()),
        "s_tagline"  => setting_get($c, "tagline", ""),
        "s_currency" => setting_get($c, "currency", cfg_default_currency()),
        "theme_options" => $topts,
        "skin_options" => $kopts
    ]));
});
route("POST", "/admin/settings", function() {
    if (!is_admin()) { return response::redirect("/admin/login"); }
    if (!can("settings")) { return response::status(403, "Yetkiniz yok."); }
    $c = conn();
    setting_set($c, "site_title", string::trim(request::post("site_title")));
    setting_set($c, "tagline", string::trim(request::post("tagline")));
    setting_set($c, "currency", string::trim(request::post("currency")));
    $th = request::post("theme");
    if (array::contains(cfg_themes(), $th)) { setting_set($c, "theme", $th); }
    $sk = request::post("skin");
    if (array::contains(cfg_skins(), $sk)) { setting_set($c, "skin", $sk); }
    settings_bust();
    return response::redirect("/admin/settings");
});
