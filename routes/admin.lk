// routes/admin.lk — the admin surface + JSON API + preview. Every route is gated
// by is_admin() (login) and the super-only ones by is_super() (RBAC). All admin
// pages read current_rev (draft-aware); the public API reads published_rev only.
use db;
use session;
use string;
use json;
use html;
use type;
use array;
use date;
use auth;
use file;

// ── admin auth ───────────────────────────────────────────────────────────────
route("GET", "/admin/login", function() { return response::html(admin_view("login.html", ["error" => ""])); });
route("POST", "/admin/login", function() {
    $c = conn();
    $u = request::post("username");
    $p = request::post("password");
    if ($u != null) {
        if ($p != null) {
            if ($u != "" && $p != "") {
                $rows = db::query($c, "SELECT id, password_hash, role FROM users WHERE username = ?", [$u]);
                if (count($rows) == 1) {
                    if (auth::verify($p, $rows[0]["password_hash"])) {
                        session::start(); session::regenerate();
                        session::set("uid", "" . $rows[0]["id"]);
                        session::set("uname", $u);
                        session::set("role", $rows[0]["role"]);
                        return response::redirect("/admin");
                    }
                }
            }
        }
    }
    return response::html(admin_view("login.html", ["error" => "Kullanıcı adı ya da şifre hatalı."]));
});
route("GET", "/admin/logout", function() { session::start(); session::destroy(); return response::redirect("/admin/login"); });

// Admin dashboard: core content stats + the type list. Extensions inject their own
// stat tiles ("admin.dashboard.stats") and panels ("admin.dashboard.panels") — the
// core dashboard knows nothing of orders/revenue (commerce adds those).
route("GET", "/admin", function() {
    if (!is_admin()) { return response::redirect("/admin/login"); }
    session::start();
    $c = conn();
    $uname = session::get("uname"); if ($uname == null) { $uname = ""; }
    $n_content  = type::to_int(db::query($c, "SELECT COUNT(*) AS n FROM content WHERE published_rev > 0", [])[0]["n"]);
    $n_subs     = type::to_int(db::query($c, "SELECT COUNT(*) AS n FROM form_submissions", [])[0]["n"]);
    $types = db::query($c, "SELECT slug, label FROM content_types ORDER BY label", []);
    $types_html = "";
    foreach ($types as $t) {
        $types_html = $types_html . "<li><a href=\"/admin/type/" . $t["slug"] . "\">" . html::escape($t["label"]) . "</a> <span class=\"muted\">(" . html::escape($t["slug"]) . ")</span></li>";
    }
    return response::html(admin_view("admin_dashboard.html", [
        "uname" => $uname, "is_super" => is_super(),
        "n_content" => $n_content, "n_subs" => $n_subs,
        "ext_stats" => xp_dashboard_stats(null),
        "ext_panels" => xp_dashboard_panels(null),
        "types_html" => $types_html
    ]));
});

// ── type-admin: manage content types like modules (list + create) ────────────
route("GET", "/admin/types", function() {
    if (!is_admin()) { return response::redirect("/admin/login"); }
    if (!can("types")) { return response::status(403, "Yetkiniz yok."); }
    $c = conn();
    $types = db::query($c, "SELECT slug, label, url_pattern, config_json FROM content_types ORDER BY label", []);
    $items = [];
    foreach ($types as $t) {
        $n = type::to_int(db::query($c, "SELECT COUNT(*) AS n FROM content WHERE type = ?", [$t["slug"]])[0]["n"]);
        $cfg = type_config_decode($t["slug"], $t["label"], $t["config_json"]);
        $up = $t["url_pattern"]; if ($up == null) { $up = ""; }
        $items = array::push($items, ["slug" => $t["slug"], "label" => $t["label"], "url_pattern" => $up, "n" => $n,
            "icon" => $cfg["icon"], "group" => module_group_label($cfg["group"]), "plural" => $cfg["plural"], "public" => $cfg["public"]]);
    }
    return response::html(admin_view("admin_types.html", ["items" => $items, "count" => count($types)]));
});
// Modül tanım formu verisi (yeni / düzenleme / hata-yeniden-göster) — tek yerden.
function type_def_view_data($slug, $label, $url, $fields_raw, $cfg, $edit_slug, $errors) {
    $groups = [];
    foreach (module_groups() as $g) {
        $groups = array::push($groups, ["key" => $g["key"], "label" => $g["label"], "selected" => ($g["key"] == $cfg["group"])]);
    }
    return [
        "slug" => $slug, "label" => $label, "url_pattern" => $url, "fields" => $fields_raw,
        "edit_slug" => $edit_slug, "is_edit" => ($edit_slug != ""),
        "singular" => $cfg["singular"], "plural" => $cfg["plural"], "icon" => $cfg["icon"],
        "order" => type::to_string($cfg["order"]), "public" => $cfg["public"],
        "list_columns" => string::join($cfg["list_columns"], ", "), "filters" => string::join($cfg["filters"], ", "),
        "groups" => $groups, "errors" => $errors
    ];
}
// Formdan gelen modül config'ini oku (boş alan → varsayılan; singular/plural boşsa label).
function type_def_post_config($slug, $label) {
    $cfg = type_config_defaults($slug, $label);
    $grp = request::post("group"); if ($grp == null) { $grp = ""; }
    if (array::contains(module_group_keys(), $grp)) { $cfg["group"] = $grp; }
    $ic = request::post("icon"); if ($ic != null && string::trim($ic) != "") { $cfg["icon"] = string::trim($ic); }
    $sg = request::post("singular"); if ($sg != null && string::trim($sg) != "") { $cfg["singular"] = string::trim($sg); }
    $pl = request::post("plural"); if ($pl != null && string::trim($pl) != "") { $cfg["plural"] = string::trim($pl); }
    $ord = request::post("order"); if ($ord != null && string::regex_match(string::trim($ord), "^-?[0-9]+$")) { $cfg["order"] = type::to_int(string::trim($ord)); }
    $cfg["public"] = (request::post("public") == "1");
    $cols = csv_list(request::post("list_columns")); if (count($cols) > 0) { $cfg["list_columns"] = $cols; }
    $cfg["filters"] = csv_list(request::post("filters"));
    return $cfg;
}
// GET /admin/types/new — yeni modül; ?edit=<slug> ile mevcut modülü düzenle (aynı
// form, gizli edit_slug; route bütçesi: sıfır yeni route).
route("GET", "/admin/types/new", function() {
    if (!is_admin()) { return response::redirect("/admin/login"); }
    if (!can("types")) { return response::status(403, "Yetkiniz yok."); }
    $edit = request::get("edit"); if ($edit == null) { $edit = ""; }
    if ($edit != "") {
        $t = load_type(conn(), $edit);
        if ($t == null) { return response::status(404, "No such type"); }
        $up = $t["url_pattern"]; if ($up == null) { $up = ""; }
        return response::html(admin_view("admin_type_def.html",
            type_def_view_data($t["slug"], $t["label"], $up, json::encode($t["fields"]), $t["config"], $t["slug"], [])));
    }
    return response::html(admin_view("admin_type_def.html", type_def_view_data("", "", "/{slug}",
        "[\n  {\"name\":\"title\",\"type\":\"text\",\"required\":true},\n  {\"name\":\"body\",\"type\":\"markdown\"}\n]",
        type_config_defaults("", ""), "", [])));
});
route("POST", "/admin/types/new", function() {
    if (!is_admin()) { return response::redirect("/admin/login"); }
    if (!can("types")) { return response::status(403, "Yetkiniz yok."); }
    $c = conn();
    $slug = string::trim(request::post("slug"));
    $label = string::trim(request::post("label"));
    $url = request::post("url_pattern"); if ($url == null) { $url = ""; } $url = string::trim($url);
    $fields_raw = request::post("fields");
    $edit_slug = request::post("edit_slug"); if ($edit_slug == null) { $edit_slug = ""; } $edit_slug = string::trim($edit_slug);
    $cfg = type_def_post_config($slug, $label);
    $errs = [];
    if (!string::regex_match($slug, "^[a-z][a-z0-9_]*$")) { $errs = array::push($errs, "slug must be lowercase letters/digits/underscore, starting with a letter"); }
    if ($label == "") { $errs = array::push($errs, "label is required"); }
    // url_pattern boş = public sayfa yok; doluysa {slug} içermeli
    if ($url != "" && !string::regex_match($url, "\\{slug\\}")) { $errs = array::push($errs, "url_pattern must contain {slug} (or be empty for no public page)"); }
    $fields = json::decode($fields_raw);
    if ($fields == null || !type::is_array($fields)) { $errs = array::push($errs, "fields must be valid JSON"); }
    else {
        $has_title = false;
        foreach ($fields as $f) {
            $fn = $f["name"]; if ($fn == null) { $fn = ""; }
            if ($fn == "title") { $has_title = true; }
            if (!string::regex_match($fn, "^[a-z][a-z0-9_]*$")) { $errs = array::push($errs, "field name '" . $fn . "' must be lowercase letters/digits/underscore"); }
        }
        if (!$has_title) { $errs = array::push($errs, "fields must include a 'title'"); }
    }
    $exists = count(db::query($c, "SELECT id FROM content_types WHERE slug = ?", [$slug])) > 0;
    if ($edit_slug == "") {
        if ($exists) { $errs = array::push($errs, "a type with that slug already exists"); }
    } else {
        // düzenleme: slug değişmez (içerik satırları type=slug ile bağlı)
        if ($slug != $edit_slug) { $errs = array::push($errs, "slug cannot be changed on an existing module"); }
        if (!$exists) { $errs = array::push($errs, "no such module: " . $edit_slug); }
    }
    if ($url != "") {
        $clash = db::query($c, "SELECT slug FROM content_types WHERE url_pattern = ? AND slug != ?", [$url, $slug]);
        if (count($clash) > 0) { $errs = array::push($errs, "url_pattern is already used by module '" . $clash[0]["slug"] . "'"); }
    }
    if (count($errs) > 0) {
        return response::html(admin_view("admin_type_def.html", type_def_view_data($slug, $label, $url, $fields_raw, $cfg, $edit_slug, $errs)));
    }
    if ($edit_slug == "") {
        db::exec($c, "INSERT INTO content_types (slug, label, url_pattern, fields_json, config_json) VALUES (?, ?, ?, ?, ?)", [$slug, $label, $url, json::encode($fields), json::encode($cfg)]);
    } else {
        db::exec($c, "UPDATE content_types SET label = ?, url_pattern = ?, fields_json = ?, config_json = ? WHERE slug = ?", [$label, $url, json::encode($fields), json::encode($cfg), $slug]);
    }
    types_cache_bust();   // new/changed URL live immediately (no 60s TTL lag)
    return response::redirect("/admin/type/" . $slug);
});

// ── GENERIC admin CRUD — ONE handler set for EVERY type (the type engine) ────
route("GET", "/admin/type/{type}", function() {
    if (!is_admin()) { return response::redirect("/admin/login"); }
    if (!can("content")) { return response::status(403, "Yetkiniz yok."); }
    $c = conn();
    $t = load_type($c, request::param("type"));
    if ($t == null) { return response::status(404, "No such type"); }
    // search (title) + config.filters (status / field filters) + pagination.
    // Columns come from config.list_columns; field values decode from each row's
    // revisions.fields_json — ONE query per page of rows, no per-row lookups.
    $q = string::trim(request::get("q") ?? "");
    $per = 20;
    $page = type::to_int(request::get("page") ?? "1"); if ($page < 1) { $page = 1; }
    // aktif filtre değerleri: ?f_<name>=…  (status için ?status= de kabul — eski linkler)
    $active = array::new_assoc();
    $qs = "";   // sayfalama linkleri için filtre query-string'i
    foreach ($t["config"]["filters"] as $fname) {
        $fv = request::get("f_" . $fname);
        if ($fv == null && $fname == "status") { $fv = request::get("status"); }
        if ($fv == null) { $fv = ""; }
        $fv = string::trim($fv);
        $active = array::set($active, $fname, $fv);
        if ($fv != "") { $qs = $qs . "&f_" . $fname . "=" . html::escape($fv); }
    }
    $where = "c.type = ?"; $params = [$t["slug"]];
    if ($q != "") { $where = $where . " AND r.title LIKE ?"; $params = array::push($params, "%" . $q . "%"); }
    $fw = list_filter_where($t, $active);
    $where = $where . $fw["sql"];
    foreach ($fw["params"] as $p) { $params = array::push($params, $p); }
    $total = type::to_int(db::query($c, "SELECT COUNT(*) AS n FROM content c JOIN revisions r ON r.id = c.current_rev WHERE " . $where, $params)[0]["n"]);
    $pages = ($total + $per - 1) / $per; $pages = type::to_int($pages); if ($pages < 1) { $pages = 1; }
    if ($page > $pages) { $page = $pages; }
    $offset = ($page - 1) * $per;
    $qp = $params; $qp = array::push($qp, $per); $qp = array::push($qp, $offset);
    $rows = db::query($c, "SELECT c.id, c.slug, c.status, c.lang, c.updated_at, c.publish_at, c.published_rev, r.title, r.fields_json FROM content c JOIN revisions r ON r.id = c.current_rev WHERE " . $where . " ORDER BY c.updated_at DESC LIMIT ? OFFSET ?", $qp);
    // Mark items whose publish is scheduled for later (published status but held back:
    // published_rev still 0 with a future publish_at) so the list can badge them.
    $items = [];
    foreach ($rows as $it) {
        $sch = ($it["status"] == "published" && type::to_int($it["published_rev"]) == 0 && $it["publish_at"] != null && $it["publish_at"] != "");
        $it = array::set($it, "is_scheduled", $sch);
        $sa = $it["publish_at"]; if ($sa == null) { $sa = ""; }
        $it = array::set($it, "sched_at", $sa);
        $it = array::set($it, "cells", list_row_cells($t, $it));
        $items = array::push($items, $it);
    }
    $columns = [];
    foreach ($t["config"]["list_columns"] as $col) { $columns = array::push($columns, ["name" => $col, "label" => list_col_label($t, $col)]); }
    return response::html(admin_view("admin_type_list.html", [
        "type" => $t, "items" => $items, "count" => $total,
        "q" => $q, "qs" => $qs,
        "columns" => $columns, "filter_defs" => list_filter_defs($c, $t, $active),
        "page" => $page, "pages" => $pages, "prev" => $page - 1, "next" => $page + 1,
        "has_prev" => ($page > 1), "has_next" => ($page < $pages), "multi_page" => ($pages > 1)
    ]));
});

route("GET", "/admin/type/{type}/new", function() {
    if (!is_admin()) { return response::redirect("/admin/login"); }
    if (!can("content")) { return response::status(403, "Yetkiniz yok."); }
    $c = conn();
    $t = load_type($c, request::param("type"));
    if ($t == null) { return response::status(404, "No such type"); }
    $form = fields_form_html($c, $t["fields"], null);
    return response::html(admin_view("admin_type_form.html", ["type" => $t, "action" => "/admin/type/" . $t["slug"] . "/new", "content_id" => "", "heading" => "New " . $t["label"], "fields_html" => $form, "slug" => "", "status" => "draft", "lang" => "tr", "seo_title" => "", "seo_desc" => "", "schedule" => "", "errors" => []]));
});
route("POST", "/admin/type/{type}/new", function() {
    if (!is_admin()) { return response::redirect("/admin/login"); }
    if (!can("content")) { return response::status(403, "Yetkiniz yok."); }
    $c = conn();
    $t = load_type($c, request::param("type"));
    if ($t == null) { return response::status(404, "No such type"); }
    $v = validate_post($c, $t["fields"]);
    $slug = string::trim(request::post("slug"));
    $errs = $v["errors"];
    $lang = norm_lang(request::post("lang"));
    if ($slug == "") { $errs = array::push($errs, "slug is required"); }
    if ($slug != "") { if (slug_taken($c, $t["slug"], $slug, 0, $lang)) { $errs = array::push($errs, "bu slug bu dilde zaten kullanımda"); } }
    if (count($errs) > 0) {
        $form = fields_form_html($c, $t["fields"], $v["values"]);
        return response::html(admin_view("admin_type_form.html", ["type" => $t, "action" => "/admin/type/" . $t["slug"] . "/new", "content_id" => "", "heading" => "New " . $t["label"], "fields_html" => $form, "slug" => $slug, "status" => request::post("status"), "lang" => $lang, "seo_title" => request::post("seo_title"), "seo_desc" => request::post("seo_desc"), "schedule" => request::post("publish_at"), "errors" => $errs]));
    }
    save_content($c, $t["slug"], 0, $slug, with_seo($v["values"]), request::post("status"), $lang);
    return response::redirect("/admin/type/" . $t["slug"]);
});

route("GET", "/admin/type/{type}/edit/{id}", function() {
    if (!is_admin()) { return response::redirect("/admin/login"); }
    if (!can("content")) { return response::status(403, "Yetkiniz yok."); }
    $c = conn();
    $t = load_type($c, request::param("type"));
    if ($t == null) { return response::status(404, "No such type"); }
    $rows = db::query($c, "SELECT c.slug, c.status, c.lang, c.publish_at, r.fields_json FROM content c JOIN revisions r ON r.id = c.current_rev WHERE c.id = ?", [request::param("id")]);
    if (count($rows) == 0) { return response::status(404, "No such item"); }
    $vals = json::decode($rows[0]["fields_json"]);
    $form = fields_form_html($c, $t["fields"], $vals);
    $sv_t = ""; $sv_d = "";
    if ($vals != null) { try { $sv_t = $vals["seo_title"]; } catch ($e) { $sv_t = ""; } try { $sv_d = $vals["seo_desc"]; } catch ($e) { $sv_d = ""; } }
    if ($sv_t == null) { $sv_t = ""; } if ($sv_d == null) { $sv_d = ""; }
    return response::html(admin_view("admin_type_form.html", ["type" => $t, "action" => "/admin/type/" . $t["slug"] . "/edit/" . request::param("id"), "content_id" => request::param("id"), "heading" => "Edit " . $t["label"], "fields_html" => $form, "slug" => $rows[0]["slug"], "status" => $rows[0]["status"], "lang" => $rows[0]["lang"], "seo_title" => $sv_t, "seo_desc" => $sv_d, "schedule" => schedule_input($rows[0]["publish_at"]), "errors" => []]));
});
route("POST", "/admin/type/{type}/edit/{id}", function() {
    if (!is_admin()) { return response::redirect("/admin/login"); }
    if (!can("content")) { return response::status(403, "Yetkiniz yok."); }
    $c = conn();
    $t = load_type($c, request::param("type"));
    if ($t == null) { return response::status(404, "No such type"); }
    $v = validate_post($c, $t["fields"]);
    $slug = string::trim(request::post("slug"));
    $errs = $v["errors"];
    $lang = norm_lang(request::post("lang"));
    if ($slug != "") { if (slug_taken($c, $t["slug"], $slug, type::to_int(request::param("id")), $lang)) { $errs = array::push($errs, "bu slug bu dilde zaten kullanımda"); } }
    if (count($errs) > 0) {
        $form = fields_form_html($c, $t["fields"], $v["values"]);
        return response::html(admin_view("admin_type_form.html", ["type" => $t, "action" => "/admin/type/" . $t["slug"] . "/edit/" . request::param("id"), "content_id" => request::param("id"), "heading" => "Edit " . $t["label"], "fields_html" => $form, "slug" => $slug, "status" => request::post("status"), "lang" => $lang, "seo_title" => request::post("seo_title"), "seo_desc" => request::post("seo_desc"), "schedule" => request::post("publish_at"), "errors" => $errs]));
    }
    save_content($c, $t["slug"], type::to_int(request::param("id")), $slug, with_seo($v["values"]), request::post("status"), $lang);
    return response::redirect("/admin/type/" . $t["slug"]);
});

// Content-item actions — one route per {action}/{id} (delete|duplicate|rollback).
// Registered AFTER the edit POST above, so first-match keeps edit/{id} intact; the
// existing template URLs (/delete/{id}, /duplicate/{id}, /rollback/{id}) still match.
// Folded into one handler to keep the top-level route budget small (see users note).
route("POST", "/admin/type/{type}/{action}/{id}", function() {
    if (!is_admin()) { return response::redirect("/admin/login"); }
    if (!can("content")) { return response::status(403, "Yetkiniz yok."); }
    $c = conn();
    $action = request::param("action");
    $id = request::param("id");
    $type = request::param("type");
    if ($action == "delete") {
        db::exec($c, "DELETE FROM revisions WHERE content_id = ?", [$id]);
        db::exec($c, "DELETE FROM content WHERE id = ?", [$id]);
        return response::redirect("/admin/type/" . $type);
    }
    if ($action == "duplicate") {
        $t = load_type($c, $type);
        if ($t == null) { return response::status(404, "No such type"); }
        $rows = db::query($c, "SELECT c.slug, c.lang, r.title, r.body_md, r.fields_json FROM content c JOIN revisions r ON r.id = c.current_rev WHERE c.id = ?", [$id]);
        if (count($rows) == 0) { return response::redirect("/admin/type/" . $t["slug"]); }
        $lang = $rows[0]["lang"];
        $vals = json::decode($rows[0]["fields_json"]); if ($vals == null) { $vals = array::new_assoc(); }
        // title/body live as revision columns (not always in fields_json) — carry them over.
        $vals = array::set($vals, "title", $rows[0]["title"] . " (kopya)");
        $bmd = $rows[0]["body_md"]; if ($bmd == null) { $bmd = ""; }
        $vals = array::set($vals, "body", $bmd);
        $base = $rows[0]["slug"] . "-kopya";
        $newslug = $base;
        if (slug_taken($c, $t["slug"], $newslug, 0, $lang)) {
            foreach ([2, 3, 4, 5, 6, 7, 8, 9, 10] as $i) {
                $try = $base . "-" . $i;
                if (!slug_taken($c, $t["slug"], $try, 0, $lang)) { $newslug = $try; break; }
            }
        }
        $newid = save_content($c, $t["slug"], 0, $newslug, $vals, "draft", $lang);
        return response::redirect("/admin/type/" . $t["slug"] . "/edit/" . $newid);
    }
    if ($action == "rollback") {
        $rev = request::post("rev");
        $chk = db::query($c, "SELECT id FROM revisions WHERE id = ? AND content_id = ?", [$rev, $id]);
        if (count($chk) == 1) {
            $cont = db::query($c, "SELECT status FROM content WHERE id = ?", [$id]);
            $pub = 0;
            if (count($cont) == 1) { if ($cont[0]["status"] == "published") { $pub = $rev; } }
            db::exec($c, "UPDATE content SET current_rev = ?, published_rev = ?, updated_at = ? WHERE id = ?", [$rev, $pub, date::timestamp(), $id]);
        }
        return response::redirect("/admin/type/" . $type . "/history/" . $id);
    }
    return response::status(404, "Bilinmeyen işlem.");
});

// ── revision history + rollback (versioned core: rollback = a pointer move) ───
route("GET", "/admin/type/{type}/history/{id}", function() {
    if (!is_admin()) { return response::redirect("/admin/login"); }
    if (!can("content")) { return response::status(403, "Yetkiniz yok."); }
    $c = conn();
    $id = request::param("id");
    $type = request::param("type");
    $cont = db::query($c, "SELECT current_rev, slug FROM content WHERE id = ?", [$id]);
    if (count($cont) == 0) { return response::status(404, view("notfound.html", [])); }
    $cur = type::to_int($cont[0]["current_rev"]);
    $revs = db::query($c, "SELECT id, rev_no, title, note FROM revisions WHERE content_id = ? ORDER BY rev_no DESC", [$id]);
    $rows = "";
    foreach ($revs as $r) {
        $badge = ""; $btn = "<form method=\"post\" action=\"/admin/type/" . $type . "/rollback/" . $id . "\" class=\"inline\"><input type=\"hidden\" name=\"rev\" value=\"" . $r["id"] . "\"><button>Bu sürüme dön</button></form>";
        if (type::to_int($r["id"]) == $cur) { $badge = " <span class=\"badge\">güncel</span>"; $btn = ""; }
        $rows = $rows . "<tr><td>#" . $r["rev_no"] . $badge . "</td><td>" . html::escape($r["title"]) . "</td><td>" . html::escape($r["note"]) . "</td><td>" . $btn . "</td></tr>";
    }
    return response::html(admin_view("admin_history.html", ["type" => $type, "id" => $id, "slug" => $cont[0]["slug"], "rows" => $rows, "count" => count($revs)]));
});

// ── JSON API — published_rev ONLY (read-surface invariant) ────────────────────
// Read API — published only, no auth. Pagination + title search + category filter +
// single-item (?slug=). {data, meta}. NOTE: kept at 2 segments on purpose — a 3-seg
// /api/v1/{type} route shadows the dynamic /{a}/{b}/{c} dispatch in LOOK's router.
route("GET", "/api/{type}", function() {
    $c = conn();
    $t = load_type($c, request::param("type"));
    if ($t == null) { return response::status(404, "{\"error\":\"no such type\"}"); }
    $per = type::to_int(request::get("limit") ?? "20"); if ($per < 1) { $per = 20; } if ($per > 100) { $per = 100; }
    $page = type::to_int(request::get("page") ?? "1"); if ($page < 1) { $page = 1; }
    $q = string::trim(request::get("q") ?? "");
    $cat = request::get("category"); if ($cat == null) { $cat = ""; }
    $slugq = request::get("slug"); if ($slugq == null) { $slugq = ""; }
    $where = "c.type = ? AND c.published_rev > 0"; $params = [$t["slug"]];
    if ($slugq != "") { $where = $where . " AND c.slug = ?"; $params = array::push($params, $slugq); }
    if ($q != "") { $where = $where . " AND r.title LIKE ?"; $params = array::push($params, "%" . $q . "%"); }
    if ($cat != "") { $where = $where . " AND r.fields_json LIKE ?"; $params = array::push($params, "%\"category\":\"" . $cat . "\"%"); }
    $total = type::to_int(db::query($c, "SELECT COUNT(*) AS n FROM content c JOIN revisions r ON r.id = c.published_rev WHERE " . $where, $params)[0]["n"]);
    $pages = ($total + $per - 1) / $per; $pages = type::to_int($pages); if ($pages < 1) { $pages = 1; }
    $offset = ($page - 1) * $per;
    $qp = $params; $qp = array::push($qp, $per); $qp = array::push($qp, $offset);
    $rows = db::query($c, "SELECT c.slug, r.title, r.fields_json FROM content c JOIN revisions r ON r.id = c.published_rev WHERE " . $where . " ORDER BY c.updated_at DESC, c.id DESC LIMIT ? OFFSET ?", $qp);
    $out = [];
    foreach ($rows as $row) {
        $item = json::decode($row["fields_json"]); if ($item == null) { $item = array::new_assoc(); }
        $item = array::set($item, "slug", $row["slug"]);
        $item = array::set($item, "title", $row["title"]);
        $out = array::push($out, $item);
    }
    response::text(json::encode(["data" => $out, "meta" => ["page" => $page, "limit" => $per, "total" => $total, "pages" => $pages]]));
    response::header("Content-Type", "application/json");
    return;
});

// ── preview — admin-session gated (draft reachable ONLY here) ─────────────────
route("GET", "/preview/{id}", function() {
    if (!is_admin()) { return response::status(403, "admin only"); }
    $c = conn();
    $rows = db::query($c, "SELECT r.title, r.body_html FROM content c JOIN revisions r ON r.id = c.current_rev WHERE c.id = ?", [request::param("id")]);
    if (count($rows) == 0) { return response::status(404, view("notfound.html", [])); }
    return response::html(view("page.html", ["title" => $rows[0]["title"], "content" => $rows[0]["body_html"], "fields" => [], "has_fields" => false, "extra" => ""]));
});

// ── media library (admin: list / upload / delete) ────────────────────────────
route("GET", "/admin/media", function() {
    if (!is_admin()) { return response::redirect("/admin/login"); }
    if (!can("media")) { return response::status(403, "Yetkiniz yok."); }
    $c = conn();
    $items = db::query($c, "SELECT id, sha_name, original, mime, size FROM media ORDER BY created_at DESC, id DESC", []);
    return response::html(admin_view("admin_media.html", ["items" => $items, "error" => ""]));
});
route("POST", "/admin/media", function() {
    if (!is_admin()) { return response::redirect("/admin/login"); }
    if (!can("media")) { return response::status(403, "Yetkiniz yok."); }
    $f = null;
    try { $f = request::file("file", ["max_size" => 5242880, "allow_mime" => cfg_media_mimes()]); } catch ($e) { $f = null; }
    if ($f == null) {
        $c = conn();
        $items = db::query($c, "SELECT id, sha_name, original, mime, size FROM media ORDER BY created_at DESC, id DESC", []);
        return response::html(admin_view("admin_media.html", ["items" => $items, "error" => "No file, or type not allowed (png / jpeg / gif / webp, max 5 MB)."]));
    }
    $s = file::store($f, "media");
    $c = conn();
    $exists = db::query($c, "SELECT id FROM media WHERE sha_name = ?", [$s["name"]]);
    if (count($exists) == 0) {
        db::exec($c, "INSERT INTO media (sha_name, original, mime, size, created_at) VALUES (?, ?, ?, ?, ?)", [$s["name"], $f["filename"], $s["mime"], $f["size"], date::timestamp()]);
    }
    return response::redirect("/admin/media");
});
route("POST", "/admin/media/delete/{id}", function() {
    if (!is_admin()) { return response::redirect("/admin/login"); }
    if (!can("media")) { return response::status(403, "Yetkiniz yok."); }
    $c = conn();
    $rows = db::query($c, "SELECT sha_name FROM media WHERE id = ?", [request::param("id")]);
    if (count($rows) > 0) {
        $path = file::upload_dir() . "/media/" . $rows[0]["sha_name"];
        if (file::exists($path)) { file::remove($path); }
        db::exec($c, "DELETE FROM media WHERE id = ?", [request::param("id")]);
    }
    return response::redirect("/admin/media");
});
// JSON list of media — feeds the in-editor media picker (image fields).
route("GET", "/admin/media/list", function() {
    if (!is_admin() || !can("media")) { return response::status(403, "{\"error\":\"forbidden\"}"); }
    $c = conn();
    $rows = db::query($c, "SELECT sha_name, original, mime FROM media ORDER BY created_at DESC, id DESC LIMIT 200", []);
    $out = [];
    foreach ($rows as $r) {
        $out = array::push($out, ["url" => "/media/" . $r["sha_name"], "name" => $r["sha_name"], "original" => $r["original"], "mime" => $r["mime"]]);
    }
    response::text(json::encode($out));
    response::header("Content-Type", "application/json");
    return;
});
// AJAX upload — the picker uploads a new image and gets its URL back (no page reload).
route("POST", "/admin/media/upload", function() {
    if (!is_admin() || !can("media")) { return response::status(403, "{\"ok\":false,\"error\":\"forbidden\"}"); }
    $f = null;
    try { $f = request::file("file", ["max_size" => 5242880, "allow_mime" => cfg_media_mimes()]); } catch ($e) { $f = null; }
    if ($f == null) {
        response::text("{\"ok\":false,\"error\":\"No file, or type not allowed (png/jpeg/gif/webp, max 5 MB).\"}");
        response::header("Content-Type", "application/json");
        return;
    }
    $s = file::store($f, "media");
    $c = conn();
    $exists = db::query($c, "SELECT id FROM media WHERE sha_name = ?", [$s["name"]]);
    if (count($exists) == 0) {
        db::exec($c, "INSERT INTO media (sha_name, original, mime, size, created_at) VALUES (?, ?, ?, ?, ?)", [$s["name"], $f["filename"], $s["mime"], $f["size"], date::timestamp()]);
    }
    response::text(json::encode(["ok" => true, "url" => "/media/" . $s["name"], "name" => $s["name"]]));
    response::header("Content-Type", "application/json");
    return;
});

// ── admin: form builder (definitions) + submissions ───────────────────────────
route("GET", "/admin/forms", function() {
    if (!is_admin()) { return response::redirect("/admin/login"); }
    if (!can("forms")) { return response::status(403, "Yetkiniz yok."); }
    $c = conn();
    $items = [];
    foreach (form_all($c) as $f) {
        $fd = json::decode($f["fields_json"]); $nf = 0; if ($fd != null) { $nf = count($fd); }
        $items = array::push($items, ["fkey" => $f["fkey"], "title" => $f["title"], "nfields" => $nf, "nsubs" => form_submission_count($c, $f["fkey"])]);
    }
    // submission keys with no form definition (e.g. the styled /contact page)
    $keys = db::query($c, "SELECT form_key, COUNT(*) AS n FROM form_submissions GROUP BY form_key", []);
    $other = [];
    foreach ($keys as $k) {
        if (form_get($c, $k["form_key"]) == null) { $other = array::push($other, ["fkey" => $k["form_key"], "nsubs" => type::to_int($k["n"])]); }
    }
    return response::html(admin_view("admin_forms.html", ["items" => $items, "count" => count($items), "other" => $other, "has_other" => (count($other) > 0)]));
});
route("POST", "/admin/forms/new", function() {
    if (!is_admin()) { return response::redirect("/admin/login"); }
    if (!can("forms")) { return response::status(403, "Yetkiniz yok."); }
    $c = conn();
    $title = string::trim(request::post("title"));
    $key = string::trim(request::post("fkey"));
    $fj = request::post("fields");
    if (!string::regex_match($key, "^[a-z][a-z0-9_-]*$")) { return response::status(400, "Geçersiz anahtar: küçük harf/rakam/-/_, harfle başlar."); }
    if (json::decode($fj) == null) { return response::status(400, "fields geçerli JSON olmalı."); }
    if ($title == "") { $title = $key; }
    if (count(db::query($c, "SELECT id FROM forms WHERE fkey = ?", [$key])) == 0) {
        db::exec($c, "INSERT INTO forms (fkey, title, fields_json, created_at) VALUES (?, ?, ?, ?)", [$key, $title, $fj, date::timestamp()]);
    }
    return response::redirect("/admin/forms");
});
route("GET", "/admin/form/{key}", function() {
    if (!is_admin()) { return response::redirect("/admin/login"); }
    if (!can("forms")) { return response::status(403, "Yetkiniz yok."); }
    $c = conn();
    $key = request::param("key");
    $def = form_get($c, $key);
    $cols = [];
    if ($def != null) { foreach ($def["fields"] as $f) { $cols = array::push($cols, $f["name"]); } }
    $subs = db::query($c, "SELECT data_json FROM form_submissions WHERE form_key = ? ORDER BY id DESC LIMIT 500", [$key]);
    if ($def == null && count($subs) > 0) {
        $d0 = json::decode($subs[0]["data_json"]);
        if ($d0 != null) { foreach (array::keys($d0) as $k) { $cols = array::push($cols, $k); } }
    }
    $rows = [];
    foreach ($subs as $s) {
        $d = json::decode($s["data_json"]); $vals = [];
        foreach ($cols as $col) {
            $v = ""; if ($d != null) { try { $v = $d[$col]; } catch ($e) { $v = ""; } } if ($v == null) { $v = ""; }
            $vals = array::push($vals, $v);
        }
        $rows = array::push($rows, ["vals" => $vals]);
    }
    $title = $key; if ($def != null) { $title = $def["title"]; }
    return response::html(admin_view("admin_form_subs.html", ["title" => $title, "fkey" => $key, "cols" => $cols, "rows" => $rows, "count" => count($subs)]));
});

// Commerce admin (orders, coupons) lives in extensions/commerce — not the core.

// ── admin: users (role 'admin' only — RBAC) ──────────────────────────────────
// A helper so no destructive action can remove the LAST admin (lockout guard).
function admin_count($c) { return type::to_int(db::query($c, "SELECT COUNT(*) AS n FROM users WHERE role = 'admin'", [])[0]["n"]); }

route("GET", "/admin/users", function() {
    if (!is_admin()) { return response::redirect("/admin/login"); }
    if (!can("users")) { return response::status(403, "Yetkiniz yok."); }
    session::start();
    $me = type::to_int(session::get("uid"));
    $c = conn();
    $users = db::query($c, "SELECT id, username, role FROM users ORDER BY id", []);
    $roles = all_roles($c);
    $items = [];
    foreach ($users as $u) {
        $is_me = (type::to_int($u["id"]) == $me);
        $ropts = [];
        foreach ($roles as $r) {
            $ropts = array::push($ropts, ["name" => $r["name"], "label" => $r["label"], "selected" => ($r["name"] == $u["role"])]);
        }
        $items = array::push($items, ["id" => $u["id"], "username" => $u["username"], "is_me" => $is_me, "can_delete" => !$is_me, "roles" => $ropts]);
    }
    // new-user role options as data
    $new_roles = [];
    foreach ($roles as $r) { $new_roles = array::push($new_roles, ["name" => $r["name"], "label" => $r["label"], "selected" => ($r["name"] == "editor")]); }
    return response::html(admin_view("admin_users.html", ["items" => $items, "count" => count($users), "new_roles" => $new_roles]));
});
// User actions — one route per {id}/{action} (role|password|delete) to keep the
// top-level route count low (LOOK VM registers routes in one compilation unit; a
// smaller route budget leaves headroom for extensions). Same auth gate for all.
route("POST", "/admin/users/{id}/{action}", function() {
    if (!is_admin()) { return response::redirect("/admin/login"); }
    if (!can("users")) { return response::status(403, "Yetkiniz yok."); }
    session::start();
    $me = type::to_int(session::get("uid"));
    $c = conn();
    $id = type::to_int(request::param("id"));
    $action = request::param("action");
    if ($action == "role") {
        $role = request::post("role");
        if (count(db::query($c, "SELECT id FROM roles WHERE name = ?", [$role])) == 0) { return response::redirect("/admin/users"); }
        $cur = db::query($c, "SELECT role FROM users WHERE id = ?", [$id]);
        if (count($cur) == 1) {
            if ($cur[0]["role"] == "admin" && $role != "admin" && admin_count($c) <= 1) {
                return response::status(400, "Son admin rolü düşürülemez (kilitlenme koruması).");
            }
            db::exec($c, "UPDATE users SET role = ? WHERE id = ?", [$role, $id]);
        }
        return response::redirect("/admin/users");
    }
    if ($action == "password") {
        $p = request::post("password");
        if ($p != null && $p != "") {
            db::exec($c, "UPDATE users SET password_hash = ? WHERE id = ?", [auth::hash($p), $id]);
        }
        return response::redirect("/admin/users");
    }
    if ($action == "delete") {
        if ($id == $me) { return response::status(400, "Kendinizi silemezsiniz."); }
        $cur = db::query($c, "SELECT role FROM users WHERE id = ?", [$id]);
        if (count($cur) == 1) {
            if ($cur[0]["role"] == "admin" && admin_count($c) <= 1) {
                return response::status(400, "Son admin silinemez (kilitlenme koruması).");
            }
            db::exec($c, "DELETE FROM users WHERE id = ?", [$id]);
        }
        return response::redirect("/admin/users");
    }
    return response::status(404, "Bilinmeyen işlem.");
});
route("POST", "/admin/users/new", function() {
    if (!is_admin()) { return response::redirect("/admin/login"); }
    if (!can("users")) { return response::status(403, "Yetkiniz yok."); }
    $c = conn();
    $u = string::trim(request::post("username"));
    $p = request::post("password");
    $role = request::post("role");
    // role must be a real role; default to editor
    if (count(db::query($c, "SELECT id FROM roles WHERE name = ?", [$role])) == 0) { $role = "editor"; }
    if ($u != "") {
        if ($p != null) {
            if ($p != "") {
                $exists = db::query($c, "SELECT id FROM users WHERE username = ?", [$u]);
                if (count($exists) == 0) {
                    db::exec($c, "INSERT INTO users (username, password_hash, role, created_at) VALUES (?, ?, ?, ?)", [$u, auth::hash($p), $role, date::timestamp()]);
                }
            }
        }
    }
    return response::redirect("/admin/users");
});

// ── admin: roles & permissions (RBAC) ─────────────────────────────────────────
route("GET", "/admin/roles", function() {
    if (!is_admin()) { return response::redirect("/admin/login"); }
    if (!can("roles")) { return response::status(403, "Yetkiniz yok."); }
    $c = conn();
    $perms = all_permissions();
    $roles = all_roles($c);
    $rows = "";
    $items = [];
    foreach ($roles as $r) {
        $rp = json::decode($r["perms"]); if ($rp == null) { $rp = []; }
        $sys = (type::to_int($r["is_system"]) == 1);
        $is_admin_role = ($r["name"] == "admin");
        $plist = [];
        foreach ($perms as $p) {
            $checked = false;
            if ($is_admin_role) { $checked = true; } else { $checked = array::contains($rp, $p["key"]); }
            $plist = array::push($plist, ["key" => $p["key"], "label" => $p["label"], "checked" => $checked]);
        }
        $items = array::push($items, ["id" => $r["id"], "name" => $r["name"], "label" => $r["label"],
            "is_system" => $sys, "is_admin" => $is_admin_role, "editable" => !$is_admin_role, "can_delete" => !$sys, "perms" => $plist]);
    }
    return response::html(admin_view("admin_roles.html", ["items" => $items, "count" => count($roles), "new_perms" => $perms]));
});
route("POST", "/admin/roles/new", function() {
    if (!is_admin()) { return response::redirect("/admin/login"); }
    if (!can("roles")) { return response::status(403, "Yetkiniz yok."); }
    $c = conn();
    $name = string::trim(request::post("name"));
    $label = string::trim(request::post("label"));
    if (!string::regex_match($name, "^[a-z][a-z0-9_]*$")) { return response::status(400, "Geçersiz rol adı: küçük harf/rakam/alt-çizgi, harfle başlar."); }
    if ($label == "") { $label = $name; }
    if (count(db::query($c, "SELECT id FROM roles WHERE name = ?", [$name])) == 0) {
        db::exec($c, "INSERT INTO roles (name, label, perms, is_system) VALUES (?, ?, ?, 0)", [$name, $label, json::encode(collect_perms())]);
    }
    return response::redirect("/admin/roles");
});
// Role actions — one route per {id}/{action} (save|delete); see users note above.
route("POST", "/admin/roles/{id}/{action}", function() {
    if (!is_admin()) { return response::redirect("/admin/login"); }
    if (!can("roles")) { return response::status(403, "Yetkiniz yok."); }
    $c = conn();
    $id = type::to_int(request::param("id"));
    $action = request::param("action");
    if ($action == "save") {
        $r = db::query($c, "SELECT name FROM roles WHERE id = ?", [$id]);
        if (count($r) == 1 && $r[0]["name"] != "admin") {
            db::exec($c, "UPDATE roles SET perms = ? WHERE id = ?", [json::encode(collect_perms()), $id]);
        }
        return response::redirect("/admin/roles");
    }
    if ($action == "delete") {
        $r = db::query($c, "SELECT name, is_system FROM roles WHERE id = ?", [$id]);
        if (count($r) == 1) {
            if (type::to_int($r[0]["is_system"]) == 1) { return response::status(400, "Sistem rolü silinemez."); }
            $inuse = type::to_int(db::query($c, "SELECT COUNT(*) AS n FROM users WHERE role = ?", [$r[0]["name"]])[0]["n"]);
            if ($inuse > 0) { return response::status(400, "Bu rol " . $inuse . " kullanıcıda kullanımda — önce onları başka role taşıyın."); }
            db::exec($c, "DELETE FROM roles WHERE id = ?", [$id]);
        }
        return response::redirect("/admin/roles");
    }
    return response::status(404, "Bilinmeyen işlem.");
});

// ── admin: themes (install list / preview / activate) ─────────────────────────
route("GET", "/admin/themes", function() {
    if (!is_admin()) { return response::redirect("/admin/login"); }
    if (!can("settings")) { return response::status(403, "Yetkiniz yok."); }
    $c = conn();
    return response::html(admin_view("admin_themes.html", ["themes" => themes_list($c)]));
});
route("POST", "/admin/themes/activate", function() {
