# Copy to .env and set your own values. .env is gitignored (never commit secrets).
# Admin password for /admin. If unset, admin login is DISABLED (no backdoor).
# REQUIRED. Choose your own password; docker compose will not start without it.
ADMIN_PASSWORD=
# REQUIRED. Signs the CSRF cookie (at least 32 characters; the same value on every server).
# Generate one:  openssl rand -hex 32
LOOK_SECRET=
# Optional, while changing LOOK_SECRET: the old value, still accepted for checking (open forms keep working).
# LOOK_SECRET_PREVIOUS=
