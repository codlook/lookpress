// app.lk — LookPress entry point. This file is deliberately thin: it wires the
// application together and owns nothing but composition. Everything lives in a
// module with one responsibility:
//
//   config/config.lk installed themes/skins, order statuses, upload types, branding
//   src/hooks.lk     action/filter registry — the seam extensions plug into
//   src/core.lk      framework: DB, cached settings, view rendering, SEO, auth gates
//   src/types.lk     the type engine: field inputs, validation, versioned-core write
//   src/render.lk    public presentation: pages, listings, home/blog, URL resolvers
//   extensions/*     self-contained features (commerce: cart/checkout/orders/coupons)
//                    that register routes + hooks and touch NO core file
//   routes/public.lk    public site routes (home, blog, media, search, feeds, forms)
//   routes/admin.lk     /admin/* + JSON API + preview (auth-gated)
//   routes/dispatch.lk  dynamic per-type catch-alls — MUST load LAST (first-match)
//
// Routing is first-match by registration order (contract), and `use "file"` runs a
// module's route() calls inline at the use point. So the ONLY ordering rule is:
// dispatch.lk is used last, after every specific route. Module load order is
// otherwise irrelevant — functions hoist to global before any request is served.

use db;
use cache;
use template;
use session;
use string;
use type;
use array;
use crypto;
use date;
use file;
use json;
use html;
use log;
use auth;

// Fail-loud on an unset admin password (philosophy: nothing hidden). Login is
// disabled until ADMIN_PASSWORD is set — no silent "changeme" backdoor ships.
if (env("ADMIN_PASSWORD", "") == "") {
    log::warn("ADMIN_PASSWORD is not set — /admin login is DISABLED. Set ADMIN_PASSWORD to enable it.");
}

// ── configuration (constants the whole app agrees on) ────────────────────────
use "config/config.lk";

// ── core seams + domain modules (functions only; no routes) ──────────────────
use "src/hooks.lk";    // action/filter registry (the extension seam)
use "src/core.lk";
use "src/rbac.lk";     // role-based access control (can())
use "src/types.lk";
use "src/render.lk";
use "src/forms.lk";    // form builder (defined forms + submissions)

// ── extensions (register their own routes + hooks; touch no core file) ────────
use "extensions/commerce/commerce.lk";

// ── core route modules (thin controllers) — specific routes first … ──────────
use "routes/public.lk";
use "routes/admin.lk";
// … and the dynamic catch-all LAST (first-match: every specific route wins).
use "routes/dispatch.lk";
