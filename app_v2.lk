// app_v2.lk — the type engine. One set of generic admin routes serves EVERY content
// type; define a type in content_types and the system generates its form, validation,
// admin CRUD, and JSON API — no type-specific code. Reads the versioned core:
// public surfaces read published_rev only; admin reads current_rev; preview is admin-gated.
use db;
use cache;
use template;
use session;
use string;
use type;
use array;
use crypto;
use date;
use json;
use html;
use "lib/markdown.lk";

function conn() { return db::connect(env("DB_DSN", "sqlite://cms.db")); }
function view($tpl, $data) { return template::render("themes/default/" . $tpl, $data); }
function is_admin() { session::start(); return session::get("admin") == "1"; }

// ── dispatcher type-pattern cache ────────────────────────────────────────────
// The request-time dispatcher resolves url_pattern -> type slug on EVERY public hit.
// content_types changes rarely, so cache the whole (small) pattern->slug map for 60s
// under ONE key (not per-URL — a per-URL miss cache would let random paths fill it).
// BUSTED on any content_types write (types_cache_bust) so a NEW type's URL is live
// immediately — without the bust the new URL would lag up to the 60s TTL, breaking the
// "restart-less URL" guarantee. Correctness first; the cache is the free win on top.
function type_patterns($c) {
    $m = cache::get("cms:type_patterns");
    if ($m != null) { return $m; }
    $m = array::new_assoc();
    $rows = db::query($c, "SELECT slug, url_pattern FROM content_types", []);
    foreach ($rows as $r) { $m = array::set($m, $r["url_pattern"], $r["slug"]); }
    cache::set("cms:type_patterns", $m, 60);
    return $m;
}
function type_for_pattern($c, $pattern) {
    $m = type_patterns($c);
    if (array::contains(array::keys($m), $pattern)) { return $m[$pattern]; }
    return "";
}
function types_cache_bust() { cache::delete("cms:type_patterns"); }

// ── type engine: load a type + its field defs ───────────────────────────────
function load_type($c, $slug) {
    $rows = db::query($c, "SELECT slug, label, url_pattern, fields_json FROM content_types WHERE slug = ?", [$slug]);
    if (count($rows) == 0) { return null; }
    $t = $rows[0];
    $t["fields"] = json::decode($t["fields_json"]);
    return $t;
}

// Render one field's input HTML from its definition (+ current value).
function field_input($c, $f, $value) {
    $name = $f["name"];
    $t = $f["type"];
    $v = html::escape($value);
    if ($t == "markdown" || $t == "textarea") {
        return "<label>" . $name . "<textarea name=\"" . $name . "\" rows=\"10\">" . $v . "</textarea></label>";
    }
    if ($t == "bool") {
        $chk = ""; if ($value == "1" || $value == "true") { $chk = " checked"; }
        return "<label class=\"cb\"><input type=\"checkbox\" name=\"" . $name . "\" value=\"1\"" . $chk . "> " . $name . "</label>";
    }
    if ($t == "int" || $t == "decimal") {
        return "<label>" . $name . "<input type=\"number\" name=\"" . $name . "\" value=\"" . $v . "\"></label>";
    }
    if ($t == "date") {
        return "<label>" . $name . "<input type=\"date\" name=\"" . $name . "\" value=\"" . $v . "\"></label>";
    }
    if ($t == "select") {
        $opts = "";
        foreach ($f["choices"] as $ch) {
            $sel = ""; if ($ch == $value) { $sel = " selected"; }
            $opts = $opts . "<option value=\"" . html::escape($ch) . "\"" . $sel . ">" . html::escape($ch) . "</option>";
        }
        return "<label>" . $name . "<select name=\"" . $name . "\">" . $opts . "</select></label>";
    }
    if ($t == "relation") {
        // single-select of existing content of the target type (multi-select + picker → Faz 6)
        $target = $f["to"];
        $rows = db::query($c, "SELECT c.id, r.title FROM content c JOIN revisions r ON r.id = c.current_rev WHERE c.type = ? ORDER BY r.title", [$target]);
        $opts = "<option value=\"\">—</option>";
        foreach ($rows as $row) {
            $sel = ""; if (type::to_int($value) == type::to_int($row["id"])) { $sel = " selected"; }
            $opts = $opts . "<option value=\"" . $row["id"] . "\"" . $sel . ">" . html::escape($row["title"]) . "</option>";
        }
        return "<label>" . $name . " (" . $target . ")<select name=\"" . $name . "\">" . $opts . "</select></label>";
    }
    // default: text
    return "<label>" . $name . "<input name=\"" . $name . "\" value=\"" . $v . "\"></label>";
}

function fields_form_html($c, $fields, $values) {
    $h = "";
    foreach ($fields as $f) {
        $val = "";
        if ($values != null) { $val = $values[$f["name"]]; }
        $h = $h . field_input($c, $f, $val);
    }
    return $h;
}

// Server-side validation — form HTML is NOT security. Returns [errors[], values{}].
function validate_post($c, $fields) {
    $errors = [];
    $values = [];
    foreach ($fields as $f) {
        $name = $f["name"];
        $t = $f["type"];
        $raw = request::post($name);
        if ($t == "bool") {
            $bv = "0"; if ($raw == "1") { $bv = "1"; }
            $values = array::set($values, $name, $bv);
        } else {
            if ($raw == null) { $raw = ""; }
            $raw = string::trim($raw);
            $req = $f["required"];
            if ($req && $raw == "") { $errors = array::push($errors, $name . " is required"); }
            if ($t == "int" && $raw != "" && !string::regex_match($raw, "^-?[0-9]+$")) { $errors = array::push($errors, $name . " must be an integer"); }
            if ($t == "decimal" && $raw != "" && !string::regex_match($raw, "^-?[0-9]+(\\.[0-9]+)?$")) { $errors = array::push($errors, $name . " must be a number"); }
            if ($t == "select" && $raw != "") {
                $ok = false; foreach ($f["choices"] as $ch) { if ($ch == $raw) { $ok = true; } }
                if (!$ok) { $errors = array::push($errors, $name . " is not an allowed choice"); }
            }
            if ($t == "relation" && $raw != "") {
                $ex = db::query($c, "SELECT id FROM content WHERE id = ? AND type = ?", [type::to_int($raw), $f["to"]]);
                if (count($ex) == 0) { $errors = array::push($errors, $name . ": invalid relation target " . $raw); }
            }
            $values = array::set($values, $name, $raw);
        }
    }
    return ["errors" => $errors, "values" => $values];
}

// ── versioned-core write: create/update content as a new revision ────────────
function save_content($c, $type, $id, $slug, $values, $status) {
    $title = $values["title"];
    $body_md = $values["body"];
    $body_html = markdown_to_html($body_md);
    $fields_json = json::encode($values);
    $ts = date::timestamp();
    if ($id == 0) {
        db::exec($c, "INSERT INTO content (type, slug, lang, status, created_at, updated_at) VALUES (?, ?, 'tr', ?, ?, ?)", [$type, $slug, $status, $ts, $ts]);
        $id = db::last_id($c);
    } else {
        db::exec($c, "UPDATE content SET slug = ?, status = ?, updated_at = ? WHERE id = ?", [$slug, $status, $ts, $id]);
    }
    // rev_no = max+1
    $mx = db::query($c, "SELECT COALESCE(MAX(rev_no),0) AS m FROM revisions WHERE content_id = ?", [$id]);
    $rev_no = type::to_int($mx[0]["m"]) + 1;
    db::exec($c, "INSERT INTO revisions (content_id, rev_no, title, body_md, body_html, fields_json, author_id, created_at, note) VALUES (?, ?, ?, ?, ?, ?, 0, ?, 'admin edit')", [$id, $rev_no, $title, $body_md, $body_html, $fields_json, $ts]);
    $rid = db::last_id($c);
    $prev = 0;
    if ($status == "published") { $prev = $rid; }
    db::exec($c, "UPDATE content SET current_rev = ?, published_rev = ? WHERE id = ?", [$rid, $prev, $id]);
    return $id;
}

// ── admin auth ───────────────────────────────────────────────────────────────
route("GET", "/admin/login", function() { return response::html(view("login.html", ["error" => ""])); });
route("POST", "/admin/login", function() {
    if (crypto::constant_compare(request::post("password"), env("ADMIN_PASSWORD", "changeme"))) {
        session::start(); session::regenerate(); session::set("admin", "1");
        return response::redirect("/admin");
    }
    return response::html(view("login.html", ["error" => "Wrong password."]));
});
route("GET", "/admin/logout", function() { session::start(); session::destroy(); return response::redirect("/admin/login"); });

// Admin dashboard: list the types (the engine's entry point).
route("GET", "/admin", function() {
    if (!is_admin()) { return response::redirect("/admin/login"); }
    $c = conn();
    $types = db::query($c, "SELECT slug, label FROM content_types ORDER BY label", []);
    return response::html(view("admin_types.html", ["types" => $types]));
});

// ── type-admin: create a content type from the admin (closes Step 3's gate) ──
route("GET", "/admin/types/new", function() {
    if (!is_admin()) { return response::redirect("/admin/login"); }
    return response::html(view("admin_type_def.html", [
        "slug" => "", "label" => "", "url_pattern" => "/{slug}",
        "fields" => "[\n  {\"name\":\"title\",\"type\":\"text\",\"required\":true},\n  {\"name\":\"body\",\"type\":\"markdown\"}\n]",
        "errors" => []
    ]));
});
route("POST", "/admin/types/new", function() {
    if (!is_admin()) { return response::redirect("/admin/login"); }
    $c = conn();
    $slug = string::trim(request::post("slug"));
    $label = string::trim(request::post("label"));
    $url = string::trim(request::post("url_pattern"));
    $fields_raw = request::post("fields");
    $errs = [];
    if (!string::regex_match($slug, "^[a-z][a-z0-9_]*$")) { $errs = array::push($errs, "slug must be lowercase letters/digits/underscore, starting with a letter"); }
    if (!string::regex_match($url, "\\{slug\\}")) { $errs = array::push($errs, "url_pattern must contain {slug}"); }
    $fields = json::decode($fields_raw);
    if ($fields == null) { $errs = array::push($errs, "fields must be valid JSON"); }
    else {
        // every type must define title + body (the render-on-save convention)
        $has_title = false; $has_body = false;
        foreach ($fields as $f) {
            if ($f["name"] == "title") { $has_title = true; }
            if ($f["name"] == "body") { $has_body = true; }
        }
        if (!$has_title || !$has_body) { $errs = array::push($errs, "fields must include a 'title' and a 'body'"); }
    }
    if (count(db::query($c, "SELECT id FROM content_types WHERE slug = ?", [$slug])) > 0) { $errs = array::push($errs, "a type with that slug already exists"); }
    if (count($errs) > 0) {
        return response::html(view("admin_type_def.html", ["slug" => $slug, "label" => $label, "url_pattern" => $url, "fields" => $fields_raw, "errors" => $errs]));
    }
    db::exec($c, "INSERT INTO content_types (slug, label, url_pattern, fields_json) VALUES (?, ?, ?, ?)", [$slug, $label, $url, json::encode($fields)]);
    types_cache_bust();   // new type's URL live immediately (no 60s TTL lag)
    return response::redirect("/admin/type/" . $slug);
});

// ── GENERIC admin CRUD — ONE handler set for EVERY type (the type engine) ────
route("GET", "/admin/type/{type}", function() {
    if (!is_admin()) { return response::redirect("/admin/login"); }
    $c = conn();
    $t = load_type($c, request::param("type"));
    if ($t == null) { return response::status(404, "No such type"); }
    // admin reads current_rev (draft-aware)
    $items = db::query($c, "SELECT c.id, c.slug, c.status, r.title FROM content c JOIN revisions r ON r.id = c.current_rev WHERE c.type = ? ORDER BY c.updated_at DESC", [$t["slug"]]);
    return response::html(view("admin_type_list.html", ["type" => $t, "items" => $items]));
});

route("GET", "/admin/type/{type}/new", function() {
    if (!is_admin()) { return response::redirect("/admin/login"); }
    $c = conn();
    $t = load_type($c, request::param("type"));
    if ($t == null) { return response::status(404, "No such type"); }
    $form = fields_form_html($c, $t["fields"], null);
    return response::html(view("admin_type_form.html", ["type" => $t, "action" => "/admin/type/" . $t["slug"] . "/new", "heading" => "New " . $t["label"], "fields_html" => $form, "slug" => "", "status" => "draft", "errors" => []]));
});

route("POST", "/admin/type/{type}/new", function() {
    if (!is_admin()) { return response::redirect("/admin/login"); }
    $c = conn();
    $t = load_type($c, request::param("type"));
    if ($t == null) { return response::status(404, "No such type"); }
    $v = validate_post($c, $t["fields"]);
    $slug = string::trim(request::post("slug"));
    $errs = $v["errors"];
    if ($slug == "") { $errs = array::push($errs, "slug is required"); }
    if (count($errs) > 0) {
        $form = fields_form_html($c, $t["fields"], $v["values"]);
        return response::html(view("admin_type_form.html", ["type" => $t, "action" => "/admin/type/" . $t["slug"] . "/new", "heading" => "New " . $t["label"], "fields_html" => $form, "slug" => $slug, "status" => request::post("status"), "errors" => $errs]));
    }
    save_content($c, $t["slug"], 0, $slug, $v["values"], request::post("status"));
    return response::redirect("/admin/type/" . $t["slug"]);
});

route("GET", "/admin/type/{type}/edit/{id}", function() {
    if (!is_admin()) { return response::redirect("/admin/login"); }
    $c = conn();
    $t = load_type($c, request::param("type"));
    if ($t == null) { return response::status(404, "No such type"); }
    $rows = db::query($c, "SELECT c.slug, c.status, r.fields_json FROM content c JOIN revisions r ON r.id = c.current_rev WHERE c.id = ?", [request::param("id")]);
    if (count($rows) == 0) { return response::status(404, "No such item"); }
    $vals = json::decode($rows[0]["fields_json"]);
    $form = fields_form_html($c, $t["fields"], $vals);
    return response::html(view("admin_type_form.html", ["type" => $t, "action" => "/admin/type/" . $t["slug"] . "/edit/" . request::param("id"), "heading" => "Edit " . $t["label"], "fields_html" => $form, "slug" => $rows[0]["slug"], "status" => $rows[0]["status"], "errors" => []]));
});

route("POST", "/admin/type/{type}/edit/{id}", function() {
    if (!is_admin()) { return response::redirect("/admin/login"); }
    $c = conn();
    $t = load_type($c, request::param("type"));
    if ($t == null) { return response::status(404, "No such type"); }
    $v = validate_post($c, $t["fields"]);
    $slug = string::trim(request::post("slug"));
    if (count($v["errors"]) > 0) {
        $form = fields_form_html($c, $t["fields"], $v["values"]);
        return response::html(view("admin_type_form.html", ["type" => $t, "action" => "/admin/type/" . $t["slug"] . "/edit/" . request::param("id"), "heading" => "Edit " . $t["label"], "fields_html" => $form, "slug" => $slug, "status" => request::post("status"), "errors" => $v["errors"]]));
    }
    save_content($c, $t["slug"], type::to_int(request::param("id")), $slug, $v["values"], request::post("status"));
    return response::redirect("/admin/type/" . $t["slug"]);
});

route("POST", "/admin/type/{type}/delete/{id}", function() {
    if (!is_admin()) { return response::redirect("/admin/login"); }
    $c = conn();
    db::exec($c, "DELETE FROM revisions WHERE content_id = ?", [request::param("id")]);
    db::exec($c, "DELETE FROM content WHERE id = ?", [request::param("id")]);
    return response::redirect("/admin/type/" . request::param("type"));
});

// ── JSON API — published_rev ONLY (read-surface invariant) ────────────────────
route("GET", "/api/{type}", function() {
    $c = conn();
    $t = load_type($c, request::param("type"));
    if ($t == null) { return response::status(404, "{\"error\":\"no such type\"}"); }
    $rows = db::query($c, "SELECT c.slug, r.title, r.fields_json FROM content c JOIN revisions r ON r.id = c.published_rev WHERE c.type = ? AND c.published_rev > 0 ORDER BY c.updated_at DESC", [$t["slug"]]);
    $out = [];
    foreach ($rows as $row) {
        $item = json::decode($row["fields_json"]);
        $item = array::set($item, "slug", $row["slug"]);
        $out = array::push($out, $item);
    }
    response::text(json::encode($out));
    response::header("Content-Type", "application/json");
    return;
});

// ── preview — admin-session gated (draft reachable ONLY here) ─────────────────
route("GET", "/preview/{id}", function() {
    if (!is_admin()) { return response::status(403, "admin only"); }
    $c = conn();
    $rows = db::query($c, "SELECT r.title, r.body_html FROM content c JOIN revisions r ON r.id = c.current_rev WHERE c.id = ?", [request::param("id")]);
    if (count($rows) == 0) { return response::status(404, view("notfound.html", [])); }
    return response::html(view("page.html", ["title" => $rows[0]["title"], "content" => $rows[0]["body_html"]]));
});

// ── public: published_rev ONLY. Serve content of a type by slug. ─────────────
function render_published($type, $slug) {
    $c = conn();
    $rows = db::query($c, "SELECT r.title, r.body_html FROM content c JOIN revisions r ON r.id = c.published_rev WHERE c.type = ? AND c.slug = ? AND c.published_rev > 0", [$type, $slug]);
    if (count($rows) == 0) { return response::status(404, view("notfound.html", [])); }
    return response::html(view("page.html", ["title" => $rows[0]["title"], "content" => $rows[0]["body_html"]]));
}
// DYNAMIC per-type routing: one route per type's url_pattern, straight from
// content_types — a NEW type auto-routes with no code change. Uses AUTO-capture (no
// use()) on purpose: a VM bug wraps a `use()`-captured loop-local in a single-element
// array at request time (see FRICTION_phase1.md #3, core candidate); auto-capture is
// clean. Sorted by url_pattern length DESC so the bare "/{slug}" catch-all is LAST.
// ── DYNAMIC per-type routing via a request-time dispatcher ────────────────────
// A new type auto-routes with NO restart: url_patterns are resolved from the DB at
// REQUEST time (where db:: works — the setup pass does not, see FRICTION #3a), and
// the closures take no use()-captured loop-local (avoiding the VM wrap, #3b).
// These two generic patterns MUST be the LAST routes registered — every specific
// route (/admin, /api, /media, /preview, ...) is registered above and wins by
// first-match. (Route-shadow contract, from the reference app's Slice 1.)
//
//   1-segment  /{a}      → the type whose url_pattern is "/{slug}" (e.g. page), slug=a
//   2-segment  /{a}/{b}  → the type whose url_pattern is "/{a}/{slug}"  (e.g. post,
//                          product: /blog/{slug}, /products/{slug}), slug=b
route("GET", "/{a}", function() {
    $c = conn();
    $slug = type_for_pattern($c, "/{slug}");           // cached (60s, busted on type write)
    if ($slug == "") { return response::status(404, view("notfound.html", [])); }
    return render_published($slug, request::param("a"));
});
route("GET", "/{a}/{b}", function() {
    $c = conn();
    $slug = type_for_pattern($c, "/" . request::param("a") . "/{slug}");
    if ($slug == "") { return response::status(404, view("notfound.html", [])); }
    return render_published($slug, request::param("b"));
});
