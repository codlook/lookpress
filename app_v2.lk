// app_v2.lk — the type engine. One set of generic admin routes serves EVERY content
// type; define a type in content_types and the system generates its form, validation,
// admin CRUD, and JSON API — no type-specific code. Reads the versioned core:
// public surfaces read published_rev only; admin reads current_rev; preview is admin-gated.
use db;
use cache;
use template;
use session;
use string;
use type;
use array;
use crypto;
use date;
use file;
use json;
use html;
use log;
use auth;
use "lib/markdown.lk";

// Fail-loud on an unset admin password (philosophy: nothing hidden). Login is
// disabled until ADMIN_PASSWORD is set — no silent "changeme" backdoor ships.
if (env("ADMIN_PASSWORD", "") == "") {
    log::warn("ADMIN_PASSWORD is not set — /admin login is DISABLED. Set ADMIN_PASSWORD to enable it.");
}

function conn() { return db::connect(env("DB_DSN", "sqlite://cms.db")); }

// ── settings (namespaced key-value, cached) ──────────────────────────────────
// Namespaced + lazy-cached so it never becomes the wp_options bloat: the whole
// 'core' namespace is one cached map, read once per 60s, busted on write.
function settings_all($c) {
    $m = cache::get("core:settings");
    if ($m != null) { return $m; }
    $m = array::new_assoc();
    $rows = db::query($c, "SELECT skey, sval FROM settings WHERE ns = 'core'", []);
    foreach ($rows as $r) { $m = array::set($m, $r["skey"], $r["sval"]); }
    cache::set("core:settings", $m, 60);
    return $m;
}
function setting_get($c, $key, $default) {
    $m = settings_all($c);
    if (array::contains(array::keys($m), $key)) { return $m[$key]; }
    return $default;
}
function setting_set($c, $key, $val) {
    $ex = db::query($c, "SELECT id FROM settings WHERE ns = 'core' AND skey = ?", [$key]);
    if (count($ex) > 0) { db::exec($c, "UPDATE settings SET sval = ? WHERE ns = 'core' AND skey = ?", [$val, $key]); }
    else { db::exec($c, "INSERT INTO settings (ns, skey, sval) VALUES ('core', ?, ?)", [$key, $val]); }
}
function settings_bust() { cache::delete("core:settings"); }
function site_title() { return setting_get(conn(), "site_title", "LookPress"); }
// A THEME is a template directory (themes/{theme}/) that may override any public
// template; missing ones fall back to themes/default. A SKIN is a colour palette
// (data-theme) applied by the default layout. They are independent settings.
function active_theme() { return setting_get(conn(), "theme", "default"); }
function active_skin() { return setting_get(conn(), "skin", "default"); }
function theme_tpl($theme, $tpl) {
    $p = "themes/" . $theme . "/" . $tpl;
    if (file::exists($p)) { return $p; }
    return "themes/default/" . $tpl;
}
// Inject site title + skin into every PUBLIC view; default head_extra (SEO); render
// from the active theme with a per-template fallback to default.
function view($tpl, $data) {
    $data["site_title"] = site_title();
    $data["skin"] = active_skin();
    if (!array::contains(array::keys($data), "head_extra")) { $data["head_extra"] = ""; }
    return template::render(theme_tpl(active_theme(), $tpl), $data);
}
// Admin has its OWN UI, independent of the active site theme (admin/layout) — a
// theme ships only public views, so the theme ecosystem stays light.
function admin_view($tpl, $data) { return template::render("admin/" . $tpl, $data); }

// ── SEO: per-page meta + Open Graph + JSON-LD (Product schema for priced items) ─
// The site renders dynamically, so a product's JSON-LD price is always fresh (the
// static-build "SEO-visible dynamic" staleness only bites once ③ ships).
function seo_head($title, $desc, $ogtype, $jsonld) {
    $out = "<meta name=\"description\" content=\"" . html::escape($desc) . "\">";
    $out = $out . "<meta property=\"og:title\" content=\"" . html::escape($title) . "\">";
    $out = $out . "<meta property=\"og:description\" content=\"" . html::escape($desc) . "\">";
    $out = $out . "<meta property=\"og:type\" content=\"" . html::escape($ogtype) . "\">";
    if ($jsonld != "") { $out = $out . "<script type=\"application/ld+json\">" . $jsonld . "</script>"; }
    return $out;
}
// Auth: real users (PBKDF2 via auth::), session-backed. is_admin() = any logged-in
// user may reach the admin; is_super() (role 'admin') gates user management.
function is_admin() { session::start(); return session::get("uid") != null; }
function is_super() { session::start(); return session::get("role") == "admin"; }

// ── dispatcher type-pattern cache ────────────────────────────────────────────
// The request-time dispatcher resolves url_pattern -> type slug on EVERY public hit.
// content_types changes rarely, so cache the whole (small) pattern->slug map for 60s
// under ONE key (not per-URL — a per-URL miss cache would let random paths fill it).
// BUSTED on any content_types write (types_cache_bust) so a NEW type's URL is live
// immediately — without the bust the new URL would lag up to the 60s TTL, breaking the
// "restart-less URL" guarantee. Correctness first; the cache is the free win on top.
function type_patterns($c) {
    $m = cache::get("cms:type_patterns");
    if ($m != null) { return $m; }
    $m = array::new_assoc();
    $rows = db::query($c, "SELECT slug, url_pattern FROM content_types", []);
    foreach ($rows as $r) { $m = array::set($m, $r["url_pattern"], $r["slug"]); }
    cache::set("cms:type_patterns", $m, 60);
    return $m;
}
function type_for_pattern($c, $pattern) {
    $m = type_patterns($c);
    if (array::contains(array::keys($m), $pattern)) { return $m[$pattern]; }
    return "";
}
function types_cache_bust() { cache::delete("cms:type_patterns"); }
// Any type whose url_pattern is "/BASE/{slug}" is browsable as a listing at /BASE
// (e.g. product -> /product, post -> /blog). Generic: no per-type listing code.
function type_for_base($c, $base) { return type_for_pattern($c, $base . "/{slug}"); }

// ── type engine: load a type + its field defs ───────────────────────────────
function load_type($c, $slug) {
    $rows = db::query($c, "SELECT slug, label, url_pattern, fields_json FROM content_types WHERE slug = ?", [$slug]);
    if (count($rows) == 0) { return null; }
    $t = $rows[0];
    $t["fields"] = json::decode($t["fields_json"]);
    return $t;
}

// Render one field's input HTML from its definition (+ current value).
function field_input($c, $f, $value) {
    $name = $f["name"];
    $t = $f["type"];
    $v = html::escape($value);
    if ($t == "markdown" || $t == "textarea") {
        return "<label>" . $name . "<textarea name=\"" . $name . "\" rows=\"10\">" . $v . "</textarea></label>";
    }
    if ($t == "bool") {
        $chk = ""; if ($value == "1" || $value == "true") { $chk = " checked"; }
        return "<label class=\"cb\"><input type=\"checkbox\" name=\"" . $name . "\" value=\"1\"" . $chk . "> " . $name . "</label>";
    }
    if ($t == "int" || $t == "decimal") {
        return "<label>" . $name . "<input type=\"number\" name=\"" . $name . "\" value=\"" . $v . "\"></label>";
    }
    if ($t == "date") {
        return "<label>" . $name . "<input type=\"date\" name=\"" . $name . "\" value=\"" . $v . "\"></label>";
    }
    if ($t == "select") {
        $opts = "";
        foreach ($f["choices"] as $ch) {
            $sel = ""; if ($ch == $value) { $sel = " selected"; }
            $opts = $opts . "<option value=\"" . html::escape($ch) . "\"" . $sel . ">" . html::escape($ch) . "</option>";
        }
        return "<label>" . $name . "<select name=\"" . $name . "\">" . $opts . "</select></label>";
    }
    if ($t == "relation") {
        // single-select of existing content of the target type (multi-select + picker → Faz 6)
        $target = $f["to"];
        $rows = db::query($c, "SELECT c.id, r.title FROM content c JOIN revisions r ON r.id = c.current_rev WHERE c.type = ? ORDER BY r.title", [$target]);
        $opts = "<option value=\"\">—</option>";
        foreach ($rows as $row) {
            $sel = ""; if (type::to_int($value) == type::to_int($row["id"])) { $sel = " selected"; }
            $opts = $opts . "<option value=\"" . $row["id"] . "\"" . $sel . ">" . html::escape($row["title"]) . "</option>";
        }
        return "<label>" . $name . " (" . $target . ")<select name=\"" . $name . "\">" . $opts . "</select></label>";
    }
    // default: text
    return "<label>" . $name . "<input name=\"" . $name . "\" value=\"" . $v . "\"></label>";
}

function fields_form_html($c, $fields, $values) {
    $h = "";
    foreach ($fields as $f) {
        $val = "";
        if ($values != null) { $val = $values[$f["name"]]; }
        $h = $h . field_input($c, $f, $val);
    }
    return $h;
}

// Server-side validation — form HTML is NOT security. Returns [errors[], values{}].
function validate_post($c, $fields) {
    $errors = [];
    $values = [];
    foreach ($fields as $f) {
        $name = $f["name"];
        $t = $f["type"];
        $raw = request::post($name);
        if ($t == "bool") {
            $bv = "0"; if ($raw == "1") { $bv = "1"; }
            $values = array::set($values, $name, $bv);
        } else {
            if ($raw == null) { $raw = ""; }
            $raw = string::trim($raw);
            $req = $f["required"];
            if ($req && $raw == "") { $errors = array::push($errors, $name . " is required"); }
            if ($t == "int" && $raw != "" && !string::regex_match($raw, "^-?[0-9]+$")) { $errors = array::push($errors, $name . " must be an integer"); }
            if ($t == "decimal" && $raw != "" && !string::regex_match($raw, "^-?[0-9]+(\\.[0-9]+)?$")) { $errors = array::push($errors, $name . " must be a number"); }
            if ($t == "select" && $raw != "") {
                $ok = false; foreach ($f["choices"] as $ch) { if ($ch == $raw) { $ok = true; } }
                if (!$ok) { $errors = array::push($errors, $name . " is not an allowed choice"); }
            }
            if ($t == "relation" && $raw != "") {
                $ex = db::query($c, "SELECT id FROM content WHERE id = ? AND type = ?", [type::to_int($raw), $f["to"]]);
                if (count($ex) == 0) { $errors = array::push($errors, $name . ": invalid relation target " . $raw); }
            }
            $values = array::set($values, $name, $raw);
        }
    }
    return ["errors" => $errors, "values" => $values];
}

// ── versioned-core write: create/update content as a new revision ────────────
function save_content($c, $type, $id, $slug, $values, $status, $lang) {
    $title = $values["title"];
    $body_md = $values["body"];
    $body_html = markdown_to_html($body_md);
    $fields_json = json::encode($values);
    $ts = date::timestamp();
    if ($id == 0) {
        db::exec($c, "INSERT INTO content (type, slug, lang, status, created_at, updated_at) VALUES (?, ?, ?, ?, ?, ?)", [$type, $slug, $lang, $status, $ts, $ts]);
        $id = db::last_id($c);
    } else {
        db::exec($c, "UPDATE content SET slug = ?, lang = ?, status = ?, updated_at = ? WHERE id = ?", [$slug, $lang, $status, $ts, $id]);
    }
    // rev_no = max+1
    $mx = db::query($c, "SELECT COALESCE(MAX(rev_no),0) AS m FROM revisions WHERE content_id = ?", [$id]);
    $rev_no = type::to_int($mx[0]["m"]) + 1;
    db::exec($c, "INSERT INTO revisions (content_id, rev_no, title, body_md, body_html, fields_json, author_id, created_at, note) VALUES (?, ?, ?, ?, ?, ?, 0, ?, 'admin edit')", [$id, $rev_no, $title, $body_md, $body_html, $fields_json, $ts]);
    $rid = db::last_id($c);
    $prev = 0;
    if ($status == "published") { $prev = $rid; }
    db::exec($c, "UPDATE content SET current_rev = ?, published_rev = ? WHERE id = ?", [$rid, $prev, $id]);
    return $id;
}

// ── admin auth ───────────────────────────────────────────────────────────────
route("GET", "/admin/login", function() { return response::html(admin_view("login.html", ["error" => ""])); });
route("POST", "/admin/login", function() {
    $c = conn();
    $u = request::post("username");
    $p = request::post("password");
    if ($u != null) {
        if ($p != null) {
            if ($u != "" && $p != "") {
                $rows = db::query($c, "SELECT id, password_hash, role FROM users WHERE username = ?", [$u]);
                if (count($rows) == 1) {
                    if (auth::verify($p, $rows[0]["password_hash"])) {
                        session::start(); session::regenerate();
                        session::set("uid", "" . $rows[0]["id"]);
                        session::set("uname", $u);
                        session::set("role", $rows[0]["role"]);
                        return response::redirect("/admin");
                    }
                }
            }
        }
    }
    return response::html(admin_view("login.html", ["error" => "Kullanıcı adı ya da şifre hatalı."]));
});
route("GET", "/admin/logout", function() { session::start(); session::destroy(); return response::redirect("/admin/login"); });

// Admin dashboard: list the types (the engine's entry point).
route("GET", "/admin", function() {
    if (!is_admin()) { return response::redirect("/admin/login"); }
    session::start();
    $c = conn();
    $uname = session::get("uname"); if ($uname == null) { $uname = ""; }
    // stats
    $n_content  = type::to_int(db::query($c, "SELECT COUNT(*) AS n FROM content WHERE published_rev > 0", [])[0]["n"]);
    $n_products = type::to_int(db::query($c, "SELECT COUNT(*) AS n FROM content WHERE type = 'product' AND published_rev > 0", [])[0]["n"]);
    $n_orders   = type::to_int(db::query($c, "SELECT COUNT(*) AS n FROM orders", [])[0]["n"]);
    $revenue    = db::query($c, "SELECT COALESCE(SUM(total), 0) AS r FROM orders", [])[0]["r"];
    $n_subs     = type::to_int(db::query($c, "SELECT COUNT(*) AS n FROM form_submissions", [])[0]["n"]);
    // recent orders
    $recent = db::query($c, "SELECT id, cust_name, total, status FROM orders ORDER BY id DESC LIMIT 5", []);
    $recent_html = "";
    foreach ($recent as $o) {
        $cn = $o["cust_name"]; if ($cn == null) { $cn = ""; } if ($cn == "") { $cn = "—"; }
        $recent_html = $recent_html . "<tr><td><a href=\"/admin/order/" . $o["id"] . "\">#" . $o["id"] . "</a></td><td>" . html::escape($cn) . "</td><td>" . html::escape("" . $o["total"]) . " &#8378;</td><td>" . html::escape($o["status"]) . "</td></tr>";
    }
    if ($recent_html == "") { $recent_html = "<tr><td colspan=\"4\" class=\"muted\">Henüz sipariş yok.</td></tr>"; }
    // content types
    $types = db::query($c, "SELECT slug, label FROM content_types ORDER BY label", []);
    $types_html = "";
    foreach ($types as $t) {
        $types_html = $types_html . "<li><a href=\"/admin/type/" . $t["slug"] . "\">" . html::escape($t["label"]) . "</a> <span class=\"muted\">(" . html::escape($t["slug"]) . ")</span></li>";
    }
    return response::html(admin_view("admin_dashboard.html", [
        "uname" => $uname, "is_super" => is_super(),
        "n_content" => $n_content, "n_products" => $n_products, "n_orders" => $n_orders,
        "revenue" => "" . $revenue, "n_subs" => $n_subs,
        "recent" => $recent_html, "types_html" => $types_html
    ]));
});

// ── type-admin: create a content type from the admin (closes Step 3's gate) ──
route("GET", "/admin/types/new", function() {
    if (!is_admin()) { return response::redirect("/admin/login"); }
    return response::html(admin_view("admin_type_def.html", [
        "slug" => "", "label" => "", "url_pattern" => "/{slug}",
        "fields" => "[\n  {\"name\":\"title\",\"type\":\"text\",\"required\":true},\n  {\"name\":\"body\",\"type\":\"markdown\"}\n]",
        "errors" => []
    ]));
});
route("POST", "/admin/types/new", function() {
    if (!is_admin()) { return response::redirect("/admin/login"); }
    $c = conn();
    $slug = string::trim(request::post("slug"));
    $label = string::trim(request::post("label"));
    $url = string::trim(request::post("url_pattern"));
    $fields_raw = request::post("fields");
    $errs = [];
    if (!string::regex_match($slug, "^[a-z][a-z0-9_]*$")) { $errs = array::push($errs, "slug must be lowercase letters/digits/underscore, starting with a letter"); }
    if (!string::regex_match($url, "\\{slug\\}")) { $errs = array::push($errs, "url_pattern must contain {slug}"); }
    $fields = json::decode($fields_raw);
    if ($fields == null) { $errs = array::push($errs, "fields must be valid JSON"); }
    else {
        // every type must define title + body (the render-on-save convention)
        $has_title = false; $has_body = false;
        foreach ($fields as $f) {
            if ($f["name"] == "title") { $has_title = true; }
            if ($f["name"] == "body") { $has_body = true; }
        }
        if (!$has_title || !$has_body) { $errs = array::push($errs, "fields must include a 'title' and a 'body'"); }
    }
    if (count(db::query($c, "SELECT id FROM content_types WHERE slug = ?", [$slug])) > 0) { $errs = array::push($errs, "a type with that slug already exists"); }
    if (count($errs) > 0) {
        return response::html(admin_view("admin_type_def.html", ["slug" => $slug, "label" => $label, "url_pattern" => $url, "fields" => $fields_raw, "errors" => $errs]));
    }
    db::exec($c, "INSERT INTO content_types (slug, label, url_pattern, fields_json) VALUES (?, ?, ?, ?)", [$slug, $label, $url, json::encode($fields)]);
    types_cache_bust();   // new type's URL live immediately (no 60s TTL lag)
    return response::redirect("/admin/type/" . $slug);
});

// ── GENERIC admin CRUD — ONE handler set for EVERY type (the type engine) ────
route("GET", "/admin/type/{type}", function() {
    if (!is_admin()) { return response::redirect("/admin/login"); }
    $c = conn();
    $t = load_type($c, request::param("type"));
    if ($t == null) { return response::status(404, "No such type"); }
    // admin reads current_rev (draft-aware)
    $items = db::query($c, "SELECT c.id, c.slug, c.status, r.title FROM content c JOIN revisions r ON r.id = c.current_rev WHERE c.type = ? ORDER BY c.updated_at DESC", [$t["slug"]]);
    return response::html(admin_view("admin_type_list.html", ["type" => $t, "items" => $items]));
});

route("GET", "/admin/type/{type}/new", function() {
    if (!is_admin()) { return response::redirect("/admin/login"); }
    $c = conn();
    $t = load_type($c, request::param("type"));
    if ($t == null) { return response::status(404, "No such type"); }
    $form = fields_form_html($c, $t["fields"], null);
    return response::html(admin_view("admin_type_form.html", ["type" => $t, "action" => "/admin/type/" . $t["slug"] . "/new", "content_id" => "", "heading" => "New " . $t["label"], "fields_html" => $form, "slug" => "", "status" => "draft", "lang" => "tr", "errors" => []]));
});

// A slug is unique per (lang, type); reject a collision gracefully instead of
// letting the UNIQUE constraint 500 the edit form.
function norm_lang($l) { if ($l == "en") { return "en"; } return "tr"; }
function slug_taken($c, $type, $slug, $exclude_id, $lang) {
    return count(db::query($c, "SELECT id FROM content WHERE type = ? AND slug = ? AND lang = ? AND id != ?", [$type, $slug, $lang, $exclude_id])) > 0;
}
route("POST", "/admin/type/{type}/new", function() {
    if (!is_admin()) { return response::redirect("/admin/login"); }
    $c = conn();
    $t = load_type($c, request::param("type"));
    if ($t == null) { return response::status(404, "No such type"); }
    $v = validate_post($c, $t["fields"]);
    $slug = string::trim(request::post("slug"));
    $errs = $v["errors"];
    $lang = norm_lang(request::post("lang"));
    if ($slug == "") { $errs = array::push($errs, "slug is required"); }
    if ($slug != "") { if (slug_taken($c, $t["slug"], $slug, 0, $lang)) { $errs = array::push($errs, "bu slug bu dilde zaten kullanımda"); } }
    if (count($errs) > 0) {
        $form = fields_form_html($c, $t["fields"], $v["values"]);
        return response::html(admin_view("admin_type_form.html", ["type" => $t, "action" => "/admin/type/" . $t["slug"] . "/new", "content_id" => "", "heading" => "New " . $t["label"], "fields_html" => $form, "slug" => $slug, "status" => request::post("status"), "lang" => $lang, "errors" => $errs]));
    }
    save_content($c, $t["slug"], 0, $slug, $v["values"], request::post("status"), $lang);
    return response::redirect("/admin/type/" . $t["slug"]);
});

route("GET", "/admin/type/{type}/edit/{id}", function() {
    if (!is_admin()) { return response::redirect("/admin/login"); }
    $c = conn();
    $t = load_type($c, request::param("type"));
    if ($t == null) { return response::status(404, "No such type"); }
    $rows = db::query($c, "SELECT c.slug, c.status, c.lang, r.fields_json FROM content c JOIN revisions r ON r.id = c.current_rev WHERE c.id = ?", [request::param("id")]);
    if (count($rows) == 0) { return response::status(404, "No such item"); }
    $vals = json::decode($rows[0]["fields_json"]);
    $form = fields_form_html($c, $t["fields"], $vals);
    return response::html(admin_view("admin_type_form.html", ["type" => $t, "action" => "/admin/type/" . $t["slug"] . "/edit/" . request::param("id"), "content_id" => request::param("id"), "heading" => "Edit " . $t["label"], "fields_html" => $form, "slug" => $rows[0]["slug"], "status" => $rows[0]["status"], "lang" => $rows[0]["lang"], "errors" => []]));
});

route("POST", "/admin/type/{type}/edit/{id}", function() {
    if (!is_admin()) { return response::redirect("/admin/login"); }
    $c = conn();
    $t = load_type($c, request::param("type"));
    if ($t == null) { return response::status(404, "No such type"); }
    $v = validate_post($c, $t["fields"]);
    $slug = string::trim(request::post("slug"));
    $errs = $v["errors"];
    $lang = norm_lang(request::post("lang"));
    if ($slug != "") { if (slug_taken($c, $t["slug"], $slug, type::to_int(request::param("id")), $lang)) { $errs = array::push($errs, "bu slug bu dilde zaten kullanımda"); } }
    if (count($errs) > 0) {
        $form = fields_form_html($c, $t["fields"], $v["values"]);
        return response::html(admin_view("admin_type_form.html", ["type" => $t, "action" => "/admin/type/" . $t["slug"] . "/edit/" . request::param("id"), "content_id" => request::param("id"), "heading" => "Edit " . $t["label"], "fields_html" => $form, "slug" => $slug, "status" => request::post("status"), "lang" => $lang, "errors" => $errs]));
    }
    save_content($c, $t["slug"], type::to_int(request::param("id")), $slug, $v["values"], request::post("status"), $lang);
    return response::redirect("/admin/type/" . $t["slug"]);
});

route("POST", "/admin/type/{type}/delete/{id}", function() {
    if (!is_admin()) { return response::redirect("/admin/login"); }
    $c = conn();
    db::exec($c, "DELETE FROM revisions WHERE content_id = ?", [request::param("id")]);
    db::exec($c, "DELETE FROM content WHERE id = ?", [request::param("id")]);
    return response::redirect("/admin/type/" . request::param("type"));
});

// ── revision history + rollback (versioned core: rollback = a pointer move) ───
route("GET", "/admin/type/{type}/history/{id}", function() {
    if (!is_admin()) { return response::redirect("/admin/login"); }
    $c = conn();
    $id = request::param("id");
    $type = request::param("type");
    $cont = db::query($c, "SELECT current_rev, slug FROM content WHERE id = ?", [$id]);
    if (count($cont) == 0) { return response::status(404, view("notfound.html", [])); }
    $cur = type::to_int($cont[0]["current_rev"]);
    $revs = db::query($c, "SELECT id, rev_no, title, note FROM revisions WHERE content_id = ? ORDER BY rev_no DESC", [$id]);
    $rows = "";
    foreach ($revs as $r) {
        $badge = ""; $btn = "<form method=\"post\" action=\"/admin/type/" . $type . "/rollback/" . $id . "\" class=\"inline\"><input type=\"hidden\" name=\"rev\" value=\"" . $r["id"] . "\"><button>Bu sürüme dön</button></form>";
        if (type::to_int($r["id"]) == $cur) { $badge = " <span class=\"badge\">güncel</span>"; $btn = ""; }
        $rows = $rows . "<tr><td>#" . $r["rev_no"] . $badge . "</td><td>" . html::escape($r["title"]) . "</td><td>" . html::escape($r["note"]) . "</td><td>" . $btn . "</td></tr>";
    }
    return response::html(admin_view("admin_history.html", ["type" => $type, "id" => $id, "slug" => $cont[0]["slug"], "rows" => $rows, "count" => count($revs)]));
});
route("POST", "/admin/type/{type}/rollback/{id}", function() {
    if (!is_admin()) { return response::redirect("/admin/login"); }
    $c = conn();
    $id = request::param("id");
    $rev = request::post("rev");
    // Validate the revision belongs to this content, then repoint (no data rewrite).
    $chk = db::query($c, "SELECT id FROM revisions WHERE id = ? AND content_id = ?", [$rev, $id]);
    if (count($chk) == 1) {
        $cont = db::query($c, "SELECT status FROM content WHERE id = ?", [$id]);
        $pub = 0;
        if (count($cont) == 1) { if ($cont[0]["status"] == "published") { $pub = $rev; } }
        db::exec($c, "UPDATE content SET current_rev = ?, published_rev = ?, updated_at = ? WHERE id = ?", [$rev, $pub, date::timestamp(), $id]);
    }
    return response::redirect("/admin/type/" . request::param("type") . "/history/" . $id);
});

// ── JSON API — published_rev ONLY (read-surface invariant) ────────────────────
route("GET", "/api/{type}", function() {
    $c = conn();
    $t = load_type($c, request::param("type"));
    if ($t == null) { return response::status(404, "{\"error\":\"no such type\"}"); }
    $rows = db::query($c, "SELECT c.slug, r.title, r.fields_json FROM content c JOIN revisions r ON r.id = c.published_rev WHERE c.type = ? AND c.published_rev > 0 ORDER BY c.updated_at DESC", [$t["slug"]]);
    $out = [];
    foreach ($rows as $row) {
        $item = json::decode($row["fields_json"]);
        $item = array::set($item, "slug", $row["slug"]);
        $out = array::push($out, $item);
    }
    response::text(json::encode($out));
    response::header("Content-Type", "application/json");
    return;
});

// ── preview — admin-session gated (draft reachable ONLY here) ─────────────────
route("GET", "/preview/{id}", function() {
    if (!is_admin()) { return response::status(403, "admin only"); }
    $c = conn();
    $rows = db::query($c, "SELECT r.title, r.body_html FROM content c JOIN revisions r ON r.id = c.current_rev WHERE c.id = ?", [request::param("id")]);
    if (count($rows) == 0) { return response::status(404, view("notfound.html", [])); }
    return response::html(view("page.html", ["title" => $rows[0]["title"], "content" => $rows[0]["body_html"], "extra" => ""]));
});

// ── generic custom-field renderer ────────────────────────────────────────────
// EVERY type renders its own fields with no type-specific code: read the type's
// field definitions + the revision's stored values, emit a block. `image`/`price`
// get nicer markup; everything else is a labelled row. This is why a Product page
// shows an image and a price while a Post shows none — same engine, declared fields.
function render_fields_html($c, $type, $fields_json) {
    $trow = db::query($c, "SELECT fields_json FROM content_types WHERE slug = ?", [$type]);
    if (count($trow) == 0) { return ""; }
    $defs = json::decode($trow[0]["fields_json"]);
    $vals = json::decode($fields_json);
    if ($vals == null) { return ""; }
    $out = "";
    foreach ($defs as $f) {
        $name = $f["name"];
        if ($name == "title" || $name == "body") { continue; }
        $v = "";
        try { $v = $vals[$name]; } catch ($e) { $v = ""; }
        if ($v == null) { $v = ""; }
        if ($v == "") { continue; }
        if ($name == "image") {
            $out = $out . "<img class=\"cf-image\" src=\"" . html::escape($v) . "\" alt=\"\" onerror=\"this.style.display='none'\">";
        } else {
            if ($name == "price") {
                $out = $out . "<div class=\"cf-price\">" . html::escape($v) . " &#8378;</div>";
            } else {
                $out = $out . "<div class=\"cf-row\"><span class=\"cf-label\">" . html::escape($name) . "</span> " . html::escape($v) . "</div>";
            }
        }
    }
    if ($out == "") { return ""; }
    return "<div class=\"cf\">" . $out . "</div>";
}

// ── public: published_rev ONLY. Serve content of a type by slug. ─────────────
function render_published($type, $slug, $lang) {
    $c = conn();
    $rows = db::query($c, "SELECT r.title, r.body_html, r.fields_json FROM content c JOIN revisions r ON r.id = c.published_rev WHERE c.type = ? AND c.slug = ? AND c.lang = ? AND c.published_rev > 0", [$type, $slug, $lang]);
    if (count($rows) == 0) { return response::status(404, view("notfound.html", [])); }
    $extra = render_fields_html($c, $type, $rows[0]["fields_json"]);
    // Commerce signal: any type that declares a non-empty `price` gets an
    // add-to-cart button (the cart is a dynamic island, session-backed).
    $vals = json::decode($rows[0]["fields_json"]);
    $price = "";
    if ($vals != null) { try { $price = $vals["price"]; } catch ($e) { $price = ""; } }
    if ($price != null) {
        if ($price != "") {
            $extra = $extra . "<form method=\"post\" action=\"/cart/add\" class=\"add-cart\"><input type=\"hidden\" name=\"slug\" value=\"" . html::escape($slug) . "\"><button>Sepete ekle</button></form>";
        }
    }
    // SEO: meta description from the body + Product JSON-LD when priced.
    $desc = string::substr(html::strip($rows[0]["body_html"]), 0, 155);
    $jsonld = "";
    if ($price != null) {
        if ($price != "") {
            $ld = ["@context" => "https://schema.org", "@type" => "Product",
                   "name" => $rows[0]["title"], "description" => $desc,
                   "offers" => ["@type" => "Offer", "price" => $price, "priceCurrency" => "TRY", "availability" => "https://schema.org/InStock"]];
            $jsonld = json::encode($ld);
        }
    }
    $head = seo_head($rows[0]["title"], $desc, "website", $jsonld);
    return response::html(view("page.html", ["title" => $rows[0]["title"], "content" => $rows[0]["body_html"], "extra" => $extra, "head_extra" => $head]));
}

// ── generic listing (catalog) — ONE renderer for EVERY type ──────────────────
// Published items as cards; a card shows the item's image + price when the type
// declares those fields (so /product is a shop grid, /blog-like types a list).
// shared card builder — used by the catalog listing AND the home showcase.
function cards_html($base, $rows) {
    $cards = "";
    foreach ($rows as $it) {
        $vals = json::decode($it["fields_json"]);
        $img = ""; $price = "";
        if ($vals != null) {
            try { $img = $vals["image"]; } catch ($e) { $img = ""; }
            try { $price = $vals["price"]; } catch ($e) { $price = ""; }
        }
        if ($img == null) { $img = ""; }
        if ($price == null) { $price = ""; }
        $imgh = "";
        if ($img != "") { $imgh = "<span class=\"card-img\"><img src=\"" . html::escape($img) . "\" alt=\"\" onerror=\"this.style.display='none'\"></span>"; }
        $priceh = "";
        if ($price != "") { $priceh = "<div class=\"card-price\">" . html::escape($price) . " &#8378;</div>"; }
        $url = $base . "/" . $it["slug"];
        $cards = $cards . "<a class=\"card\" href=\"" . html::escape($url) . "\">" . $imgh . "<div class=\"card-body\"><div class=\"card-title\">" . html::escape($it["title"]) . "</div>" . $priceh . "</div></a>";
    }
    return $cards;
}
function lang_prefix($lang) { if ($lang == "tr") { return ""; } return "/" . $lang; }
function render_listing($c, $type, $lang) {
    $t = load_type($c, $type);
    if ($t == null) { return response::status(404, view("notfound.html", [])); }
    $base = lang_prefix($lang) . string::replace($t["url_pattern"], "/{slug}", "");
    $rows = db::query($c, "SELECT c.slug, r.title, r.fields_json FROM content c JOIN revisions r ON r.id = c.published_rev WHERE c.type = ? AND c.lang = ? AND c.published_rev > 0 ORDER BY c.updated_at DESC, c.id DESC", [$type, $lang]);
    $cards = cards_html($base, $rows);
    if ($cards == "") { $cards = "<p class=\"muted\">No published items yet.</p>"; }
    return response::html(view("list.html", ["label" => $t["label"], "count" => count($rows), "cards" => $cards]));
}
// ── v1 parity: home + blog index (paginated) + media library ─────────────────
// Specific routes — MUST be registered BEFORE the generic dispatcher catch-alls below
// (route-shadow: first-match wins). Blog posts are versioned content of type 'post';
// the public listing reads published_rev ONLY (read-surface invariant). Post DETAIL is
// served by the dispatcher (url_pattern '/blog/{slug}'), so only the index lives here.

// Home + blog — lang-aware (tr = no prefix, en = /en). The versioned core carries
// a `lang` column, so a page/post/product exists per language under the same slug.
function home_render($lang) {
    $c = conn();
    $pfx = lang_prefix($lang);
    $prod_rows = db::query($c, "SELECT c.slug, r.title, r.fields_json FROM content c JOIN revisions r ON r.id = c.published_rev WHERE c.type = 'product' AND c.lang = ? AND c.published_rev > 0 ORDER BY c.updated_at DESC, c.id DESC LIMIT 4", [$lang]);
    $products_section = "";
    if (count($prod_rows) > 0) {
        $products_section = "<div class=\"section-head\"><h2>Featured products</h2><a class=\"more\" href=\"" . $pfx . "/product\">All products &rarr;</a></div><div class=\"cards\">" . cards_html($pfx . "/product", $prod_rows) . "</div>";
    }
    $posts = db::query($c, "SELECT c.slug, r.title FROM content c JOIN revisions r ON r.id = c.published_rev WHERE c.type = 'post' AND c.lang = ? AND c.published_rev > 0 ORDER BY c.updated_at DESC, c.id DESC LIMIT 5", [$lang]);
    $tagline = setting_get($c, "tagline", "Bir kurulum — blog, mağaza, kurumsal site. Aynı motor, tanımladığın içerik tipleri.");
    return response::html(view("home.html", ["products_section" => $products_section, "posts" => $posts, "tagline" => $tagline, "lang_prefix" => $pfx]));
}
function blog_render($lang) {
    $c = conn();
    $pfx = lang_prefix($lang);
    $per = 5;
    $page = type::to_int(request::get("page") ?? "1");
    if ($page < 1) { $page = 1; }
    $offset = ($page - 1) * $per;
    $total = type::to_int(db::query($c, "SELECT COUNT(*) AS n FROM content WHERE type = 'post' AND lang = ? AND published_rev > 0", [$lang])[0]["n"]);
    $posts = db::query($c, "SELECT c.slug, r.title FROM content c JOIN revisions r ON r.id = c.published_rev WHERE c.type = 'post' AND c.lang = ? AND c.published_rev > 0 ORDER BY c.updated_at DESC, c.id DESC LIMIT ? OFFSET ?", [$lang, $per, $offset]);
    return response::html(view("blog.html", [
        "posts" => $posts, "page" => $page, "prev" => $page - 1, "next" => $page + 1,
        "has_prev" => $page > 1, "has_next" => ($offset + $per) < $total, "lang_prefix" => $pfx
    ]));
}
route("GET", "/",        function() { return home_render("tr"); });
route("GET", "/en",      function() { return home_render("en"); });
route("GET", "/blog",    function() { return blog_render("tr"); });
route("GET", "/en/blog", function() { return blog_render("en"); });

// Media library — uploads are NOT versioned content; a separate media table names files
// by sha256 (dedupe) and keeps them outside the web root. Admin list/upload/delete;
// public serve by the sha-hex name (a strict hex/ext whitelist rejects traversal).
function media_mimes() { return ["image/png", "image/jpeg", "image/gif", "image/webp"]; }
route("GET", "/admin/media", function() {
    if (!is_admin()) { return response::redirect("/admin/login"); }
    $c = conn();
    $items = db::query($c, "SELECT id, sha_name, original, mime, size FROM media ORDER BY created_at DESC, id DESC", []);
    return response::html(admin_view("admin_media.html", ["items" => $items, "error" => ""]));
});
route("POST", "/admin/media", function() {
    if (!is_admin()) { return response::redirect("/admin/login"); }
    $f = null;
    try { $f = request::file("file", ["max_size" => 5242880, "allow_mime" => media_mimes()]); } catch ($e) { $f = null; }
    if ($f == null) {
        $c = conn();
        $items = db::query($c, "SELECT id, sha_name, original, mime, size FROM media ORDER BY created_at DESC, id DESC", []);
        return response::html(admin_view("admin_media.html", ["items" => $items, "error" => "No file, or type not allowed (png / jpeg / gif / webp, max 5 MB)."]));
    }
    $s = file::store($f, "media");
    $c = conn();
    $exists = db::query($c, "SELECT id FROM media WHERE sha_name = ?", [$s["name"]]);
    if (count($exists) == 0) {
        db::exec($c, "INSERT INTO media (sha_name, original, mime, size, created_at) VALUES (?, ?, ?, ?, ?)", [$s["name"], $f["filename"], $s["mime"], $f["size"], date::timestamp()]);
    }
    return response::redirect("/admin/media");
});
route("POST", "/admin/media/delete/{id}", function() {
    if (!is_admin()) { return response::redirect("/admin/login"); }
    $c = conn();
    $rows = db::query($c, "SELECT sha_name FROM media WHERE id = ?", [request::param("id")]);
    if (count($rows) > 0) {
        $path = file::upload_dir() . "/media/" . $rows[0]["sha_name"];
        if (file::exists($path)) { file::remove($path); }
        db::exec($c, "DELETE FROM media WHERE id = ?", [request::param("id")]);
    }
    return response::redirect("/admin/media");
});
route("GET", "/media/{name}", function() {
    $name = request::param("name");
    if (!string::regex_match($name, "^[0-9a-f]{32}\\.[a-z0-9]{2,5}$")) { return response::status(404, "Not found"); }
    $c = conn();
    $rows = db::query($c, "SELECT mime FROM media WHERE sha_name = ?", [$name]);
    if (count($rows) == 0) { return response::status(404, "Not found"); }
    $path = file::upload_dir() . "/media/" . $name;
    if (!file::exists($path)) { return response::status(404, "Not found"); }
    $bytes = file::read($path);
    response::text($bytes);
    response::header("Content-Type", $rows[0]["mime"]);
    response::header("Cache-Control", "public, max-age=31536000, immutable");
    return;
});

// DYNAMIC per-type routing: one route per type's url_pattern, straight from
// content_types — a NEW type auto-routes with no code change. Uses AUTO-capture (no
// use()) on purpose: a VM bug wraps a `use()`-captured loop-local in a single-element
// array at request time (see FRICTION_phase1.md #3, core candidate); auto-capture is
// clean. Sorted by url_pattern length DESC so the bare "/{slug}" catch-all is LAST.
// ── search (SQL LIKE across published content; FTS5 is the measured next step) ─
route("GET", "/search", function() {
    $c = conn();
    $q = request::get("q") ?? "";
    $q = string::trim($q);
    $results = ""; $count = 0;
    if ($q != "") {
        $like = "%" . $q . "%";
        $rows = db::query($c, "SELECT c.type, c.slug, r.title, ct.url_pattern FROM content c JOIN revisions r ON r.id = c.published_rev JOIN content_types ct ON ct.slug = c.type WHERE c.published_rev > 0 AND (r.title LIKE ? OR r.body_md LIKE ?) ORDER BY c.updated_at DESC, c.id DESC LIMIT 50", [$like, $like]);
        $count = count($rows);
        foreach ($rows as $r) {
            $url = string::replace($r["url_pattern"], "{slug}", $r["slug"]);
            $results = $results . "<li><a href=\"" . html::escape($url) . "\">" . html::escape($r["title"]) . "</a> <span class=\"muted\">(" . html::escape($r["type"]) . ")</span></li>";
        }
        if ($results == "") { $results = "<li class=\"muted\">\"" . html::escape($q) . "\" için sonuç yok.</li>"; }
    }
    return response::html(view("search.html", ["q" => $q, "count" => $count, "results" => $results]));
});

// ── syndication + crawlability: sitemap.xml · robots.txt · RSS feed ──────────
function base_url() {
    $host = request::header("Host"); if ($host == null) { $host = "localhost"; }
    $proto = request::header("X-Forwarded-Proto"); if ($proto == null) { $proto = "http"; }
    return $proto . "://" . $host;
}
route("GET", "/sitemap.xml", function() {
    $c = conn();
    $base = base_url();
    $rows = db::query($c, "SELECT c.slug, ct.url_pattern FROM content c JOIN content_types ct ON ct.slug = c.type WHERE c.published_rev > 0", []);
    $urls = "";
    foreach ($rows as $r) {
        $path = string::replace($r["url_pattern"], "{slug}", $r["slug"]);
        $urls = $urls . "<url><loc>" . html::escape($base . $path) . "</loc></url>";
    }
    $xml = "<?xml version=\"1.0\" encoding=\"UTF-8\"?><urlset xmlns=\"http://www.sitemaps.org/schemas/sitemap/0.9\">" . $urls . "</urlset>";
    response::text($xml);
    response::header("Content-Type", "application/xml; charset=utf-8");
    return;
});
route("GET", "/robots.txt", function() {
    response::text("User-agent: *\nAllow: /\nSitemap: " . base_url() . "/sitemap.xml\n");
    return;
});
route("GET", "/feed", function() {
    $c = conn();
    $base = base_url();
    $posts = db::query($c, "SELECT c.slug, r.title, r.body_html FROM content c JOIN revisions r ON r.id = c.published_rev WHERE c.type = 'post' AND c.published_rev > 0 ORDER BY c.updated_at DESC, c.id DESC LIMIT 20", []);
    $items = "";
    foreach ($posts as $p) {
        $link = $base . "/blog/" . $p["slug"];
        $desc = string::substr(html::strip($p["body_html"]), 0, 300);
        $items = $items . "<item><title>" . html::escape($p["title"]) . "</title><link>" . html::escape($link) . "</link><description>" . html::escape($desc) . "</description></item>";
    }
    $t = site_title();
    $xml = "<?xml version=\"1.0\" encoding=\"UTF-8\"?><rss version=\"2.0\"><channel><title>" . html::escape($t) . "</title><link>" . html::escape($base) . "</link><description>" . html::escape($t) . "</description>" . $items . "</channel></rss>";
    response::text($xml);
    response::header("Content-Type", "application/rss+xml; charset=utf-8");
    return;
});

// ── forms (contact/lead → stored submissions; honeypot spam guard) ───────────
route("GET", "/contact", function() {
    $sent = request::get("sent") ?? "";
    return response::html(view("contact.html", ["sent" => $sent]));
});
route("POST", "/forms/{key}", function() {
    $c = conn();
    $key = request::param("key");
    // Honeypot: a hidden "website" field bots fill and humans never see. If set,
    // silently accept-and-drop (don't tell the bot it failed).
    $hp = request::post("website");
    if ($hp != null) { if ($hp != "") { return response::redirect("/contact?sent=1"); } }
    $name = request::post("name"); if ($name == null) { $name = ""; }
    $email = request::post("email"); if ($email == null) { $email = ""; }
    $message = request::post("message"); if ($message == null) { $message = ""; }
    $data = ["name" => $name, "email" => $email, "message" => $message];
    db::exec($c, "INSERT INTO form_submissions (form_key, data_json, created_at) VALUES (?, ?, ?)", [$key, json::encode($data), date::timestamp()]);
    return response::redirect("/contact?sent=1");
});
route("GET", "/admin/forms", function() {
    if (!is_admin()) { return response::redirect("/admin/login"); }
    $c = conn();
    $subs = db::query($c, "SELECT form_key, data_json FROM form_submissions ORDER BY id DESC LIMIT 200", []);
    $rows = "";
    foreach ($subs as $sub) {
        $d = json::decode($sub["data_json"]);
        $name = ""; $email = ""; $msg = "";
        if ($d != null) {
            try { $name = $d["name"]; } catch ($e) { $name = ""; }
            try { $email = $d["email"]; } catch ($e) { $email = ""; }
            try { $msg = $d["message"]; } catch ($e) { $msg = ""; }
        }
        if ($name == null) { $name = ""; }
        if ($email == null) { $email = ""; }
        if ($msg == null) { $msg = ""; }
        $rows = $rows . "<tr><td>" . html::escape($sub["form_key"]) . "</td><td>" . html::escape($name) . "</td><td>" . html::escape($email) . "</td><td>" . html::escape($msg) . "</td></tr>";
    }
    if ($rows == "") { $rows = "<tr><td colspan=\"4\" class=\"muted\">Henüz gönderim yok.</td></tr>"; }
    return response::html(admin_view("admin_forms.html", ["rows" => $rows, "count" => count($subs)]));
});

// ── cart (dynamic island) — session-backed, per visitor. MUST precede /{a}. ──
// Commerce as an extension of the type engine: a Product is catalog data (②),
// the cart is a live island (③). No payment here (that is a Phase-6 package).
function cart_get() {
    session::start();
    $raw = session::get("cart");
    if ($raw == null) { return []; }
    if ($raw == "") { return []; }
    $parsed = json::decode($raw);
    if ($parsed == null) { return []; }
    return $parsed;
}
function cart_save($cart) { session::start(); session::set("cart", json::encode($cart)); }

route("POST", "/cart/add", function() {
    $c = conn();
    $slug = request::post("slug");
    $rows = db::query($c, "SELECT r.title, r.fields_json FROM content c JOIN revisions r ON r.id = c.published_rev WHERE c.type = 'product' AND c.slug = ? AND c.published_rev > 0", [$slug]);
    if (count($rows) == 0) { return response::redirect("/product"); }
    $vals = json::decode($rows[0]["fields_json"]);
    $price = "0";
    if ($vals != null) { try { $price = $vals["price"]; } catch ($e) { $price = "0"; } }
    if ($price == null) { $price = "0"; }
    $cart = cart_get();
    $new = []; $found = false;
    foreach ($cart as $it) {
        if ($it["slug"] == $slug) { $it["qty"] = $it["qty"] + 1; $found = true; }
        $new = array::push($new, $it);
    }
    if (!$found) {
        $new = array::push($new, ["slug" => $slug, "title" => $rows[0]["title"], "price" => $price, "qty" => 1]);
    }
    cart_save($new);
    return response::redirect("/cart");
});

route("POST", "/cart/remove", function() {
    $slug = request::post("slug");
    $cart = cart_get();
    $new = [];
    foreach ($cart as $it) { if ($it["slug"] != $slug) { $new = array::push($new, $it); } }
    cart_save($new);
    return response::redirect("/cart");
});

route("GET", "/cart", function() {
    $cart = cart_get();
    $rows_html = ""; $total = 0.0;
    foreach ($cart as $it) {
        $line = type::to_float($it["price"]) * $it["qty"];
        $total = $total + $line;
        $rows_html = $rows_html . "<tr><td>" . html::escape($it["title"]) . "</td><td>" . html::escape($it["price"]) . " &#8378;</td><td>" . $it["qty"] . "</td><td>" . $line . " &#8378;</td><td><form method=\"post\" action=\"/cart/remove\" class=\"inline\"><input type=\"hidden\" name=\"slug\" value=\"" . html::escape($it["slug"]) . "\"><button class=\"del\">&times;</button></form></td></tr>";
    }
    if ($rows_html == "") { $rows_html = "<tr><td colspan=\"5\" class=\"muted\">Sepetiniz boş.</td></tr>"; }
    return response::html(view("cart.html", ["rows" => $rows_html, "total" => $total, "count" => count($cart)]));
});

route("POST", "/checkout", function() {
    // Demo checkout: no payment (Phase 6 = paytr/iyzico packages). Persists a real
    // order + line items, clears the cart, confirms — the WooCommerce test's
    // "order record" half, end to end without a provider.
    $c = conn();
    $cart = cart_get();
    if (count($cart) == 0) { return response::redirect("/cart"); }
    $email = request::post("email"); if ($email == null) { $email = ""; }
    $cust_name = request::post("cust_name"); if ($cust_name == null) { $cust_name = ""; }
    $address = request::post("address"); if ($address == null) { $address = ""; }
    $phone = request::post("phone"); if ($phone == null) { $phone = ""; }
    $total = 0.0;
    foreach ($cart as $it) { $total = $total + type::to_float($it["price"]) * $it["qty"]; }
    $ts = date::timestamp();
    db::exec($c, "INSERT INTO orders (email, cust_name, address, phone, total, status, created_at) VALUES (?, ?, ?, ?, ?, 'received', ?)", [$email, $cust_name, $address, $phone, "" . $total, $ts]);
    $oid = db::last_id($c);
    foreach ($cart as $it) {
        db::exec($c, "INSERT INTO order_items (order_id, slug, title, price, qty) VALUES (?, ?, ?, ?, ?)", [$oid, $it["slug"], $it["title"], "" . $it["price"], $it["qty"]]);
    }
    $n = count($cart);
    cart_save([]);
    return response::html(view("checkout.html", ["count" => $n, "order_id" => $oid, "total" => $total]));
});

// ── admin: orders ────────────────────────────────────────────────────────────
route("GET", "/admin/orders", function() {
    if (!is_admin()) { return response::redirect("/admin/login"); }
    $c = conn();
    $orders = db::query($c, "SELECT id, email, total, status, created_at FROM orders ORDER BY id DESC", []);
    $rows_html = "";
    foreach ($orders as $o) {
        $mail = $o["email"];
        if ($mail == "") { $mail = "—"; }
        $rows_html = $rows_html . "<tr><td><a href=\"/admin/order/" . $o["id"] . "\">#" . $o["id"] . "</a></td><td>" . html::escape($mail) . "</td><td>" . html::escape($o["total"]) . " &#8378;</td><td>" . html::escape($o["status"]) . "</td></tr>";
    }
    if ($rows_html == "") { $rows_html = "<tr><td colspan=\"4\" class=\"muted\">Henüz sipariş yok.</td></tr>"; }
    return response::html(admin_view("admin_orders.html", ["rows" => $rows_html, "count" => count($orders)]));
});
route("GET", "/admin/order/{id}", function() {
    if (!is_admin()) { return response::redirect("/admin/login"); }
    $c = conn();
    $id = request::param("id");
    $orows = db::query($c, "SELECT id, email, cust_name, address, phone, total, status FROM orders WHERE id = ?", [$id]);
    if (count($orows) == 0) { return response::status(404, view("notfound.html", [])); }
    $o = $orows[0];
    $items = db::query($c, "SELECT title, price, qty FROM order_items WHERE order_id = ?", [$id]);
    $items_html = "";
    foreach ($items as $it) {
        $items_html = $items_html . "<tr><td>" . html::escape($it["title"]) . "</td><td>" . html::escape($it["price"]) . " &#8378;</td><td>" . $it["qty"] . "</td></tr>";
    }
    $mail = $o["email"];
    if ($mail == "") { $mail = "—"; }
    $statuses = ["received", "preparing", "shipped", "delivered", "cancelled"];
    $sel = "";
    foreach ($statuses as $st) {
        $selattr = "";
        if ($st == $o["status"]) { $selattr = " selected"; }
        $sel = $sel . "<option value=\"" . $st . "\"" . $selattr . ">" . $st . "</option>";
    }
    $cn = $o["cust_name"]; if ($cn == null) { $cn = ""; } if ($cn == "") { $cn = "—"; }
    $addr = $o["address"]; if ($addr == null) { $addr = ""; } if ($addr == "") { $addr = "—"; }
    $ph = $o["phone"]; if ($ph == null) { $ph = ""; } if ($ph == "") { $ph = "—"; }
    return response::html(admin_view("admin_order.html", ["id" => $o["id"], "email" => $mail, "cust_name" => $cn, "address" => $addr, "phone" => $ph, "total" => $o["total"], "status" => $o["status"], "items" => $items_html, "status_options" => $sel]));
});
route("POST", "/admin/order/{id}/status", function() {
    if (!is_admin()) { return response::redirect("/admin/login"); }
    $c = conn();
    $id = request::param("id");
    $status = request::post("status");
    $allowed = ["received", "preparing", "shipped", "delivered", "cancelled"];
    if (array::contains($allowed, $status)) {
        db::exec($c, "UPDATE orders SET status = ? WHERE id = ?", [$status, $id]);
    }
    return response::redirect("/admin/order/" . $id);
});

// ── admin: users (role 'admin' only — RBAC) ──────────────────────────────────
route("GET", "/admin/users", function() {
    if (!is_admin()) { return response::redirect("/admin/login"); }
    if (!is_super()) { return response::status(403, "Bu sayfa yalnız admin rolü içindir."); }
    $c = conn();
    $users = db::query($c, "SELECT username, role FROM users ORDER BY id", []);
    $rows = "";
    foreach ($users as $u) {
        $rows = $rows . "<tr><td>" . html::escape($u["username"]) . "</td><td>" . html::escape($u["role"]) . "</td></tr>";
    }
    return response::html(admin_view("admin_users.html", ["rows" => $rows, "count" => count($users)]));
});
route("POST", "/admin/users/new", function() {
    if (!is_admin()) { return response::redirect("/admin/login"); }
    if (!is_super()) { return response::status(403, "admin only"); }
    $c = conn();
    $u = string::trim(request::post("username"));
    $p = request::post("password");
    $role = request::post("role");
    if ($role != "admin") { $role = "editor"; }
    if ($u != "") {
        if ($p != null) {
            if ($p != "") {
                $exists = db::query($c, "SELECT id FROM users WHERE username = ?", [$u]);
                if (count($exists) == 0) {
                    db::exec($c, "INSERT INTO users (username, password_hash, role, created_at) VALUES (?, ?, ?, ?)", [$u, auth::hash($p), $role, date::timestamp()]);
                }
            }
        }
    }
    return response::redirect("/admin/users");
});

// ── admin: settings (role 'admin' only) ──────────────────────────────────────
route("GET", "/admin/settings", function() {
    if (!is_admin()) { return response::redirect("/admin/login"); }
    if (!is_super()) { return response::status(403, "admin only"); }
    $c = conn();
    $cur_theme = setting_get($c, "theme", "default");
    $topts = "";
    foreach (["default", "aurora"] as $th) {
        $sa = ""; if ($th == $cur_theme) { $sa = " selected"; }
        $topts = $topts . "<option value=\"" . $th . "\"" . $sa . ">" . $th . "</option>";
    }
    $cur_skin = setting_get($c, "skin", "default");
    $kopts = "";
    foreach (["default", "ocean", "sunset", "dark"] as $sk) {
        $sa = ""; if ($sk == $cur_skin) { $sa = " selected"; }
        $kopts = $kopts . "<option value=\"" . $sk . "\"" . $sa . ">" . $sk . "</option>";
    }
    return response::html(admin_view("admin_settings.html", [
        "s_title"    => setting_get($c, "site_title", "LookPress"),
        "s_tagline"  => setting_get($c, "tagline", ""),
        "s_currency" => setting_get($c, "currency", "&#8378;"),
        "theme_options" => $topts,
        "skin_options" => $kopts
    ]));
});
route("POST", "/admin/settings", function() {
    if (!is_admin()) { return response::redirect("/admin/login"); }
    if (!is_super()) { return response::status(403, "admin only"); }
    $c = conn();
    setting_set($c, "site_title", string::trim(request::post("site_title")));
    setting_set($c, "tagline", string::trim(request::post("tagline")));
    setting_set($c, "currency", string::trim(request::post("currency")));
    $th = request::post("theme");
    if (array::contains(["default", "aurora"], $th)) { setting_set($c, "theme", $th); }
    $sk = request::post("skin");
    if (array::contains(["default", "ocean", "sunset", "dark"], $sk)) { setting_set($c, "skin", $sk); }
    settings_bust();
    return response::redirect("/admin/settings");
});

// ── DYNAMIC per-type routing via a request-time dispatcher ────────────────────
// A new type auto-routes with NO restart: url_patterns are resolved from the DB at
// REQUEST time (where db:: works — the setup pass does not, see FRICTION #3a), and
// the closures take no use()-captured loop-local (avoiding the VM wrap, #3b).
// These two generic patterns MUST be the LAST routes registered — every specific route
// registered above wins by first-match: /admin/*, /api/{type}, /preview/{id}, /blog and
// /media/* (the v1-parity block just above). (Route-shadow contract, reference app Slice 1.)
//
//   1-segment  /{a}      → the type whose url_pattern is "/{slug}" (e.g. page), slug=a
//   2-segment  /{a}/{b}  → the type whose url_pattern is "/{a}/{slug}"  (e.g. post,
//                          product: /blog/{slug}, /products/{slug}), slug=b
// One path segment in a language: a published page at /{slug}, else a type listing.
function resolve_1seg($c, $seg, $lang) {
    $page = type_for_pattern($c, "/{slug}");           // cached (60s, busted on type write)
    if ($page != "") {
        $hit = db::query($c, "SELECT 1 AS x FROM content c JOIN revisions r ON r.id = c.published_rev WHERE c.type = ? AND c.slug = ? AND c.lang = ? AND c.published_rev > 0", [$page, $seg, $lang]);
        if (count($hit) > 0) { return render_published($page, $seg, $lang); }
    }
    $lt = type_for_base($c, "/" . $seg);
    if ($lt != "") { return render_listing($c, $lt, $lang); }
    return response::status(404, view("notfound.html", []));
}
// Two segments in a language: the type whose url_pattern is "/{a}/{slug}", slug=b.
function resolve_2seg($c, $a, $b, $lang) {
    $slug = type_for_pattern($c, "/" . $a . "/{slug}");
    if ($slug == "") { return response::status(404, view("notfound.html", [])); }
    return render_published($slug, $b, $lang);
}
// The /en prefix shifts every path one segment right; the same resolvers run with
// lang="en". Default (tr) has no prefix. (Bare /en and /en/blog are routed above.)
route("GET", "/{a}", function() {
    $c = conn();
    return resolve_1seg($c, request::param("a"), "tr");
});
route("GET", "/{a}/{b}", function() {
    $c = conn();
    $a = request::param("a");
    if ($a == "en") { return resolve_1seg($c, request::param("b"), "en"); }
    return resolve_2seg($c, $a, request::param("b"), "tr");
});
route("GET", "/{a}/{b}/{c}", function() {
    $c = conn();
    if (request::param("a") == "en") { return resolve_2seg($c, request::param("b"), request::param("c"), "en"); }
    return response::status(404, view("notfound.html", []));
});
