// src/core.lk — framework core: DB connection, cached settings, view rendering,
// SEO head, auth gates, base URL. No routes here — pure helpers the rest build on.
use db;
use cache;
use session;
use file;
use template;
use array;
use html;
use json;
use date;
use string;

function conn() { return db::connect(env("DB_DSN", "sqlite://cms.db")); }

// ── scheduled publishing ──────────────────────────────────────────────────────
// Parse an <input type="datetime-local"> value ("YYYY-MM-DDTHH:MM") into a stored
// ISO datetime ("YYYY-MM-DD HH:MM:SS"). Returns "" on empty/invalid input so a
// blank field simply means "publish now / not scheduled".
function parse_schedule($raw) {
    if ($raw == null) { return ""; }
    $raw = string::trim($raw);
    if ($raw == "") { return ""; }
    try { return date::parse($raw, "Y-m-dTH:i"); } catch ($e) { return ""; }
}
// Convert a stored ISO datetime ("YYYY-MM-DD HH:MM:SS") back to the datetime-local
// input value ("YYYY-MM-DDTHH:MM") for pre-filling the edit form. "" when unset.
function schedule_input($iso) {
    if ($iso == null) { return ""; }
    if ($iso == "") { return ""; }
    $s = string::substr($iso, 0, 16);
    return string::replace($s, " ", "T");
}
// Flip any due scheduled items live in one indexed UPDATE (normally 0 rows). Called
// once per request via before_route — visibility stays gated by published_rev > 0,
// so no public read query changes. No external scheduler/cron needed.
function activate_scheduled($c) {
    db::exec($c, "UPDATE content SET published_rev = current_rev, publish_at = NULL WHERE status = 'published' AND published_rev = 0 AND current_rev > 0 AND publish_at IS NOT NULL AND publish_at <= ?", [date::now()]);
}

// ── settings (namespaced key-value, cached) ──────────────────────────────────
// Namespaced + lazy-cached so it never becomes the wp_options bloat: the whole
// 'core' namespace is one cached map, read once per 60s, busted on write.
function settings_all($c) {
    $m = cache::get("core:settings");
    if ($m != null) { return $m; }
    $m = array::new_assoc();
    $rows = db::query($c, "SELECT skey, sval FROM settings WHERE ns = 'core'", []);
    foreach ($rows as $r) { $m = array::set($m, $r["skey"], $r["sval"]); }
    cache::set("core:settings", $m, 60);
    return $m;
}
function setting_get($c, $key, $default) {
    $m = settings_all($c);
    if (array::contains(array::keys($m), $key)) { return $m[$key]; }
    return $default;
}
function setting_set($c, $key, $val) {
    $ex = db::query($c, "SELECT id FROM settings WHERE ns = 'core' AND skey = ?", [$key]);
    if (count($ex) > 0) { db::exec($c, "UPDATE settings SET sval = ? WHERE ns = 'core' AND skey = ?", [$val, $key]); }
    else { db::exec($c, "INSERT INTO settings (ns, skey, sval) VALUES ('core', ?, ?)", [$key, $val]); }
}
function settings_bust() { cache::delete("core:settings"); }
function site_title() { return setting_get(conn(), "site_title", cfg_default_title()); }

// Managed navigation menu (items = [{label,url}]) by location; the site header
// renders the "primary" menu. Empty list if none defined.
function menu_items($c, $loc) {
    $rows = db::query($c, "SELECT items_json FROM menus WHERE location = ?", [$loc]);
    if (count($rows) == 0) { return []; }
    $items = json::decode($rows[0]["items_json"]);
    if ($items == null) { return []; }
    return $items;
}

// A THEME is a template directory (views/themes/{theme}/) that may override any
// public template; missing ones fall back to views/themes/default. A SKIN is a
// colour palette (data-theme) applied by the default layout. Independent settings.
function active_theme() { return setting_get(conn(), "theme", "default"); }
function active_skin() { return setting_get(conn(), "skin", "default"); }
function theme_tpl($theme, $tpl) {
    $p = "views/themes/" . $theme . "/" . $tpl;
    if (file::exists($p)) { return $p; }
    return "views/themes/default/" . $tpl;
}
// Installed themes (explicit list, philosophy: nothing hidden) + their manifest
// metadata (theme.json), with the active one flagged. Feeds the Themes admin.
function themes_list($c) {
    $active = active_theme();
    $out = [];
    foreach (cfg_themes() as $slug) {
        $label = $slug; $desc = "";
        $mp = "views/themes/" . $slug . "/theme.json";
        if (file::exists($mp)) {
            $m = json::decode(file::read($mp));
            if ($m != null) {
                try { $label = $m["name"]; } catch ($e) { $label = $slug; }
                try { $desc = $m["description"]; } catch ($e) { $desc = ""; }
            }
        }
        $out = array::push($out, ["slug" => $slug, "label" => $label, "desc" => $desc, "active" => ($slug == $active), "can_activate" => ($slug != $active)]);
    }
    return $out;
}
// Inject site title + skin into every PUBLIC view; default head_extra (SEO); render
// from the active theme with a per-template fallback to default. Admins may preview
// another installed theme with ?_theme=<slug> (no activation, per-request only).
function view($tpl, $data) {
    $theme = active_theme();
    $pv = request::get("_theme");
    if ($pv != null && $pv != "" && is_admin() && array::contains(cfg_themes(), $pv)) { $theme = $pv; }
    $data["site_title"] = site_title();
    $data["skin"] = active_skin();
    if (!array::contains(array::keys($data), "head_extra")) { $data["head_extra"] = ""; }
    // Per-page browser <title>; defaults to the site name when a view doesn't set one.
    if (!array::contains(array::keys($data), "page_title")) { $data["page_title"] = site_title(); }
    if (!array::contains(array::keys($data), "nav_items")) { $data["nav_items"] = menu_items(conn(), "primary"); }
    $data["csrf"] = csrf_field();   // public forms print {!$csrf} (src/security.lk)
    return template::render(theme_tpl($theme, $tpl), $data);
}
// Admin chrome data every admin page needs: the logged-in user, the super flag,
// and extension-contributed sidebar nav (commerce etc. inject via the "admin.nav"
// hook — the core names no extension).
function admin_chrome($data) {
    session::start();
    $un = session::get("uname"); if ($un == null) { $un = ""; }
    $data["nav_user"] = $un;
    $data["nav_super"] = is_super();
    // per-permission nav flags (so the sidebar shows only what the role may use)
    $data["can_users"] = can("users");
    $data["can_roles"] = can("roles");
    $data["can_settings"] = can("settings");
    $data["nav_manage"] = (can("users") || can("roles") || can("settings"));
    $data["ext_nav"] = xp_admin_nav(["super" => is_super()]);
    $c = conn();
    // Dynamic sidebar: the whole nav, grouped per the spec Admin IA from module config.
    $data["sidebar"] = admin_sidebar($c, $data["ext_nav"]);
    // Geriye uyumluluk: eski şablonlar {!$nav_types} basıyor olabilir (uzantı görünümleri).
    $data["nav_types"] = admin_nav_types($c);
    return $data;
}
// Tek bir nav bağlantısı.
function nav_link($href, $icon, $label) {
    return "<a href=\"" . html::escape($href) . "\" data-nav=\"" . html::escape($href) . "\"><span class=\"ic\">" . html::escape($icon) . "</span> " . html::escape($label) . "</a>";
}
// Modüller (content_types) — gizli olmayanlar, config ile; grup içi sıra: order, plural.
function admin_nav_modules($c) {
    $hidden = xp_hidden_types();
    $rows = db::query($c, "SELECT slug, label, config_json FROM content_types ORDER BY label", []);
    $mods = [];
    foreach ($rows as $r) {
        if (array::contains($hidden, $r["slug"])) { continue; }
        $cfg = type_config_decode($r["slug"], $r["label"], $r["config_json"]);
        $mods = array::push($mods, ["slug" => $r["slug"], "cfg" => $cfg]);
    }
    return $mods;
}
// Bir grubun modül bağlantıları (order'a göre sıralı; eşitlikte plural).
function admin_nav_group_modules($mods, $group) {
    $in = [];
    foreach ($mods as $m) { if ($m["cfg"]["group"] == $group) { $in = array::push($in, $m); } }
    // küçük liste: seçmeli sıralama (order, sonra plural)
    $sorted = [];
    $remaining = $in;
    while (count($remaining) > 0) {
        $best = null; $bi = -1; $i = 0;
        foreach ($remaining as $m) {
            $take = false;
            if ($best == null) { $take = true; }
            else {
                $mo = $m["cfg"]["order"]; $bo = $best["cfg"]["order"];
                if ($mo < $bo || ($mo == $bo && $m["cfg"]["plural"] < $best["cfg"]["plural"])) { $take = true; }
            }
            if ($take) { $best = $m; $bi = $i; }
            $i = $i + 1;
        }
        $sorted = array::push($sorted, $best);
        $rest = []; $i = 0;
        foreach ($remaining as $m) { if ($i != $bi) { $rest = array::push($rest, $m); } $i = $i + 1; }
        $remaining = $rest;
    }
    $h = "";
    foreach ($sorted as $m) { $h = $h . nav_link("/admin/type/" . $m["slug"], $m["cfg"]["icon"], $m["cfg"]["plural"]); }
    return $h;
}
// Eski düz liste (geriye uyumluluk için {!$nav_types}).
function admin_nav_types($c) {
    $h = "";
    foreach (admin_nav_modules($c) as $m) { $h = $h . nav_link("/admin/type/" . $m["slug"], "▦", $m["cfg"]["plural"]); }
    return $h;
}
// ── dynamic sidebar ───────────────────────────────────────────────────────────
// The whole admin nav HTML, grouped per the spec Admin IA (kurumsal / icerik /
// iletisim / ecommerce / ayarlar / kullanici), modules ordered by config.order and
// shown with config.icon + config.plural; empty groups are hidden. Fixed entries
// keep the exact permission gates the former static sidebar had (settings/users/
// roles). Extension nav (xp_admin_nav) is injected inside the ecommerce group.
function admin_sidebar($c, $ext_nav) {
    $mods = admin_nav_modules($c);
    $can_users = can("users"); $can_roles = can("roles"); $can_settings = can("settings");
    $h = nav_link("/admin", "▤", "Panel");
    foreach (module_groups() as $g) {
        $key = $g["key"];
        $items = admin_nav_group_modules($mods, $key);
        if ($key == "icerik") {
            $items = $items . nav_link("/admin/media", "▣", "Medya");
        }
        if ($key == "iletisim") {
            $items = $items . nav_link("/admin/forms", "✉", "Formlar");
        }
        if ($key == "ecommerce" && $ext_nav != null && $ext_nav != "") {
            // Uzantı kendi grup başlığıyla gelir (commerce → "Ticaret"); bu grupta zaten
            // modül varsa başlığı çıkar, yoksa uzantının başlığı grubun başlığı olur.
            $x = $ext_nav;
            if ($items != "" && string::starts_with($x, "<div class=\"grp\">")) {
                $end = string::index_of($x, "</div>");
                if ($end >= 0) { $x = string::substr($x, $end + 6); }
            }
            if ($items == "") { $h = $h . $x; continue; }
            $items = $items . $x;
        }
        if ($key == "ayarlar") {
            if ($can_settings) {
                $items = $items . nav_link("/admin/settings", "⚙", "Genel Ayarlar")
                                . nav_link("/admin/themes", "◪", "Tema")
                                . nav_link("/admin/menu", "☰", "Menü");
            }
            if (can("types")) { $items = $items . nav_link("/admin/types", "◲", "Modül Yönetimi"); }
        }
        if ($key == "kullanici") {
            if ($can_users) { $items = $items . nav_link("/admin/users", "◍", "Adminler"); }
            if ($can_roles) { $items = $items . nav_link("/admin/roles", "◈", "Roller"); }
            if ($can_users) { $items = $items . nav_link("/admin/uyeler", "☺", "Üyeler"); }
        }
        if ($items == "") { continue; }
        $h = $h . "<div class=\"grp\">" . html::escape($g["label"]) . "</div>" . $items;
    }
    return $h;
}
// Admin has its OWN UI, independent of the active site theme (views/admin/) — a
// theme ships only public views, so the theme ecosystem stays light.
function admin_view($tpl, $data) {
    $data["csrf_token"] = csrf_token();   // <meta name="csrf"> → auto-injected into admin POST forms (layout.html)
    return template::render("views/admin/" . $tpl, admin_chrome($data));
}

// Render an EXTENSION-owned template (extensions/<ext>/views/<tpl>). Public variant
// injects the site chrome (title/skin); admin variant injects the admin chrome. This
// is how an extension ships its own pages without living in the core view folders.
function ext_view($ext, $tpl, $data) {
    $data["site_title"] = site_title();
    $data["skin"] = active_skin();
    if (!array::contains(array::keys($data), "head_extra")) { $data["head_extra"] = ""; }
    if (!array::contains(array::keys($data), "page_title")) { $data["page_title"] = site_title(); }
    if (!array::contains(array::keys($data), "nav_items")) { $data["nav_items"] = menu_items(conn(), "primary"); }
    $data["csrf"] = csrf_field();   // extension public forms print {!$csrf}
    return template::render("extensions/" . $ext . "/views/" . $tpl, $data);
}
function ext_admin_view($ext, $tpl, $data) {
    $data["csrf_token"] = csrf_token();   // same <meta name="csrf"> auto-injection as admin_view
    return template::render("extensions/" . $ext . "/views/" . $tpl, admin_chrome($data));
}

// ── SEO: per-page meta + Open Graph + JSON-LD (Product schema for priced items) ─
function seo_head($title, $desc, $ogtype, $jsonld) {
    $out = "<meta name=\"description\" content=\"" . html::escape($desc) . "\">";
    $out = $out . "<meta property=\"og:title\" content=\"" . html::escape($title) . "\">";
    $out = $out . "<meta property=\"og:description\" content=\"" . html::escape($desc) . "\">";
    $out = $out . "<meta property=\"og:type\" content=\"" . html::escape($ogtype) . "\">";
    if ($jsonld != "") { $out = $out . "<script type=\"application/ld+json\">" . $jsonld . "</script>"; }
    return $out;
}

// Auth: real users (PBKDF2 via auth::), session-backed. is_admin() = any logged-in
// user may reach the admin; is_super() (role 'admin') gates user management.
function is_admin() { session::start(); return session::get("uid") != null; }
function is_super() { session::start(); return session::get("role") == "admin"; }

// Absolute origin of the current request (proto + host) for sitemap/feed/hreflang.
function base_url() {
    $host = request::header("Host"); if ($host == null) { $host = "localhost"; }
    $proto = request::header("X-Forwarded-Proto"); if ($proto == null) { $proto = "http"; }
    return $proto . "://" . $host;
}
