// src/security.lk — güvenlik tabanı: CSRF, login hız sınırı, güvenlik başlıkları.
// Route YOK — yalnız fonksiyonlar + tek bir before_route middleware'i (route bütçesi
// sıfır). Ürün katmanı: çekirdek stdlib'e dokunmaz, sadece doğrulanmış adları kullanır:
//   request::method/path/ip/post/header · response::status/header/text · stop()
//   session::start/get/set · crypto::random_bytes (hex döner) · cache::get/set/delete
//   string::starts_with/lower/trim · html::escape · type::to_int · env()
use session;
use crypto;
use cache;
use string;
use html;
use type;
use cookie;

// ── CSRF ─────────────────────────────────────────────────────────────────────
// LOOK (v2 dalı): koruma ÇEKİRDEKTE ve varsayılan açık — çerez kullanan her uygulamada her POST/PUT/
// PATCH/DELETE rotadan ve before_route'tan ÖNCE denetlenir (imzalı çift-gönderim çerezi
// look_csrf / __Host-look_csrf, LOOK_SECRET; giriş/çıkışta session::regenerate/destroy yeni
// taban verir). LookPress yalnız anahtarı forma ve <meta>'ya koyar. (1.0.x'te aynı algoritma
// burada saf LOOK ile yazılıydı — lp_csrf çerezi; main dalında duruyor.)
function csrf_token() { return csrf::token(); }
function csrf_field() { return csrf::field(); }

// URL şema izin-listesi (audit LP-03/LP-15): html::escape öznitelikten kaçışı önler ama
// `javascript:` / `data:` şemasını engellemez. Yalnız http(s), mailto, tel, site-içi
// (/ ile başlayan) ve #çapa kabul edilir; diğer her şey "" döner. Render anında
// uygulanır → seed/import/eski kayıt fark etmeksizin güvenli.
function safe_url($u) {
    if ($u == null) { return ""; }
    $s = string::trim("" . $u);
    if ($s == "") { return ""; }
    $l = string::lower($s);
    if (string::starts_with($l, "https://")) { return $s; }
    if (string::starts_with($l, "http://")) { return $s; }
    if (string::starts_with($l, "mailto:")) { return $s; }
    if (string::starts_with($l, "tel:")) { return $s; }
    if (string::starts_with($s, "//")) { return ""; }   // protokol-göreli: dış kaynak, reddet
    if (string::starts_with($s, "/")) { return $s; }
    if (string::starts_with($s, "#")) { return $s; }
    return "";
}
// Genel amaçlı sayaç-limit (audit LP-05/06/08): $bucket için $window saniyede en fazla
// $max istek. true = izin var. cache:: süreç-içi bellektir → çok-süreçli kurulumda
// limit süreç başınadır (sınırlı ama küresel değil); kaba kuvveti yine de keser.
function throttle_hit($bucket, $max, $window) {
    $k = "thr:" . $bucket;
    $n = cache::get($k);
    if ($n == null) { $n = 0; }
    $n = type::to_int($n) + 1;
    cache::set($k, $n, $window);
    return $n <= $max;
}
// Basit e-posta biçim kontrolü (posta göndermeden önce; RFC tam uyumu değil).
function email_looks_valid($e) {
    if ($e == null) { return false; }
    if (string::len($e) > 190) { return false; }
    return string::regex_match($e, "^[^@ \\r\\n]+@[^@ \\r\\n]+\\.[^@ \\r\\n]+$");
}

// ── login hız sınırı (IP + kullanıcı adı başına, cache:: TTL penceresi) ───────
// 5 başarısız deneme / 10 dk. Her başarısızlık TTL'i tazeler → pencere son
// denemeden itibaren kayar. Not: cache:: süreç içi bellektir; çok-süreçli FCGI'de
// sayaç süreç başınadır (yine de üst sınır = 5 × süreç sayısı, sınırsız değil).
function login_max_attempts() { return 5; }
function login_window_sec() { return 600; }
function login_key($username) {
    $ip = request::ip(); if ($ip == null) { $ip = ""; }
    if ($username == null) { $username = ""; }
    return "login:" . $ip . ":" . string::lower(string::trim($username));
}
// Giriş sayaçları VERİTABANINDA tutulur: cache:: süreç-içi olduğu için 4 worker'da
// gerçek sınır 5 değil 20 denemeydi. Tablo süreç başına bir kez (cache bayrağıyla)
// oluşturulur; yalnız başarısız girişte yazılır.
function throttle_db_init($c) {
    if (cache::get("thr:dbinit") != null) { return; }
    db::exec($c, "CREATE TABLE IF NOT EXISTS throttle (bucket VARCHAR(200) PRIMARY KEY, n INTEGER DEFAULT 0, expires INTEGER DEFAULT 0)" . sql_table_opts($c), []);
    cache::set("thr:dbinit", 1, 86400);
}
function throttle_db_count($bucket) {
    $c = conn();
    throttle_db_init($c);
    $r = db::query($c, "SELECT n, expires FROM throttle WHERE bucket = ?", [$bucket]);
    if (count($r) == 0) { return 0; }
    if (type::to_int($r[0]["expires"]) < date::timestamp()) { return 0; }
    return type::to_int($r[0]["n"]);
}
function throttle_db_add($bucket, $window) {
    $c = conn();
    $n = throttle_db_count($bucket) + 1;
    db::exec($c, "DELETE FROM throttle WHERE bucket = ?", [$bucket]);
    db::exec($c, "INSERT INTO throttle (bucket, n, expires) VALUES (?, ?, ?)", [$bucket, $n, date::timestamp() + $window]);
}
// IP genel tavanı: tek bir IP, kullanıcı adı döndürerek sınırsız deneme yapamasın.
function login_ip_key() {
    $ip = request::ip(); if ($ip == null) { $ip = ""; }
    return "login-ip:" . $ip;
}
function login_ip_max() { return 20; }
function login_allowed($key) {
    if (throttle_db_count($key) >= login_max_attempts()) { return false; }
    if (throttle_db_count(login_ip_key()) >= login_ip_max()) { return false; }
    return true;
}
function login_failed($key) {
    throttle_db_add($key, login_window_sec());
    throttle_db_add(login_ip_key(), login_window_sec());
}
// Başarılı girişte sayacı sıfırla (meşru kullanıcı yazım hatalarıyla kilitlenmesin).
function login_reset($key) {
    $c = conn();
    throttle_db_init($c);
    db::exec($c, "DELETE FROM throttle WHERE bucket = ?", [$key]);
}

// ── güvenlik başlıkları ───────────────────────────────────────────────────────
// before_route ile route AYNI WebContext'i paylaşır (http_main.cpp: vm.set_web_context
// (&web) → before_closures → dispatch_routes); response::header burada set edilince
// nihai yanıtta kalır. Route sonradan aynı adı yazarsa onunki kazanır (map).
// HSTS: yalnız gerçek HTTPS'te. Sinyal: LOOK_SESSION_SECURE=1 ya da X-Forwarded-Proto
// https. Başlık sahte olsa bile zararsız — tarayıcı HSTS'i düz HTTP'de yok sayar.
// Ters vekil başlıklarına (X-Forwarded-Proto/-Host) yalnız LOOK_TRUSTED_PROXY ayarlıysa güvenilir —
// LOOK'un kendi oturum çerezi için uyguladığı kural. Eskiden koşulsuz güveniliyordu: herhangi bir
// istek şemayı ya da ana bilgisayarı kendisi seçebiliyordu. (LOOK çekirdeği bağlanan adresin
// listede olup olmadığına da bakar; uygulama kodu o adresi göremediği için burada ayarın varlığı.)
function is_https_request() {
    if (env("LOOK_SESSION_SECURE", "") == "1") { return true; }
    return request::scheme() == "https";   // X-Forwarded-Proto yalnız güvenilen vekilden (çekirdek)
}
function security_headers() {
    response::header("X-Content-Type-Options", "nosniff");
    response::header("X-Frame-Options", "SAMEORIGIN");
    response::header("Referrer-Policy", "strict-origin-when-cross-origin");
    // Muhafazakâr CSP: admin ve tema inline <script>/<style> kullanır → 'unsafe-inline';
    // görseller yerel + data: + herhangi https (içerik editörü dış görsel gömebilir);
    // dış script/font/iframe kaynağı yok (views/ taranarak doğrulandı).
    response::header("Content-Security-Policy",
        "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; "
        . "img-src 'self' data: https:; font-src 'self' data:; connect-src 'self'; "
        . "frame-ancestors 'self'; base-uri 'self'; object-src 'none'");
    if (is_https_request()) {
        response::header("Strict-Transport-Security", "max-age=31536000; includeSubDomains");
    }
}

// ── middleware: her istekte güvenlik başlıkları (CSRF denetimi çekirdekte, bu adımdan önce) ──
before_route(function() {
    security_headers();
});
