// src/security.lk — güvenlik tabanı: CSRF, login hız sınırı, güvenlik başlıkları.
// Route YOK — yalnız fonksiyonlar + tek bir before_route middleware'i (route bütçesi
// sıfır). Ürün katmanı: çekirdek stdlib'e dokunmaz, sadece doğrulanmış adları kullanır:
//   request::method/path/ip/post/header · response::status/header/text · stop()
//   session::start/get/set · crypto::random_bytes (hex döner) · cache::get/set/delete
//   string::starts_with/lower/trim · html::escape · type::to_int · env()
use session;
use crypto;
use cache;
use string;
use html;
use type;
use cookie;

// ── CSRF ─────────────────────────────────────────────────────────────────────
// SUNUCUDA DURUM YOK — imzalı çift-gönderim çerezi (gorilla/csrf, OWASP "signed double-submit").
// Eskiden anahtar OTURUMA yazılıyordu: form gören her ziyaretçi (iletişim, sepet, ödeme) sunucuda
// bir oturum dosyası açıyordu ve çerezsiz istekler, giriş yapmadan, diski doldurabiliyordu
// (ölçüldü: 200 ziyaret → 200 dosya). Şimdi:
//   çerez  lp_csrf = taban . "." . HMAC(LOOK_SECRET, "csrf|" . taban)   (HTTPS'te __Host-lp_csrf)
//   form   _csrf   = nonce . "." . HMAC(taban, nonce)   — her gösterimde farklı (BREACH)
// Doğrulama: çerez imzası LOOK_SECRET ya da LOOK_SECRET_PREVIOUS ile geçerli, gönderilen değerin
// MAC'i tabanla tutar, Origin varsa bu site. Girişte/çıkışta csrf_rotate(): yeni taban — girişten
// önce ele geçirilmiş ya da dayatılmış bir anahtar girişten sonra geçmez. __Host- öneki: alt alan
// adından çerez dayatılamaz. (Oturum kimliğine bağlamak İLK oturum yaratıldığında — sepete ilk
// ekleme — aynı sayfadaki öteki formları bozuyordu.) AYNI ALGORİTMA LOOK 2 çekirdeğindeki csrf::.
$csrf_memo = ["base" => ""];   // bu istekte verilen taban (cookie::get aynı istekte set edileni görmez)

// İmza anahtarları: önce güncel, sonra (varsa) önceki — anahtar değişirken açık formlar 403 almasın.
function csrf_secrets() {
    $cur = env("LOOK_SECRET", "");
    if (string::len("" . $cur) < 32) {
        throw "LOOK_SECRET is not set or shorter than 32 characters. Set it (the same value on every server): CSRF tokens are signed with it.";
    }
    $prev = env("LOOK_SECRET_PREVIOUS", "");
    if ($prev != "") { return [$cur, $prev]; }
    return [$cur];
}
function csrf_cookie_name() {
    if (is_https_request()) { return "__Host-lp_csrf"; }
    return "lp_csrf";
}
function csrf_sign($base, $secret) { return crypto::hmac_sha256("csrf|" . $base, $secret); }
// Çerezdeki taban: imzası verilen anahtarlardan biriyle geçerliyse taban, değilse "".
// $which: 0 = yalnız güncel anahtar, 1 = önceki de olur.
function csrf_cookie_base($which) {
    $c = cookie::get(csrf_cookie_name());
    if ($c == null) { return ""; }
    $p = string::split("" . $c, ".");
    if (count($p) != 2) { return ""; }
    if ($p[0] == "" || $p[1] == "") { return ""; }
    $keys = csrf_secrets();
    $i = 0;
    while ($i < count($keys)) {
        if ($i > $which) { return ""; }
        if (crypto::constant_compare("" . $p[1], csrf_sign($p[0], $keys[$i]))) { return "" . $p[0]; }
        $i = $i + 1;
    }
    return "";
}
function csrf_set_cookie($base) {
    cookie::set(csrf_cookie_name(), $base . "." . csrf_sign($base, csrf_secrets()[0]), ["secure" => is_https_request()]);
    $csrf_memo["base"] = $base;
}
// Bu isteğin tabanı: geçerli çerez varsa o (önceki anahtarla imzalıysa güncel anahtarla yeniden
// imzalanır), yoksa yeni taban + çerez. Bir istekte hep aynı taban.
function csrf_base() {
    if ($csrf_memo["base"] != "") { return $csrf_memo["base"]; }
    $base = csrf_cookie_base(0);
    if ($base != "") { $csrf_memo["base"] = $base; return $base; }
    $base = csrf_cookie_base(1);
    if ($base == "") { $base = crypto::random_bytes(32); }
    csrf_set_cookie($base);
    return $base;
}
// Girişte ve çıkışta (session::regenerate ile birlikte): yeni taban.
function csrf_rotate() { csrf_set_cookie(crypto::random_bytes(32)); }
// Forma/başlığa konan değer: her gösterimde yeni nonce.
function csrf_token() {
    $base = csrf_base();
    $nonce = crypto::random_bytes(16);
    return $nonce . "." . crypto::hmac_sha256($nonce, $base);
}
// Formların içine gömülecek gizli alan (değer html::escape ile kaçırılır).
function csrf_field() {
    return "<input type=\"hidden\" name=\"_csrf\" value=\"" . html::escape(csrf_token()) . "\">";
}
// Origin başlığı varsa bu siteden mi: Host ya da (ters vekil arkasında) X-Forwarded-Host.
function csrf_origin_ok() {
    $o = request::header("Origin");
    if ($o == null || $o == "") { return true; }     // eski tarayıcı / aynı köken GET formu: yalnız anahtar
    if ($o == "null") { return false; }              // opak köken (sandbox, data:) — bu site değil
    $h = string::lower("" . $o);
    $p = string::split($h, "://");
    if (count($p) != 2) { return false; }
    $oh = $p[1];
    $host = request::header("Host");
    if ($host != null) { if ($oh == string::lower("" . $host)) { return true; } }
    $xf = request::header("X-Forwarded-Host");
    if ($xf != null) { if ($oh == string::lower(string::trim(string::split("" . $xf, ",")[0]))) { return true; } }
    return false;
}
// Gönderilen değeri doğrula. Kaynak sırası: POST alanı `_csrf` (klasik form + multipart) →
// `X-CSRF-Token` başlığı (fetch/AJAX yükleyici). Çerez yoksa ya da imzası bozuksa reddet.
function csrf_verify() {
    if (!csrf_origin_ok()) { return false; }
    $base = csrf_cookie_base(1);
    if ($base == "") { return false; }
    $sent = request::post("_csrf");
    if ($sent == null || $sent == "") { $sent = request::header("X-CSRF-Token"); }
    if ($sent == null || $sent == "") { return false; }
    $p = string::split("" . $sent, ".");
    if (count($p) != 2) { return false; }
    if ($p[0] == "") { return false; }
    return crypto::constant_compare("" . $p[1], crypto::hmac_sha256($p[0], $base));
}

// Bu POST yolu CSRF doğrulaması ister mi? Kapsam: /admin/* (login hariç — oturum
// henüz yok, token da yok; login'i login hız sınırı korur) + herkese açık form
// gönderimi /forms/{key}. /admin/media/upload MUAF DEĞİL: yükleyici fetch'i
// `_csrf` alanını FormData'ya ekler + X-CSRF-Token başlığı gönderir (layout.html).
// URL şema izin-listesi (audit LP-03/LP-15): html::escape öznitelikten kaçışı önler ama
// `javascript:` / `data:` şemasını engellemez. Yalnız http(s), mailto, tel, site-içi
// (/ ile başlayan) ve #çapa kabul edilir; diğer her şey "" döner. Render anında
// uygulanır → seed/import/eski kayıt fark etmeksizin güvenli.
function safe_url($u) {
    if ($u == null) { return ""; }
    $s = string::trim("" . $u);
    if ($s == "") { return ""; }
    $l = string::lower($s);
    if (string::starts_with($l, "https://")) { return $s; }
    if (string::starts_with($l, "http://")) { return $s; }
    if (string::starts_with($l, "mailto:")) { return $s; }
    if (string::starts_with($l, "tel:")) { return $s; }
    if (string::starts_with($s, "//")) { return ""; }   // protokol-göreli: dış kaynak, reddet
    if (string::starts_with($s, "/")) { return $s; }
    if (string::starts_with($s, "#")) { return $s; }
    return "";
}
// Genel amaçlı sayaç-limit (audit LP-05/06/08): $bucket için $window saniyede en fazla
// $max istek. true = izin var. cache:: süreç-içi bellektir → çok-süreçli kurulumda
// limit süreç başınadır (sınırlı ama küresel değil); kaba kuvveti yine de keser.
function throttle_hit($bucket, $max, $window) {
    $k = "thr:" . $bucket;
    $n = cache::get($k);
    if ($n == null) { $n = 0; }
    $n = type::to_int($n) + 1;
    cache::set($k, $n, $window);
    return $n <= $max;
}
// Basit e-posta biçim kontrolü (posta göndermeden önce; RFC tam uyumu değil).
function email_looks_valid($e) {
    if ($e == null) { return false; }
    if (string::len($e) > 190) { return false; }
    return string::regex_match($e, "^[^@ \\r\\n]+@[^@ \\r\\n]+\\.[^@ \\r\\n]+$");
}
function csrf_required($path) {
    if ($path == "/admin/login") { return false; }
    if (string::starts_with($path, "/admin/")) { return true; }
    if (string::starts_with($path, "/forms/")) { return true; }
    // extension public POSTs — their forms carry {!$csrf} (csrf_field_safe)
    if (string::starts_with($path, "/cart/")) { return true; }
    if ($path == "/checkout") { return true; }
    if (string::starts_with($path, "/hesap/")) { return true; }
    return false;
}

// ── login hız sınırı (IP + kullanıcı adı başına, cache:: TTL penceresi) ───────
// 5 başarısız deneme / 10 dk. Her başarısızlık TTL'i tazeler → pencere son
// denemeden itibaren kayar. Not: cache:: süreç içi bellektir; çok-süreçli FCGI'de
// sayaç süreç başınadır (yine de üst sınır = 5 × süreç sayısı, sınırsız değil).
function login_max_attempts() { return 5; }
function login_window_sec() { return 600; }
function login_key($username) {
    $ip = request::ip(); if ($ip == null) { $ip = ""; }
    if ($username == null) { $username = ""; }
    return "login:" . $ip . ":" . string::lower(string::trim($username));
}
// Giriş sayaçları VERİTABANINDA tutulur: cache:: süreç-içi olduğu için 4 worker'da
// gerçek sınır 5 değil 20 denemeydi. Tablo süreç başına bir kez (cache bayrağıyla)
// oluşturulur; yalnız başarısız girişte yazılır.
function throttle_db_init($c) {
    if (cache::get("thr:dbinit") != null) { return; }
    db::exec($c, "CREATE TABLE IF NOT EXISTS throttle (bucket VARCHAR(200) PRIMARY KEY, n INTEGER DEFAULT 0, expires INTEGER DEFAULT 0)" . sql_table_opts($c), []);
    cache::set("thr:dbinit", 1, 86400);
}
function throttle_db_count($bucket) {
    $c = conn();
    throttle_db_init($c);
    $r = db::query($c, "SELECT n, expires FROM throttle WHERE bucket = ?", [$bucket]);
    if (count($r) == 0) { return 0; }
    if (type::to_int($r[0]["expires"]) < date::timestamp()) { return 0; }
    return type::to_int($r[0]["n"]);
}
function throttle_db_add($bucket, $window) {
    $c = conn();
    $n = throttle_db_count($bucket) + 1;
    db::exec($c, "DELETE FROM throttle WHERE bucket = ?", [$bucket]);
    db::exec($c, "INSERT INTO throttle (bucket, n, expires) VALUES (?, ?, ?)", [$bucket, $n, date::timestamp() + $window]);
}
// IP genel tavanı: tek bir IP, kullanıcı adı döndürerek sınırsız deneme yapamasın.
function login_ip_key() {
    $ip = request::ip(); if ($ip == null) { $ip = ""; }
    return "login-ip:" . $ip;
}
function login_ip_max() { return 20; }
function login_allowed($key) {
    if (throttle_db_count($key) >= login_max_attempts()) { return false; }
    if (throttle_db_count(login_ip_key()) >= login_ip_max()) { return false; }
    return true;
}
function login_failed($key) {
    throttle_db_add($key, login_window_sec());
    throttle_db_add(login_ip_key(), login_window_sec());
}
// Başarılı girişte sayacı sıfırla (meşru kullanıcı yazım hatalarıyla kilitlenmesin).
function login_reset($key) {
    $c = conn();
    throttle_db_init($c);
    db::exec($c, "DELETE FROM throttle WHERE bucket = ?", [$key]);
}

// ── güvenlik başlıkları ───────────────────────────────────────────────────────
// before_route ile route AYNI WebContext'i paylaşır (http_main.cpp: vm.set_web_context
// (&web) → before_closures → dispatch_routes); response::header burada set edilince
// nihai yanıtta kalır. Route sonradan aynı adı yazarsa onunki kazanır (map).
// HSTS: yalnız gerçek HTTPS'te. Sinyal: LOOK_SESSION_SECURE=1 ya da X-Forwarded-Proto
// https. Başlık sahte olsa bile zararsız — tarayıcı HSTS'i düz HTTP'de yok sayar.
function is_https_request() {
    if (env("LOOK_SESSION_SECURE", "") == "1") { return true; }
    $xf = request::header("X-Forwarded-Proto");
    if ($xf == null) { return false; }
    return string::starts_with(string::lower(string::trim($xf)), "https");
}
function security_headers() {
    response::header("X-Content-Type-Options", "nosniff");
    response::header("X-Frame-Options", "SAMEORIGIN");
    response::header("Referrer-Policy", "strict-origin-when-cross-origin");
    // Muhafazakâr CSP: admin ve tema inline <script>/<style> kullanır → 'unsafe-inline';
    // görseller yerel + data: + herhangi https (içerik editörü dış görsel gömebilir);
    // dış script/font/iframe kaynağı yok (views/ taranarak doğrulandı).
    response::header("Content-Security-Policy",
        "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; "
        . "img-src 'self' data: https:; font-src 'self' data:; connect-src 'self'; "
        . "frame-ancestors 'self'; base-uri 'self'; object-src 'none'");
    if (is_https_request()) {
        response::header("Strict-Transport-Security", "max-age=31536000; includeSubDomains");
    }
}

// ── middleware: her istekte başlıklar; kapsamlı POST'larda CSRF ───────────────
before_route(function() {
    security_headers();
    if (request::method() != "POST") { return; }
    if (!csrf_required(request::path())) { return; }
    if (csrf_verify()) { return; }
    response::status(403);
    response::text("Forbidden: missing or invalid CSRF token. Reload the form and try again.");
    stop();
});
