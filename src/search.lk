// src/search.lk — site içi arama.
//
// Tek yol, her veritabanında aynı: yayımlanmış revizyonun katlanmış metni
// (revisions.search_norm) üzerinde kelime başına `LIKE ? ESCAPE '!'`. Metin ve sorgu
// AYNI Türkçe katlama fonksiyonundan geçer (src/search_text.lk): "tisort" → "Tişörtler",
// "kirmizi" → "Kırmızı", "isik"/"ışık" → "IŞIK". Kullanıcının %, _ karakterleri harf
// olarak aranır, joker değildir.
//
// Neden revizyonda: bir revizyon yazıldıktan sonra değişmez, arama da yayımlanmış
// revizyona bakar — taslak düzenleme ya da zamanlanmış yayın indeksi bayatlatamaz.
// search_norm'u boş kalan revizyonlar (kurulumdan önceki içerik, kolonu doldurmayan bir
// yazma yolu) her sorguda search_backfill ile doldurulur.
//
// (Önceki "FTS5 varsa" modu kaldırıldı: LOOK'un SQLite'ında FTS5 yok, o yol hiç çalışmamıştı;
// ayrıca SQLite ile MySQL/PostgreSQL'de iki ayrı arama davranışı demekti.)
//
// XSS: özet LOOK'ta üretilir; parçalar html::escape'ten geçer, <mark> bizimdir.
use db;
use array;
use type;
use string;
use html;
use date;
use "search_text.lk";

// save_content sonunda çağrılır (src/types.lk): içeriğin son revizyonunun aranacak metni.
// Kaçırılsa da sorun olmaz — boş kalan kolon aramada doldurulur.
function search_index_content($c, $id) {
    $rows = db::query($c, "SELECT r.id, r.title, r.body_html, r.fields_json FROM content c JOIN revisions r ON r.id = c.current_rev WHERE c.id = ?", [$id]);
    if (count($rows) == 0) { return; }
    $r = $rows[0];
    db::exec($c, "UPDATE revisions SET search_norm = ? WHERE id = ?", [search_norm_of($r["title"], $r["body_html"], $r["fields_json"]), $r["id"]]);
}

// Sonuç satırı → şablon öğesi. url = lang_prefix + url_pattern({slug}); modül etiketi
// config plural; tarih d.m.Y.
function search_item($r, $lang, $snippet_html) {
    $cfg = type_config_decode($r["type"], $r["label"], $r["config_json"]);
    $ts = $r["updated_at"]; $d = "";
    if ($ts != null && type::to_int($ts) > 0) { $d = date::format(type::to_int($ts), "d.m.Y"); }
    return ["title" => $r["title"], "url" => lang_prefix($lang) . string::replace($r["url_pattern"], "{slug}", $r["slug"]),
            "module_label" => $cfg["plural"], "snippet_html" => $snippet_html, "has_snippet" => ($snippet_html != ""),
            "date" => $d, "has_date" => ($d != "")];
}
// Özet: aranan ilk kelimenin ilk eşleşmesi çevresinden ~160 karakter, eşleşme <mark> içinde.
// Eşleşme katlanmış metinde aranır ("tisort" "Tişört"ü bulur), parçalar özgün metinden kesilir.
// Katlama her harfi tek harfe çevirdiği için iki metnin kod-noktası konumları aynıdır; uzunluklar
// tutmazsa (beklenmeyen bir harf) vurgu yapılmaz, baştan özet verilir.
function search_like_excerpt($plain, $q) {
    if ($plain == "") { return ""; }
    $w = ""; foreach (string::split(string::trim($q), " ") as $p) { if ($w == "" && string::trim($p) != "") { $w = string::trim($p); } }
    $lp = search_fold($plain); $lq = search_fold($w);
    $i = -1;
    // string::index_of BAYT ofseti, string::substr KOD-NOKTASI ofseti kullanır; Türkçe
    // metinde ikisini karıştırmak vurguyu kaydırır. Eşleşmeden önceki parçanın kod-noktası
    // uzunluğu doğru indekstir.
    if ($lq != "" && string::len($lp) == string::len($plain)) {
        $sp = string::split($lp, $lq);
        if (count($sp) > 1) { $i = string::len($sp[0]); }
    }
    if ($i < 0) {
        $s = string::substr($plain, 0, 160);
        if (string::len($plain) > 160) { $s = $s . "…"; }
        return html::escape($s);
    }
    $ql = string::len($lq);
    $start = $i - 60; if ($start < 0) { $start = 0; }
    $pre = ""; if ($start > 0) { $pre = "…"; }
    $before = string::substr($plain, $start, $i - $start);
    $match = string::substr($plain, $i, $ql);
    $after = string::substr($plain, $i + $ql, 100);
    $post = ""; if (string::len($plain) > $i + $ql + 100) { $post = "…"; }
    return $pre . html::escape($before) . "<mark>" . html::escape($match) . "</mark>" . html::escape($after) . $post;
}
// Ana giriş: {items}. q < 2 karakter → boş liste (rota dostça mesaj basar).
function search_query($c, $q, $lang) {
    $items = [];
    $q = string::trim($q);
    if (string::len($q) < 2) { return ["items" => $items]; }
    $pats = search_like_patterns($q);
    if (count($pats) == 0) { return ["items" => $items]; }
    search_backfill($c, 500);
    $sql = "SELECT c.type, c.slug, c.updated_at, r.title, r.body_html, r.fields_json, ct.url_pattern, ct.label, ct.config_json FROM content c JOIN revisions r ON r.id = c.published_rev JOIN content_types ct ON ct.slug = c.type WHERE c.published_rev > 0 AND c.lang = ? AND ct.url_pattern != ''";
    $params = [$lang];
    foreach ($pats as $p) {
        $sql = $sql . " AND r.search_norm LIKE ? ESCAPE '!'";
        $params = array::push($params, $p);
    }
    $rows = db::query($c, $sql . " ORDER BY c.updated_at DESC, c.id DESC LIMIT 50", $params);
    foreach ($rows as $r) {
        $plain = search_plain_text($r["body_html"], $r["fields_json"]);
        $items = array::push($items, search_item($r, $lang, search_like_excerpt($plain, $q)));
    }
    return ["items" => $items];
}
