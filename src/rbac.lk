// src/rbac.lk — role-based access control. Roles live in the DB (roles table:
// name, label, perms JSON, is_system); a user carries a role name. The 'admin' role
// is a superuser (every permission). can($perm) is the single gate the routes call.
//
// Permission catalog = core (config::cfg_permissions) + extension-contributed
// (xp_permissions, e.g. commerce → orders/coupons). Roles are edited in /admin/roles.
use db;
use session;
use json;
use array;
use html;
use string;

// The full permission catalog (core + extensions), each ["key","label"].
function all_permissions() {
    $p = cfg_permissions();
    foreach (xp_permissions() as $x) { $p = array::push($p, $x); }
    return $p;
}

// Does the current (logged-in) user hold $perm? admin role = always yes.
// Oturumdaki kullanıcının GÜNCEL rolü veritabanından okunur. Rol oturumda saklanınca
// yetki düşürme ve kullanıcı silme mevcut oturumları etkilemiyordu (oturum bitene
// kadar eski yetkiler geçerliydi). 2 sn'lik önbellek istek içi tekrarları karşılar;
// rol değişince/silinince role_cache_bust ile hemen düşürülür. "" = kullanıcı yok.
function current_role() {
    session::start();
    $uid = session::get("uid");
    if ($uid == null || "" . $uid == "") { return ""; }
    $k = "urole:" . $uid;
    $r = cache::get($k);
    if ($r != null) { return "" . $r; }
    $rows = db::query(conn(), "SELECT role FROM users WHERE id = ?", [type::to_int($uid)]);
    $role = "";
    if (count($rows) == 1) { $role = "" . $rows[0]["role"]; }
    if ($role != "") { cache::set($k, $role, 2); }
    return $role;
}
function role_cache_bust($uid) { cache::delete("urole:" . $uid); }
function can($perm) {
    session::start();
    if (session::get("uid") == null) { return false; }
    $role = current_role();
    if ($role == "") { return false; }
    if ($role == "admin") { return true; }               // superuser
    $rows = db::query(conn(), "SELECT perms FROM roles WHERE name = ?", [$role]);
    if (count($rows) == 0) { return false; }
    $perms = json::decode($rows[0]["perms"]);
    if ($perms == null) { return false; }
    return array::contains($perms, $perm);
}

// The roles available to assign (for the user + role admin UIs).
function all_roles($c) { return db::query($c, "SELECT id, name, label, perms, is_system FROM roles ORDER BY is_system DESC, label", []); }

// Read submitted perm_<key> checkboxes into a perms list (role create/edit forms).
function collect_perms() {
    $out = [];
    foreach (all_permissions() as $p) {
        if (request::post("perm_" . $p["key"]) == "1") { $out = array::push($out, $p["key"]); }
    }
    return $out;
}
