// src/types.lk — the type engine. Define a type in content_types and this drives
// its admin form, server-side validation, and versioned-core write. No per-type
// code: one generic set of helpers reads each type's declared field definitions.
use db;
use cache;
use array;
use json;
use type;
use string;
use html;
use date;
use "../lib/markdown.lk";

// ── dispatcher type-pattern cache ────────────────────────────────────────────
// The request-time dispatcher resolves url_pattern -> type slug on EVERY public hit.
// content_types changes rarely, so cache the whole (small) pattern->slug map for 60s
// under ONE key. BUSTED on any content_types write (types_cache_bust) so a NEW type's
// URL is live immediately — without the bust the new URL would lag up to the 60s TTL.
function type_patterns($c) {
    $m = cache::get("cms:type_patterns");
    if ($m != null) { return $m; }
    $m = array::new_assoc();
    $rows = db::query($c, "SELECT slug, url_pattern FROM content_types", []);
    foreach ($rows as $r) { $m = array::set($m, $r["url_pattern"], $r["slug"]); }
    cache::set("cms:type_patterns", $m, 60);
    return $m;
}
function type_for_pattern($c, $pattern) {
    $m = type_patterns($c);
    if (array::contains(array::keys($m), $pattern)) { return $m[$pattern]; }
    return "";
}
function types_cache_bust() { cache::delete("cms:type_patterns"); }
// Any type whose url_pattern is "/BASE/{slug}" is browsable as a listing at /BASE
// (e.g. product -> /product, post -> /blog). Generic: no per-type listing code.
function type_for_base($c, $base) { return type_for_pattern($c, $base . "/{slug}"); }

// ── type engine: load a type + its field defs ───────────────────────────────
function load_type($c, $slug) {
    $rows = db::query($c, "SELECT slug, label, url_pattern, fields_json FROM content_types WHERE slug = ?", [$slug]);
    if (count($rows) == 0) { return null; }
    $t = $rows[0];
    $t["fields"] = json::decode($t["fields_json"]);
    return $t;
}

// Render one field's input HTML from its definition (+ current value).
function field_input($c, $f, $value) {
    $name = $f["name"];
    $t = $f["type"];
    $v = html::escape($value);
    if ($t == "markdown" || $t == "textarea") {
        return "<label>" . $name . "<textarea name=\"" . $name . "\" rows=\"10\">" . $v . "</textarea></label>";
    }
    if ($t == "bool") {
        $chk = ""; if ($value == "1" || $value == "true") { $chk = " checked"; }
        return "<label class=\"cb\"><input type=\"checkbox\" name=\"" . $name . "\" value=\"1\"" . $chk . "> " . $name . "</label>";
    }
    if ($t == "int" || $t == "decimal") {
        return "<label>" . $name . "<input type=\"number\" name=\"" . $name . "\" value=\"" . $v . "\"></label>";
    }
    if ($t == "date") {
        return "<label>" . $name . "<input type=\"date\" name=\"" . $name . "\" value=\"" . $v . "\"></label>";
    }
    if ($t == "url") {
        return "<label>" . $name . "<input type=\"url\" name=\"" . $name . "\" value=\"" . $v . "\"></label>";
    }
    if ($t == "email") {
        return "<label>" . $name . "<input type=\"email\" name=\"" . $name . "\" value=\"" . $v . "\"></label>";
    }
    if ($t == "number") {
        // opsiyonel min/max alan tanımında taşınıyorsa <input>'a yansıt
        $mm = "";
        try { if ($f["min"] != null && $f["min"] != "") { $mm = $mm . " min=\"" . html::escape($f["min"]) . "\""; } } catch ($e) { $mm = $mm; }
        try { if ($f["max"] != null && $f["max"] != "") { $mm = $mm . " max=\"" . html::escape($f["max"]) . "\""; } } catch ($e) { $mm = $mm; }
        return "<label>" . $name . "<input type=\"number\" name=\"" . $name . "\" value=\"" . $v . "\"" . $mm . "></label>";
    }
    if ($t == "color") {
        return "<label>" . $name . "<input type=\"color\" name=\"" . $name . "\" value=\"" . $v . "\"></label>";
    }
    if ($t == "tel") {
        return "<label>" . $name . "<input type=\"tel\" name=\"" . $name . "\" value=\"" . $v . "\"></label>";
    }
    if ($t == "blocks") {
        // Visual block editor: a hidden textarea holds the block list as JSON; the JS in
        // layout.html (.block-editor) renders the add/reorder/edit UI and serializes back
        // into it on change (same JSON-in-textarea pattern as the .field-builder).
        return "<div class=\"field-block\"><span class=\"fb-label\">" . $name . "</span><div class=\"block-editor\" data-field=\"" . $name . "\"><textarea name=\"" . $name . "\" class=\"blocks-json\" hidden>" . $v . "</textarea></div></div>";
    }
    if ($t == "image" || $name == "image") {
        // Media field: a URL input + live preview + a "pick from library / upload" button
        // wired to the admin media picker (see the modal + JS in views/admin/layout.html).
        $prev = "";
        if ($value != "") { $prev = "<img src=\"" . $v . "\" alt=\"\" class=\"mf-preview\">"; }
        return "<label>" . $name
             . "<div class=\"media-field\">"
             . "<div class=\"mf-prev\">" . $prev . "</div>"
             . "<div class=\"mf-row\"><input type=\"text\" name=\"" . $name . "\" value=\"" . $v . "\" class=\"mf-url\" placeholder=\"/media/… veya bir URL\">"
             . "<button type=\"button\" class=\"btn mf-pick\">Görsel seç</button></div>"
             . "</div></label>";
    }
    if ($t == "select") {
        $opts = "";
        foreach ($f["choices"] as $ch) {
            $sel = ""; if ($ch == $value) { $sel = " selected"; }
            $opts = $opts . "<option value=\"" . html::escape($ch) . "\"" . $sel . ">" . html::escape($ch) . "</option>";
        }
        return "<label>" . $name . "<select name=\"" . $name . "\">" . $opts . "</select></label>";
    }
    if ($t == "relation") {
        // single-select of existing content of the target type (multi-select + picker → Faz 6)
        $target = $f["to"];
        $rows = db::query($c, "SELECT c.id, r.title FROM content c JOIN revisions r ON r.id = c.current_rev WHERE c.type = ? ORDER BY r.title", [$target]);
        $opts = "<option value=\"\">—</option>";
        foreach ($rows as $row) {
            $sel = ""; if (type::to_int($value) == type::to_int($row["id"])) { $sel = " selected"; }
            $opts = $opts . "<option value=\"" . $row["id"] . "\"" . $sel . ">" . html::escape($row["title"]) . "</option>";
        }
        return "<label>" . $name . " (" . $target . ")<select name=\"" . $name . "\">" . $opts . "</select></label>";
    }
    // extension-provided field type (commerce → "category")? else plain text.
    $x = xp_field_input($c, $f, $value);
    if ($x != "") { return $x; }
    return "<label>" . $name . "<input name=\"" . $name . "\" value=\"" . $v . "\"></label>";
}

function fields_form_html($c, $fields, $values) {
    $h = "";
    foreach ($fields as $f) {
        $val = "";
        if ($values != null) { $val = $values[$f["name"]]; }
        $h = $h . field_input($c, $f, $val);
    }
    return $h;
}

// Server-side validation — form HTML is NOT security. Returns [errors[], values{}].
function validate_post($c, $fields) {
    $errors = [];
    $values = [];
    foreach ($fields as $f) {
        $name = $f["name"];
        $t = $f["type"];
        $raw = request::post($name);
        if ($t == "bool") {
            $bv = "0"; if ($raw == "1") { $bv = "1"; }
            $values = array::set($values, $name, $bv);
        } else {
            if ($raw == null) { $raw = ""; }
            $raw = string::trim($raw);
            $req = $f["required"];
            if ($req && $raw == "") { $errors = array::push($errors, $name . " is required"); }
            if ($t == "int" && $raw != "" && !string::regex_match($raw, "^-?[0-9]+$")) { $errors = array::push($errors, $name . " must be an integer"); }
            if ($t == "decimal" && $raw != "" && !string::regex_match($raw, "^-?[0-9]+(\\.[0-9]+)?$")) { $errors = array::push($errors, $name . " must be a number"); }
            if ($t == "url" && $raw != "" && !string::regex_match($raw, "^https?://[^ ]+$")) { $errors = array::push($errors, $name . " must be a valid URL (http:// or https://)"); }
            if ($t == "email" && $raw != "" && !string::regex_match($raw, "^[^@ ]+@[^@ ]+\\.[^@ ]+$")) { $errors = array::push($errors, $name . " must be a valid email address"); }
            if ($t == "color" && $raw != "" && !string::regex_match($raw, "^#[0-9a-fA-F]{6}$")) { $errors = array::push($errors, $name . " must be a hex color (#rrggbb)"); }
            if ($t == "tel" && $raw != "" && !string::regex_match($raw, "^[0-9 +()\\-]+$")) { $errors = array::push($errors, $name . " must be a valid phone number"); }
            if ($t == "number" && $raw != "") {
                if (!string::regex_match($raw, "^-?[0-9]+(\\.[0-9]+)?$")) {
                    $errors = array::push($errors, $name . " must be a number");
                } else {
                    // opsiyonel min/max alan tanımında taşınıyorsa sınırları uygula
                    $nv = type::to_float($raw);
                    $has_min = false; $minv = 0.0;
                    try { if ($f["min"] != null && $f["min"] != "") { $has_min = true; $minv = type::to_float($f["min"]); } } catch ($e) { $has_min = false; }
                    if ($has_min && $nv < $minv) { $errors = array::push($errors, $name . " must be >= " . $f["min"]); }
                    $has_max = false; $maxv = 0.0;
                    try { if ($f["max"] != null && $f["max"] != "") { $has_max = true; $maxv = type::to_float($f["max"]); } } catch ($e) { $has_max = false; }
                    if ($has_max && $nv > $maxv) { $errors = array::push($errors, $name . " must be <= " . $f["max"]); }
                }
            }
            if ($t == "select" && $raw != "") {
                $ok = false; foreach ($f["choices"] as $ch) { if ($ch == $raw) { $ok = true; } }
                if (!$ok) { $errors = array::push($errors, $name . " is not an allowed choice"); }
            }
            if ($t == "relation" && $raw != "") {
                $ex = db::query($c, "SELECT id FROM content WHERE id = ? AND type = ?", [type::to_int($raw), $f["to"]]);
                if (count($ex) == 0) { $errors = array::push($errors, $name . ": invalid relation target " . $raw); }
            }
            $values = array::set($values, $name, $raw);
        }
    }
    return ["errors" => $errors, "values" => $values];
}

// A slug is unique per (lang, type); reject a collision gracefully instead of
// letting the UNIQUE constraint 500 the edit form.
function norm_lang($l) { if ($l == "en") { return "en"; } return "tr"; }
function slug_taken($c, $type, $slug, $exclude_id, $lang) {
    return count(db::query($c, "SELECT id FROM content WHERE type = ? AND slug = ? AND lang = ? AND id != ?", [$type, $slug, $lang, $exclude_id])) > 0;
}

// ── versioned-core write: create/update content as a new revision ────────────
// Merge the optional per-item SEO fields (posted alongside the type's own fields)
// into the stored values. They live in fields_json under reserved keys and are NOT
// declared type fields, so they never render as visible content rows.
function with_seo($values) {
    $st = request::post("seo_title"); if ($st == null) { $st = ""; }
    $sd = request::post("seo_desc");  if ($sd == null) { $sd = ""; }
    $values = array::set($values, "seo_title", string::trim($st));
    $values = array::set($values, "seo_desc", string::trim($sd));
    return $values;
}
function save_content($c, $type, $id, $slug, $values, $status, $lang) {
    // title/body are the two "well-known" revision columns, but a content type need
    // NOT declare them (e.g. a business-card / event / spec type with only custom
    // fields). Missing → "" so the NOT NULL revision columns still get a value and a
    // body-less type saves cleanly (its data lives in fields_json regardless).
    $title = ""; try { if ($values["title"] != null) { $title = $values["title"]; } } catch ($e) { $title = ""; }
    $body_md = ""; try { if ($values["body"] != null) { $body_md = $values["body"]; } } catch ($e) { $body_md = ""; }
    $body_html = markdown_to_html($body_md);
    $fields_json = json::encode($values);
    $ts = date::timestamp();
    if ($id == 0) {
        db::exec($c, "INSERT INTO content (type, slug, lang, status, created_at, updated_at) VALUES (?, ?, ?, ?, ?, ?)", [$type, $slug, $lang, $status, $ts, $ts]);
        $id = db::last_id($c);
    } else {
        db::exec($c, "UPDATE content SET slug = ?, lang = ?, status = ?, updated_at = ? WHERE id = ?", [$slug, $lang, $status, $ts, $id]);
    }
    // rev_no = max+1
    $mx = db::query($c, "SELECT COALESCE(MAX(rev_no),0) AS m FROM revisions WHERE content_id = ?", [$id]);
    $rev_no = type::to_int($mx[0]["m"]) + 1;
    db::exec($c, "INSERT INTO revisions (content_id, rev_no, title, body_md, body_html, fields_json, author_id, created_at, note) VALUES (?, ?, ?, ?, ?, ?, 0, ?, 'admin edit')", [$id, $rev_no, $title, $body_md, $body_html, $fields_json, $ts]);
    $rid = db::last_id($c);
    // Scheduled publishing: a future publish_at holds the item back (published_rev
    // stays 0 → not publicly visible) until activate_scheduled flips it when due.
    // Empty/past/invalid schedule = publish now. Draft never schedules.
    $sched = parse_schedule(request::post("publish_at"));
    $prev = 0;
    $pub_at = null;
    if ($status == "published") {
        if ($sched != "" && $sched > date::now()) {
            $prev = 0;          // scheduled — not live yet
            $pub_at = $sched;
        } else {
            $prev = $rid;       // live now
        }
    }
    db::exec($c, "UPDATE content SET current_rev = ?, published_rev = ?, publish_at = ? WHERE id = ?", [$rid, $prev, $pub_at, $id]);
    return $id;
}
