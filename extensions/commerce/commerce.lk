// extensions/commerce/commerce.lk — the commerce extension. Everything about carts,
// checkout, orders and coupons lives here: storefront routes, admin routes, its own
// schema + demo seed, and the hooks that weave it into the core UI (add-to-cart on a
// product page, Product JSON-LD, dashboard stats/panels, admin nav). The core never
// names commerce — it exposes generic seams (src/hooks.lk) and this extension fills them.
//
// Loaded once by app.lk (runtime) and by setup_v2.lk (migrate/seed). It relies only on
// the core's public helpers (view/ext_view/admin gates/config/hooks) — never core internals.
// hook_add / ext_view / core helpers come from files the composition root (app.lk)
// loads before this one; commerce touches no core file by relative path.
use db;
use session;
use string;
use json;
use html;
use type;
use array;
use date;

// CSRF alanı: csrf_field() çekirdeğe başka bir dilimle geliyor; henüz tanımlı değilse
// boş dize (tanımsız fonksiyon çağrısı yakalanabilir bir hata fırlatır — lk ile doğrulandı).
function csrf_field_safe() { try { return csrf_field(); } catch ($e) { return ""; } }

// ── ürün varyant / özellik / marka yardımcıları ───────────────────────────────
// Bir map'ten string değer oku; anahtar yoksa/null ise varsayılan. (json::decode map'i
// olmayan anahtarda null döner, throw etmez; liste-literal'de de aynı — ikisini de kapsar.)
function cm_str($m, $k, $d) {
    if ($m == null) { return $d; }
    $v = null; try { $v = $m[$k]; } catch ($e) { $v = null; }
    if ($v == null) { return $d; }
    return "" . $v;
}
// POST alanı: yoksa "" (trim'li).
function cm_post($k) { $v = request::post($k); if ($v == null) { return ""; } return string::trim($v); }
// fields_json içindeki bir alanı JSON LİSTE olarak çöz; yoksa/bozuksa boş liste.
function product_json_list($vals, $key) {
    $raw = cm_str($vals, $key, "");
    if ($raw == "") { return []; }
    $lst = json::decode($raw);
    if ($lst == null) { return []; }
    // Sadece map satırları kabul et (bozuk/elle yazılmış JSON'da string satır gelebilir).
    $out = [];
    foreach ($lst as $row) {
        $ok = true; try { $t = $row["__probe"]; } catch ($e) { $ok = false; }
        if ($ok) { $out = array::push($out, $row); }
    }
    return $out;
}
// Varyant satırı şekli: {"ad":"S","sku":"TS-S","fiyat":"249.90","stok":"10"} (fiyat/stok boş = ürün fiyatı / sınırsız)
function product_variants($vals) { return product_json_list($vals, "varyantlar"); }
// Özellik satırı şekli: {"k":"Renk","v":"Kırmızı"}
function product_attributes($vals) { return product_json_list($vals, "ozellikler"); }
function variant_find($variants, $sku) {
    if ($sku == "") { return null; }
    foreach ($variants as $v) { if (cm_str($v, "sku", "") == $sku) { return $v; } }
    return null;
}
// Sepet satırı = ürün slug + varyant sku ("" = varyantsız ürün; eski satırlarda anahtar yok → "").
function cart_line_variant($it) { return cm_str($it, "variant", ""); }
function cart_line_is($it, $slug, $sku) { return ($it["slug"] == $slug && cart_line_variant($it) == $sku); }
// Yayınlanmış ürün satırları (TÜM diller — aynı slug aynı fiziksel ürün; stok düşümü hepsine uygulanır).
function product_published_rows($c, $slug) {
    return db::query($c, "SELECT c.id AS cid, c.published_rev AS rid, r.title, r.fields_json FROM content c JOIN revisions r ON r.id = c.published_rev WHERE c.type = 'product' AND c.slug = ? AND c.published_rev > 0", [$slug]);
}
// Bir varyantın stoğu (stok tanımsız/boş → -1 = sınırsız).
function variant_stock($variant) {
    $stok = cm_str($variant, "stok", "");
    if ($stok == "") { return -1; }
    return type::to_int($stok);
}
// Sepet satırı için mevcut stok: varyantsız → -1 (sınırsız); varyant bulunamazsa 0.
function cart_line_stock($c, $slug, $sku) {
    if ($sku == "") { return -1; }
    $rows = product_published_rows($c, $slug);
    if (count($rows) == 0) { return 0; }
    $v = variant_find(product_variants(json::decode($rows[0]["fields_json"])), $sku);
    if ($v == null) { return 0; }
    return variant_stock($v);
}
// Varyant stoğunu düş (stok boşsa sınırsız → dokunma). Yayınlanmış revizyonun fields_json'ı
// yerinde güncellenir (stok = canlı veri, içerik sürümü değil). Tabloya ASLA yeni sütun/satır yok.
function variant_stock_decrement($c, $slug, $sku, $qty) {
    if ($sku == "") { return; }
    foreach (product_published_rows($c, $slug) as $row) {
        $vals = json::decode($row["fields_json"]);
        if ($vals == null) { continue; }
        $variants = product_variants($vals);
        if (count($variants) == 0) { continue; }
        $new = []; $changed = false;
        foreach ($variants as $v) {
            if (cm_str($v, "sku", "") == $sku && cm_str($v, "stok", "") != "") {
                $n = type::to_int(cm_str($v, "stok", "0")) - $qty;
                if ($n < 0) { $n = 0; }
                $v["stok"] = "" . $n; $changed = true;
            }
            $new = array::push($new, $v);
        }
        if ($changed) {
            $vals["varyantlar"] = json::encode($new);
            db::exec($c, "UPDATE revisions SET fields_json = ? WHERE id = ?", [json::encode($vals), $row["rid"]]);
        }
    }
}
// Sepet uyarısı (tek seferlik, session'da): stok yok / varyant seçilmedi.
function cart_msg_set($m) { session::start(); session::set("cart_msg", $m); }
function cart_msg_take() {
    session::start();
    $m = session::get("cart_msg"); if ($m == null) { $m = ""; }
    if ($m != "") { session::set("cart_msg", ""); }
    return $m;
}

// ── cart + coupon helpers (session-backed) ───────────────────────────────────
function cart_get() {
    session::start();
    $raw = session::get("cart");
    if ($raw == null) { return []; }
    if ($raw == "") { return []; }
    $parsed = json::decode($raw);
    if ($parsed == null) { return []; }
    return $parsed;
}
function cart_save($cart) { session::start(); session::set("cart", json::encode($cart)); }
function coupon_code() { session::start(); $x = session::get("coupon"); if ($x == null) { return ""; } return $x; }
function coupon_row($c, $code) {
    if ($code == "") { return null; }
    $rows = db::query($c, "SELECT code, kind, value FROM coupons WHERE code = ? AND active = 1", [$code]);
    if (count($rows) == 0) { return null; }
    return $rows[0];
}
function coupon_discount($subtotal, $row) {
    if ($row == null) { return 0.0; }
    $v = type::to_float($row["value"]);
    if ($row["kind"] == "percent") { return $subtotal * $v / 100.0; }
    return $v;
}

// ── storefront routes ─────────────────────────────────────────────────────────
route("POST", "/cart/coupon", function() {
    session::start();
    session::set("coupon", string::trim(request::post("code")));
    return response::redirect("/cart");
});
route("POST", "/cart/add", function() {
    $c = conn();
    $slug = request::post("slug");
    $sku = cm_post("variant");
    $rows = product_published_rows($c, $slug);
    if (count($rows) == 0) { return response::redirect("/product"); }
    $vals = json::decode($rows[0]["fields_json"]);
    $price = "0";
    if ($vals != null) { try { $price = $vals["price"]; } catch ($e) { $price = "0"; } }
    if ($price == null) { $price = "0"; }
    // Varyantlı ürün: geçerli bir sku şart; fiyat varyanttan (boşsa ürün fiyatı), ad satırda taşınır.
    $variants = product_variants($vals);
    $variant = null; $vname = "";
    if (count($variants) > 0) {
        $variant = variant_find($variants, $sku);
        if ($variant == null) { cart_msg_set("Lütfen bir varyant seçin."); return response::redirect("/cart"); }
        $vp = cm_str($variant, "fiyat", ""); if ($vp != "") { $price = $vp; }
        $vname = cm_str($variant, "ad", $sku);
    } else { $sku = ""; }
    $cart = cart_get();
    // Stok: tanımlıysa sepetteki mevcut adet + 1 stoğu aşamaz (stok 0 → hemen red).
    $have = 0;
    foreach ($cart as $it) { if (cart_line_is($it, $slug, $sku)) { $have = type::to_int($it["qty"]); } }
    if ($variant != null) {
        $stock = variant_stock($variant);
        if ($stock >= 0 && $stock <= $have) { cart_msg_set("Bu varyant için yeterli stok yok."); return response::redirect("/cart"); }
    }
    $new = []; $found = false;
    foreach ($cart as $it) {
        if (cart_line_is($it, $slug, $sku)) { $it["qty"] = $it["qty"] + 1; $found = true; }
        $new = array::push($new, $it);
    }
    if (!$found) {
        $new = array::push($new, ["slug" => $slug, "title" => $rows[0]["title"], "price" => $price, "qty" => 1, "variant" => $sku, "variant_name" => $vname]);
    }
    cart_save($new);
    return response::redirect("/cart");
});
route("POST", "/cart/remove", function() {
    $slug = request::post("slug");
    $sku = cm_post("variant");
    $cart = cart_get();
    $new = [];
    foreach ($cart as $it) { if (!cart_line_is($it, $slug, $sku)) { $new = array::push($new, $it); } }
    cart_save($new);
    return response::redirect("/cart");
});
route("GET", "/cart", function() {
    $c = conn();
    $cart = cart_get();
    $items = []; $subtotal = 0.0;
    foreach ($cart as $it) {
        $line = type::to_float($it["price"]) * $it["qty"];
        $subtotal = $subtotal + $line;
        $vname = cm_str($it, "variant_name", "");
        $items = array::push($items, ["title" => $it["title"], "price" => $it["price"], "qty" => $it["qty"], "line" => $line, "slug" => $it["slug"],
                                      "variant" => cart_line_variant($it), "variant_name" => $vname, "has_variant" => ($vname != "")]);
    }
    $msg = cart_msg_take();
    $code = coupon_code();
    $crow = coupon_row($c, $code);
    $disc = coupon_discount($subtotal, $crow);
    if ($disc > $subtotal) { $disc = $subtotal; }
    $total = $subtotal - $disc;
    return response::html(ext_view("commerce", "cart.html", [
        "items" => $items, "count" => count($cart), "has_items" => (count($cart) > 0),
        "subtotal" => $subtotal, "has_disc" => ($crow != null), "disc" => $disc, "code" => $code, "total" => $total,
        "msg" => $msg, "has_msg" => ($msg != ""), "csrf" => csrf_field_safe()
    ]));
});
route("POST", "/cart/update", function() {
    $c = conn();
    $slug = request::post("slug");
    $sku = cm_post("variant");
    $qty = type::to_int(request::post("qty"));
    // Varyant stoğu tanımlıysa adet stokla sınırlanır (stok 0 → satır düşer).
    $stock = cart_line_stock($c, $slug, $sku);
    if ($stock >= 0 && $qty > $stock) { $qty = $stock; cart_msg_set("Adet mevcut stokla sınırlandı."); }
    $cart = cart_get(); $new = [];
    foreach ($cart as $it) {
        if (cart_line_is($it, $slug, $sku)) {
            if ($qty > 0) { $it["qty"] = $qty; $new = array::push($new, $it); }
        } else { $new = array::push($new, $it); }
    }
    cart_save($new);
    return response::redirect("/cart");
});
route("POST", "/checkout", function() {
    // Demo checkout: no payment yet (roadmap Phase A). Persists a real order + line
    // items, clears the cart, confirms — the WooCommerce "order record" half.
    $c = conn();
    $cart = cart_get();
    if (count($cart) == 0) { return response::redirect("/cart"); }
    // Son stok kontrolü (sepete eklendikten sonra stok değişmiş olabilir).
    foreach ($cart as $it) {
        $stock = cart_line_stock($c, $it["slug"], cart_line_variant($it));
        if ($stock >= 0 && type::to_int($it["qty"]) > $stock) {
            cart_msg_set("Stok yetersiz: " . $it["title"] . " " . cm_str($it, "variant_name", ""));
            return response::redirect("/cart");
        }
    }
    // Kötüye kullanım sınırı (audit LP-08): IP başına 10 dk'da en fazla 10 sipariş.
    if (!throttle_hit("checkout:" . request::ip(), 10, 600)) {
        cart_msg_set("Çok fazla deneme yapıldı. Lütfen birkaç dakika sonra tekrar deneyin.");
        return response::redirect("/cart");
    }
    $email = request::post("email"); if ($email == null) { $email = ""; }
    $cust_name = request::post("cust_name"); if ($cust_name == null) { $cust_name = ""; }
    $address = request::post("address"); if ($address == null) { $address = ""; }
    $phone = request::post("phone"); if ($phone == null) { $phone = ""; }
    $email = string::trim($email);
    // Alan boyutları sınırlı (DB + posta gövdesi); e-posta biçimi doğrulanır.
    $cust_name = string::substr(string::trim($cust_name), 0, 120);
    $address = string::substr($address, 0, 1000);
    $phone = string::substr(string::trim($phone), 0, 40);
    if ($email != "" && !email_looks_valid($email)) {
        cart_msg_set("Geçerli bir e-posta adresi girin.");
        return response::redirect("/cart");
    }
    // Müşteri kopyası: site açık bildirim rölesine dönmesin diye IP başına 10 dk'da 3 posta.
    // (İç kopya contact_email'e koşulsuz gider.) Giriş yapmış üyenin siparişi hesabına bağlanır.
    $cust_mail = $email;
    if ($cust_mail != "" && !throttle_hit("comail:" . request::ip(), 3, 600)) { $cust_mail = ""; }
    session::start();
    $member_id = type::to_int(session::get("member_id"));
    $subtotal = 0.0;
    foreach ($cart as $it) { $subtotal = $subtotal + type::to_float($it["price"]) * $it["qty"]; }
    $code = coupon_code();
    $crow = coupon_row($c, $code);
    $disc = coupon_discount($subtotal, $crow);
    if ($disc > $subtotal) { $disc = $subtotal; }
    $total = $subtotal - $disc;
    $applied = ""; if ($crow != null) { $applied = $code; }
    $ts = date::timestamp();
    db::exec($c, "INSERT INTO orders (email, cust_name, address, phone, coupon, total, status, created_at, member_id) VALUES (?, ?, ?, ?, ?, ?, 'received', ?, ?)", [$email, $cust_name, $address, $phone, $applied, "" . $total, $ts, $member_id]);
    $oid = db::last_id($c);
    foreach ($cart as $it) {
        db::exec($c, "INSERT INTO order_items (order_id, slug, title, price, qty, variant_name, variant_sku) VALUES (?, ?, ?, ?, ?, ?, ?)",
            [$oid, $it["slug"], $it["title"], "" . $it["price"], $it["qty"], cm_str($it, "variant_name", ""), cart_line_variant($it)]);
        variant_stock_decrement($c, $it["slug"], cart_line_variant($it), type::to_int($it["qty"]));
    }
    $n = count($cart);
    cart_save([]);
    session::start(); session::set("coupon", "");
    // Sipariş onayı e-postası (müşteri + contact_email kopyası). Posta hatası
    // checkout'u ASLA düşürmez — order_confirm_mail her şeyi yutar.
    order_confirm_mail($oid, $cust_mail, $cust_name, $cart, $subtotal, $disc, $applied, $total);
    return response::html(ext_view("commerce", "checkout.html", ["count" => $n, "order_id" => $oid, "total" => $total]));
});
// Sipariş özeti postası: kalemler (varyantlı), ara toplam / indirim / toplam, sipariş no.
// orders.email müşteri adresi; boşsa yalnız contact_email'e (varsa) gider.
function order_confirm_mail($oid, $email, $cust_name, $cart, $subtotal, $disc, $coupon, $total) {
    try {
        if (!mailer_enabled()) { return; }
        $rows = [];
        $rows = array::push($rows, ["k" => "Sipariş No", "v" => "#" . $oid]);
        if ($cust_name != "") { $rows = array::push($rows, ["k" => "Ad Soyad", "v" => $cust_name]); }
        foreach ($cart as $it) {
            $label = $it["title"];
            $vn = cm_str($it, "variant_name", ""); if ($vn != "") { $label = $label . " (" . $vn . ")"; }
            $rows = array::push($rows, ["k" => $label, "v" => $it["qty"] . " × " . $it["price"]]);
        }
        $rows = array::push($rows, ["k" => "Ara toplam", "v" => "" . $subtotal]);
        if ($disc > 0) { $rows = array::push($rows, ["k" => "İndirim (" . $coupon . ")", "v" => "-" . $disc]); }
        $rows = array::push($rows, ["k" => "Toplam", "v" => "" . $total]);
        $subject = "Siparişiniz alındı: #" . $oid;
        $b = mailer_kv_bodies($subject, "Siparişiniz için teşekkürler. Özet aşağıdadır.", $rows, "Sipariş durumunuzu hesabınızdan takip edebilirsiniz.");
        if ($email != "") { mailer_send($email, $subject, $b["text"], $b["html"]); }
        $copy = mailer_contact_email();
        if ($copy != "" && $copy != $email) {
            $bc = mailer_kv_bodies("Yeni sipariş: #" . $oid, "Müşteri: " . $email, $rows, "");
            mailer_send($copy, "Yeni sipariş: #" . $oid, $bc["text"], $bc["html"]);
        }
    } catch ($e) { }
}

// ── admin routes: orders + coupons ────────────────────────────────────────────
route("GET", "/admin/orders", function() {
    if (!is_admin()) { return response::redirect("/admin/login"); }
    if (!can("orders")) { return response::status(403, "Yetkiniz yok."); }
    $c = conn();
    $orders = db::query($c, "SELECT id, email, total, status, created_at FROM orders ORDER BY id DESC", []);
    $items = [];
    foreach ($orders as $o) {
        $mail = $o["email"]; if ($mail == "") { $mail = "—"; }
        $items = array::push($items, ["id" => $o["id"], "email" => $mail, "total" => $o["total"], "status" => $o["status"]]);
    }
    return response::html(ext_admin_view("commerce", "admin_orders.html", ["items" => $items, "count" => count($orders)]));
});
route("GET", "/admin/order/{id}", function() {
    if (!is_admin()) { return response::redirect("/admin/login"); }
    if (!can("orders")) { return response::status(403, "Yetkiniz yok."); }
    $c = conn();
    $id = request::param("id");
    $orows = db::query($c, "SELECT id, email, cust_name, address, phone, total, status FROM orders WHERE id = ?", [$id]);
    if (count($orows) == 0) { return response::status(404, view("notfound.html", [])); }
    $o = $orows[0];
    $items = db::query($c, "SELECT title, price, qty, variant_name FROM order_items WHERE order_id = ?", [$id]);
    $items_html = "";
    foreach ($items as $it) {
        $vn = cm_str($it, "variant_name", "");
        $vh = ""; if ($vn != "") { $vh = " <span class=\"muted\">(" . html::escape($vn) . ")</span>"; }
        $items_html = $items_html . "<tr><td>" . html::escape($it["title"]) . $vh . "</td><td>" . html::escape($it["price"]) . " &#8378;</td><td>" . $it["qty"] . "</td></tr>";
    }
    $mail = $o["email"];
    if ($mail == "") { $mail = "—"; }
    $sel = "";
    foreach (cfg_order_statuses() as $st) {
        $selattr = ""; if ($st == $o["status"]) { $selattr = " selected"; }
        $sel = $sel . "<option value=\"" . $st . "\"" . $selattr . ">" . $st . "</option>";
    }
    $cn = $o["cust_name"]; if ($cn == null) { $cn = ""; } if ($cn == "") { $cn = "—"; }
    $addr = $o["address"]; if ($addr == null) { $addr = ""; } if ($addr == "") { $addr = "—"; }
    $ph = $o["phone"]; if ($ph == null) { $ph = ""; } if ($ph == "") { $ph = "—"; }
    return response::html(ext_admin_view("commerce", "admin_order.html", ["id" => $o["id"], "email" => $mail, "cust_name" => $cn, "address" => $addr, "phone" => $ph, "total" => $o["total"], "status" => $o["status"], "items" => $items_html, "status_options" => $sel, "csrf" => csrf_field_safe()]));
});
route("POST", "/admin/order/{id}/status", function() {
    if (!is_admin()) { return response::redirect("/admin/login"); }
    if (!can("orders")) { return response::status(403, "Yetkiniz yok."); }
    $c = conn();
    $id = request::param("id");
    $status = request::post("status");
    if (array::contains(cfg_order_statuses(), $status)) {
        db::exec($c, "UPDATE orders SET status = ? WHERE id = ?", [$status, $id]);
    }
    return response::redirect("/admin/order/" . $id);
});
route("GET", "/admin/coupons", function() {
    if (!is_admin()) { return response::redirect("/admin/login"); }
    if (!can("coupons")) { return response::status(403, "Yetkiniz yok."); }
    $c = conn();
    $rows = db::query($c, "SELECT code, kind, value, active FROM coupons ORDER BY id DESC", []);
    $html = "";
    foreach ($rows as $r) {
        $act = "hayır"; if (type::to_int($r["active"]) == 1) { $act = "evet"; }
        $html = $html . "<tr><td>" . html::escape($r["code"]) . "</td><td>" . html::escape($r["kind"]) . "</td><td>" . html::escape($r["value"]) . "</td><td>" . $act . "</td></tr>";
    }
    if ($html == "") { $html = "<tr><td colspan=\"4\" class=\"muted\">Kupon yok.</td></tr>"; }
    return response::html(ext_admin_view("commerce", "admin_coupons.html", ["rows" => $html, "count" => count($rows), "csrf" => csrf_field_safe()]));
});
route("POST", "/admin/coupons/new", function() {
    if (!is_admin()) { return response::redirect("/admin/login"); }
    if (!can("coupons")) { return response::status(403, "Yetkiniz yok."); }
    $c = conn();
    $code = string::trim(request::post("code"));
    $kind = request::post("kind"); if ($kind != "fixed") { $kind = "percent"; }
    $value = string::trim(request::post("value"));
    if ($code != "") {
        $ex = db::query($c, "SELECT id FROM coupons WHERE code = ?", [$code]);
        if (count($ex) == 0) { db::exec($c, "INSERT INTO coupons (code, kind, value, active) VALUES (?, ?, ?, 1)", [$code, $kind, $value]); }
    }
    return response::redirect("/admin/coupons");
});
// ── admin: categories (domain model CRUD) ─────────────────────────────────────
route("GET", "/admin/categories", function() {
    if (!is_admin()) { return response::redirect("/admin/login"); }
    if (!can("products")) { return response::status(403, "Yetkiniz yok."); }
    $c = conn();
    $tree = category_tree($c);
    // Girintiyi .lk'te hazırla (şablonda aritmetik yok): her satıra ham "pad" öneği.
    $items = [];
    $parent_opts = "<option value=\"0\">— (üst kategori yok) —</option>";
    foreach ($tree as $cat) {
        $pad = "";
        $i = 0; while ($i < $cat["depth"]) { $pad = $pad . "<span class=\"tree-indent\">&nbsp;&nbsp;&nbsp;&nbsp;</span>"; $i = $i + 1; }
        $branch = ""; if ($cat["depth"] > 0) { $branch = "└ "; }
        $items = array::push($items, ["id" => $cat["id"], "name" => $cat["name"], "slug" => $cat["slug"], "pad" => $pad, "branch" => $branch]);
        $parent_opts = $parent_opts . "<option value=\"" . $cat["id"] . "\">" . category_indent($cat["depth"], "— ") . html::escape($cat["name"]) . "</option>";
    }
    return response::html(ext_admin_view("commerce", "admin_categories.html", ["items" => $items, "count" => count($tree), "parent_options" => $parent_opts, "csrf" => csrf_field_safe()]));
});
route("POST", "/admin/categories/new", function() {
    if (!is_admin()) { return response::redirect("/admin/login"); }
    if (!can("products")) { return response::status(403, "Yetkiniz yok."); }
    $c = conn();
    $name = string::trim(request::post("name"));
    $slug = string::trim(request::post("slug"));
    // Opsiyonel üst kategori. 0 = üst yok. Var olmayan bir id verilirse köke düşür.
    $praw = request::post("parent_id"); if ($praw == null) { $praw = "0"; }
    $parent_id = type::to_int($praw);
    if ($parent_id != 0) {
        if (count(db::query($c, "SELECT id FROM categories WHERE id = ?", [$parent_id])) == 0) { $parent_id = 0; }
    }
    if ($name != "" && string::regex_match($slug, "^[a-z0-9-]+$")) {
        if (count(db::query($c, "SELECT id FROM categories WHERE slug = ?", [$slug])) == 0) {
            // Kendi kendinin üstü olamaz — yeni kayıtta id henüz yok, ama üst kategorinin
            // slug'ı yeni slug ile aynıysa (aynı kaydı işaret ediyorsa) reddet.
            $pslug = "";
            if ($parent_id != 0) {
                $prow = db::query($c, "SELECT slug FROM categories WHERE id = ?", [$parent_id]);
                if (count($prow) > 0) { $pslug = $prow[0]["slug"]; }
            }
            if ($pslug != $slug) { category_create($c, $name, $slug, $parent_id); }
        }
    }
    return response::redirect("/admin/categories");
});
route("POST", "/admin/categories/{id}/delete", function() {
    if (!is_admin()) { return response::redirect("/admin/login"); }
    if (!can("products")) { return response::status(403, "Yetkiniz yok."); }
    category_delete(conn(), type::to_int(request::param("id")));
    return response::redirect("/admin/categories");
});

// ── extension-point overrides: weave commerce into the core UI ─────────────────
// These redefine the core's empty defaults (src/hooks.lk). The core calls them by
// name (static call, VM-safe) and never mentions commerce.
// Marka: ürünün "marka" ilişki alanı (content id) → yayınlanmış marka başlığı + bağlantı.
// Bağlantı markanın KENDİ dilinin önekiyle kurulur (tr ürün / en marka uyumsuzluğunda 404 olmasın).
function product_brand_html($vals) {
    $bid = type::to_int(cm_str($vals, "marka", ""));
    if ($bid <= 0) { return ""; }
    $c = conn();
    $rows = db::query($c, "SELECT c.slug, c.lang, r.title FROM content c JOIN revisions r ON r.id = c.published_rev WHERE c.id = ? AND c.type = 'marka' AND c.published_rev > 0", [$bid]);
    if (count($rows) == 0) { return ""; }
    $href = lang_prefix($rows[0]["lang"]) . "/marka/" . $rows[0]["slug"];
    return "<div class=\"cf-row cf-brand\"><span class=\"cf-label\">Marka</span> <a href=\"" . html::escape($href) . "\">" . html::escape($rows[0]["title"]) . "</a></div>";
}
// Özellikler tablosu ([{"k","v"}] → her hücre kaçışlı).
function product_attributes_html($vals) {
    $attrs = product_attributes($vals);
    if (count($attrs) == 0) { return ""; }
    $rows = "";
    foreach ($attrs as $a) {
        $k = cm_str($a, "k", ""); $v = cm_str($a, "v", "");
        if ($k == "" && $v == "") { continue; }
        $rows = $rows . "<tr><th>" . html::escape($k) . "</th><td>" . html::escape($v) . "</td></tr>";
    }
    if ($rows == "") { return ""; }
    return "<div class=\"cf-attrs\"><h3>Özellikler</h3><table class=\"attrs\"><tbody>" . $rows . "</tbody></table></div>";
}
// Varyant seçimi: <select name="variant"> (etiket = ad, fiyat ürün fiyatından farklıysa eklenir; stok 0 → pasif).
function product_variant_select_html($variants, $base_price) {
    if (count($variants) == 0) { return ""; }
    $opts = "";
    foreach ($variants as $v) {
        $sku = cm_str($v, "sku", ""); if ($sku == "") { continue; }
        $label = cm_str($v, "ad", $sku);
        $fp = cm_str($v, "fiyat", "");
        if ($fp != "" && $fp != $base_price) { $label = $label . " — " . $fp . " ₺"; }
        $dis = "";
        if (variant_stock($v) == 0) { $label = $label . " (tükendi)"; $dis = " disabled"; }
        $opts = $opts . "<option value=\"" . html::escape($sku) . "\"" . $dis . ">" . html::escape($label) . "</option>";
    }
    if ($opts == "") { return ""; }
    return "<label class=\"variant-pick\">Seçenek <select name=\"variant\" required>" . $opts . "</select></label> ";
}
// A priced (or variant-priced) content item gets brand + attributes + an add-to-cart
// form below its body. Items with no price, no variants, no brand, no attributes → "" (as before).
function xp_content_after_body($ctx) {
    $vals = $ctx["vals"];
    $price = ""; if ($vals != null) { try { $price = $vals["price"]; } catch ($e) { $price = ""; } }
    if ($price == null) { $price = ""; }
    $out = product_brand_html($vals) . product_attributes_html($vals);
    $variants = product_variants($vals);
    if ($price == "" && count($variants) == 0) { return $out; }
    $sel = product_variant_select_html($variants, $price);
    if (count($variants) > 0 && $sel == "") { return $out; }
    return $out . "<form method=\"post\" action=\"/cart/add\" class=\"add-cart\">" . csrf_field_safe()
         . "<input type=\"hidden\" name=\"slug\" value=\"" . html::escape($ctx["slug"]) . "\">" . $sel . "<button>Sepete ekle</button></form>";
}
// A priced item emits Product/Offer JSON-LD in <head>.
function xp_content_head($ctx) {
    $vals = $ctx["vals"];
    $price = ""; if ($vals != null) { try { $price = $vals["price"]; } catch ($e) { $price = ""; } }
    if ($price == null || $price == "") { return ""; }
    $ld = ["@context" => "https://schema.org", "@type" => "Product",
           "name" => $ctx["title"], "description" => $ctx["desc"],
           "offers" => ["@type" => "Offer", "price" => $price, "priceCurrency" => "TRY", "availability" => "https://schema.org/InStock"]];
    return "<script type=\"application/ld+json\">" . json::encode($ld) . "</script>";
}
// Dashboard: product / order / revenue stat tiles.
function xp_dashboard_stats($x) {
    $c = conn();
    $n_products = type::to_int(db::query($c, "SELECT COUNT(*) AS n FROM content WHERE type = 'product' AND published_rev > 0", [])[0]["n"]);
    $n_orders   = type::to_int(db::query($c, "SELECT COUNT(*) AS n FROM orders", [])[0]["n"]);
    $revenue    = db::query($c, "SELECT COALESCE(SUM(total), 0) AS r FROM orders", [])[0]["r"];
    return "<div class=\"stat\"><div class=\"stat-n\">" . $n_products . "</div><div class=\"stat-l\">Ürün</div></div>"
         . "<div class=\"stat\"><div class=\"stat-n\">" . $n_orders . "</div><div class=\"stat-l\">Sipariş</div></div>"
         . "<div class=\"stat\"><div class=\"stat-n\">" . $revenue . " &#8378;</div><div class=\"stat-l\">Ciro</div></div>";
}
// Dashboard: recent orders panel.
function xp_dashboard_panels($x) {
    $c = conn();
    $recent = db::query($c, "SELECT id, cust_name, total, status FROM orders ORDER BY id DESC LIMIT 5", []);
    $rh = "";
    foreach ($recent as $o) {
        $cn = $o["cust_name"]; if ($cn == null) { $cn = ""; } if ($cn == "") { $cn = "—"; }
        $rh = $rh . "<tr><td><a href=\"/admin/order/" . $o["id"] . "\">#" . $o["id"] . "</a></td><td>" . html::escape($cn) . "</td><td>" . html::escape("" . $o["total"]) . " &#8378;</td><td>" . html::escape($o["status"]) . "</td></tr>";
    }
    if ($rh == "") { $rh = "<tr><td colspan=\"4\" class=\"muted\">Henüz sipariş yok.</td></tr>"; }
    return "<h3>Son siparişler</h3><div class=\"table-wrap\"><table><thead><tr><th>No</th><th>Müşteri</th><th>Tutar</th><th>Durum</th></tr></thead><tbody>" . $rh . "</tbody></table></div>";
}
// Product listing: clickable category chips (filter via ?category=slug).
function xp_listing_filters($c, $type, $lang, $active) {
    if ($type != "product") { return ""; }
    $base = lang_prefix($lang) . "/product";
    $all = "chip"; if ($active == "") { $all = "chip active"; }
    $out = "<div class=\"cat-chips\"><a href=\"" . $base . "\" class=\"" . $all . "\">Tümü</a>";
    // Ağacı girintili çiplerle göster; bir üst kategori seçilince (aşağıdaki filtre)
    // tüm alt ağacın ürünleri listelenir.
    foreach (category_tree($c) as $cat) {
        $cls = "chip"; if ($active == $cat["slug"]) { $cls = "chip active"; }
        $pfx = category_indent($cat["depth"], "— ");
        $out = $out . "<a href=\"" . $base . "?category=" . $cat["slug"] . "\" class=\"" . $cls . "\">" . $pfx . html::escape($cat["name"]) . "</a>";
    }
    return $out . "</div>";
}
// Subtree-aware category filter (commerce override of the core seam). When a PARENT
// product category is selected, its whole subtree (Giyim → Tişört …) is accepted;
// leaf categories and every non-product type keep exact-match behaviour. This plugs
// into render_listing via the xp_listing_category_match seam — no core function is
// shadowed, so a future core change to the listing can't silently drift here.
function xp_listing_category_match($c, $type, $cat) {
    if ($type == "product") { return category_descendants($c, $cat); }
    return [$cat];
}
// Homepage showcase: a "Featured products" grid (uses the core's generic card builder).
function xp_home_sections($ctx) {
    $c = conn();
    $lang = $ctx["lang"]; $pfx = $ctx["pfx"];
    $rows = db::query($c, "SELECT c.slug, r.title, r.fields_json FROM content c JOIN revisions r ON r.id = c.published_rev WHERE c.type = 'product' AND c.lang = ? AND c.published_rev > 0 ORDER BY c.updated_at DESC, c.id DESC LIMIT 4", [$lang]);
    if (count($rows) == 0) { return ""; }
    return "<div class=\"section-head\"><h2>Öne çıkan ürünler</h2><a class=\"more\" href=\"" . $pfx . "/product\">Tüm ürünler &rarr;</a></div><div class=\"cards\">" . cards_html($pfx . "/product", $rows) . "</div>";
}
// commerce manages the "product" content type in its OWN group, so the core's
// "İçerik Yönetimi" list skips it.
function xp_hidden_types() { return ["product"]; }
// commerce modülleri kendi yetkisiyle yönetilir (audit LP-01): "content" yetkisi
// ürün/markaları düzenlemeye yetmez.
function xp_type_permission($slug) {
    if ($slug == "product" || $slug == "marka") { return "products"; }
    return "content";
}
// commerce contributes its permissions to the RBAC catalog.
function xp_permissions() {
    return [["key" => "products", "label" => "Ürünler & kategoriler"], ["key" => "orders", "label" => "Siparişler"], ["key" => "coupons", "label" => "Kuponlar"]];
}

// ── categories: a DOMAIN MODEL (real table + thin helpers, no query-builder) ───
// Kategoriler hiyerarşiktir: parent_id = 0 kök (üst kategori yok), aksi halde üst
// kategorinin id'si. "Giyim > Tişört" gibi ağaçlar kurulur.
function category_all($c) { return db::query($c, "SELECT id, name, slug, parent_id FROM categories ORDER BY name", []); }
function category_create($c, $name, $slug, $parent_id) { db::exec($c, "INSERT INTO categories (name, slug, parent_id) VALUES (?, ?, ?)", [$name, $slug, $parent_id]); }
function category_delete($c, $id) {
    // Silinen kategorinin çocuklarını büyükanne/dede'ye (silinenin parent'ına) taşı —
    // böylece yetim satır kalmaz ve ağaç bozulmaz. Tabloyu ASLA düşürmeyiz.
    $rows = db::query($c, "SELECT parent_id FROM categories WHERE id = ?", [$id]);
    $pid = 0;
    if (count($rows) > 0) { $pid = type::to_int($rows[0]["parent_id"]); }
    db::exec($c, "UPDATE categories SET parent_id = ? WHERE parent_id = ?", [$pid, $id]);
    db::exec($c, "DELETE FROM categories WHERE id = ?", [$id]);
}

// İki-geçişli gruplama (derin özyineleme yerine güvenli): tüm satırları çek, parent_id'ye
// göre grupla. Yetim satır (parent'ı silinmiş) kök gibi ele alınır → kaybolmaz.
function category_group_by_parent($rows) {
    // $ids / $by_parent string anahtarlı MAP'ler — liste [] olursa "2" gibi anahtar
    // indekse çevrilip "out of bounds" verir; assoc map yaratmak şart.
    $ids = array::new_assoc();
    foreach ($rows as $r) { $ids["" . $r["id"]] = true; }
    $by_parent = array::new_assoc();
    foreach ($rows as $r) {
        $pk = "" . $r["parent_id"];
        // assoc map'te olmayan anahtar null döner (throw ETMEZ) → try/catch değil,
        // açık null kontrolü şart.
        $known = $ids[$pk];
        if ($known == null) { $pk = "0"; }
        $lst = $by_parent[$pk];
        if ($lst == null) { $lst = []; }
        $lst = array::push($lst, $r);
        $by_parent[$pk] = $lst;
    }
    return $by_parent;
}
// Ağacı düz bir listeye açar: parent önce, sonra çocukları; her satıra "depth" eklenir.
// $guard döngü/aşırı-derinlik koruması (bounded).
function category_tree_walk($by_parent, $pk, $depth, $out, $guard) {
    if ($guard > 64) { return $out; }
    $kids = $by_parent[$pk];
    if ($kids == null) { $kids = []; }
    foreach ($kids as $r) {
        $r["depth"] = $depth;
        $out = array::push($out, $r);
        $out = category_tree_walk($by_parent, "" . $r["id"], $depth + 1, $out, $guard + 1);
    }
    return $out;
}
function category_tree($c) {
    $by_parent = category_group_by_parent(category_all($c));
    $out = [];
    return category_tree_walk($by_parent, "0", 0, $out, 0);
}
// Bir slug'ın kendisi + tüm alt (torun dahil) slug'ları. Storefront'ta bir üst kategori
// seçilince tüm alt ağacın ürünlerini göstermek için kullanılır.
function category_desc_walk($by_parent, $pk, $acc, $guard) {
    if ($guard > 64) { return $acc; }
    $kids = $by_parent[$pk];
    if ($kids == null) { $kids = []; }
    foreach ($kids as $r) {
        $acc = array::push($acc, $r["slug"]);
        $acc = category_desc_walk($by_parent, "" . $r["id"], $acc, $guard + 1);
    }
    return $acc;
}
function category_descendants($c, $slug) {
    $rows = category_all($c);
    $by_parent = category_group_by_parent($rows);
    $start_id = 0;
    foreach ($rows as $r) { if ($r["slug"] == $slug) { $start_id = $r["id"]; } }
    $acc = [$slug];
    if ($start_id == 0) { return $acc; }
    return category_desc_walk($by_parent, "" . $start_id, $acc, 0);
}
// Derinliğe göre bir önek dizesi üretir (indent birimini yineleyerek).
function category_indent($depth, $unit) {
    $s = ""; $i = 0;
    while ($i < $depth) { $s = $s . $unit; $i = $i + 1; }
    return $s;
}

// Custom field type "category": a <select> of categories in the content editor.
// Tekrarlı satır alanı (özellikler / varyantlar): satırlar gizli bir textarea'da JSON liste
// olarak taşınır; küçük vanilla JS satır ekle/sil/senkron yapar. JS INLINE'dır (admin layout'a
// dokunulmaz), window.cmRepInit ile bir kez tanımlanır, data-init ile yeniden-init korunur.
function commerce_repeater_input($name, $value, $kind) {
    $label = "Özellikler"; if ($kind == "variants") { $label = "Varyantlar"; }
    $head = "<th>Özellik adı</th><th>Değer</th>";
    if ($kind == "variants") { $head = "<th>Ad</th><th>SKU</th><th>Fiyat</th><th>Stok</th>"; }
    $js = "<script>(function(){if(!window.cmRepInit){window.cmRepInit=function(){"
        . "var cols={attributes:[['k','Özellik adı'],['v','Değer']],variants:[['ad','Ad'],['sku','SKU'],['fiyat','Fiyat'],['stok','Stok']]};"
        . "var els=document.querySelectorAll('.cm-rep:not([data-init])');"
        . "for(var i=0;i<els.length;i++){(function(el){el.setAttribute('data-init','1');"
        . "var cs=cols[el.getAttribute('data-kind')]||[],ta=el.querySelector('.cm-rep-json'),tb=el.querySelector('tbody');"
        . "var rows=[];try{var p=JSON.parse(ta.value||'[]');if(Array.isArray(p))rows=p;}catch(e){}"
        . "function sync(){var out=[],trs=tb.querySelectorAll('tr');for(var r=0;r<trs.length;r++){var o={},ins=trs[r].querySelectorAll('input'),empty=true;"
        . "for(var c=0;c<cs.length;c++){o[cs[c][0]]=ins[c]?ins[c].value:'';if(o[cs[c][0]]!=='')empty=false;}if(!empty)out.push(o);}ta.value=JSON.stringify(out);}"
        . "function addRow(d){var tr=document.createElement('tr');for(var c=0;c<cs.length;c++){var td=document.createElement('td'),inp=document.createElement('input');"
        . "inp.type='text';inp.placeholder=cs[c][1];inp.value=(d&&d[cs[c][0]]!=null)?String(d[cs[c][0]]):'';inp.addEventListener('input',sync);td.appendChild(inp);tr.appendChild(td);}"
        . "var td2=document.createElement('td'),del=document.createElement('button');del.type='button';del.className='del';del.textContent='\\u00d7';"
        . "del.addEventListener('click',function(){tr.parentNode.removeChild(tr);sync();});td2.appendChild(del);tr.appendChild(td2);tb.appendChild(tr);}"
        . "for(var r=0;r<rows.length;r++)addRow(rows[r]);"
        . "el.querySelector('.cm-rep-add').addEventListener('click',function(){addRow(null);sync();});"
        . "})(els[i]);}};}window.cmRepInit();})();</script>";
    return "<div class=\"field-block cm-rep\" data-kind=\"" . $kind . "\" data-field=\"" . $name . "\">"
         . "<span class=\"fb-label\">" . $name . " <span class=\"muted\">(" . $label . ")</span></span>"
         . "<div class=\"table-wrap\"><table class=\"cm-rep-t\"><thead><tr>" . $head . "<th></th></tr></thead><tbody></tbody></table></div>"
         . "<button type=\"button\" class=\"btn cm-rep-add\">+ Satır ekle</button>"
         . "<textarea name=\"" . $name . "\" class=\"cm-rep-json\" hidden>" . html::escape($value) . "</textarea>"
         . "</div>" . $js;
}
function xp_field_input($c, $f, $value) {
    $t = $f["type"];
    if ($value == null) { $value = ""; }
    if ($t == "attributes") { return commerce_repeater_input($f["name"], $value, "attributes"); }
    if ($t == "variants")   { return commerce_repeater_input($f["name"], $value, "variants"); }
    if ($t != "category") { return ""; }
    // Ağacı derinliğe göre "— " öneğiyle girintili göster ki hiyerarşi seçim kutusunda okunsun.
    $opts = "<option value=\"\">—</option>";
    foreach (category_tree($c) as $cat) {
        $sel = ""; if ($cat["slug"] == $value) { $sel = " selected"; }
        $pfx = category_indent($cat["depth"], "— ");
        $opts = $opts . "<option value=\"" . $cat["slug"] . "\"" . $sel . ">" . $pfx . html::escape($cat["name"]) . "</option>";
    }
    return "<label>" . $f["name"] . "<select name=\"" . $f["name"] . "\">" . $opts . "</select></label>";
}
// Admin sidebar: the "Ticaret" nav group — each item gated by its own permission,
// so the group appears only for roles that can use part of it.
function xp_admin_nav($ctx) {
    $items = "";
    if (can("products")) {
        $items = $items . "<a href=\"/admin/type/product\" data-nav=\"/admin/type/product\"><span class=\"ic\">▦</span> Ürünler</a>"
                        . "<a href=\"/admin/categories\" data-nav=\"/admin/categories\"><span class=\"ic\">◧</span> Kategoriler</a>";
    }
    if (can("orders")) {
        $items = $items . "<a href=\"/admin/orders\" data-nav=\"/admin/order\"><span class=\"ic\">▧</span> Siparişler</a>";
    }
    if (can("coupons")) {
        $items = $items . "<a href=\"/admin/coupons\" data-nav=\"/admin/coupons\"><span class=\"ic\">%</span> Kuponlar</a>";
    }
    if ($items == "") { return ""; }
    return "<div class=\"grp\">Ticaret</div>" . $items;
}
