// extensions/commerce/schema.lk — commerce's schema + demo seed, as migrate/seed
// hooks. Kept ROUTES-FREE so setup (CLI `lk`, no web context) can load it to run
// migrations without pulling in the runtime route() registrations. commerce.lk uses
// this file too, so the runtime also has the hooks registered (harmless there).
// hook_add comes from src/hooks.lk, which the composition root (setup_v2.lk / app.lk)
// loads before this file — extensions don't cross-include the core by relative path.
use db;
use json;
use date;
use array;
use type;

// Tables owned by commerce (idempotent — safe on every migrate run). Overrides the
// core's no-op xp_migrate default; setup_v2.lk calls xp_migrate($c) after core tables.
function xp_migrate($c) {
    db::exec($c, "CREATE TABLE IF NOT EXISTS orders (id INTEGER PRIMARY KEY AUTOINCREMENT, email VARCHAR(200), total VARCHAR(40), status VARCHAR(20) DEFAULT 'received', created_at INTEGER DEFAULT 0, cust_name VARCHAR(120) DEFAULT '', address TEXT DEFAULT '', phone VARCHAR(40) DEFAULT '', coupon VARCHAR(40) DEFAULT '')", []);
    db::exec($c, "CREATE TABLE IF NOT EXISTS order_items (id INTEGER PRIMARY KEY AUTOINCREMENT, order_id INTEGER, slug VARCHAR(200), title VARCHAR(200), price VARCHAR(40), qty INTEGER DEFAULT 1)", []);
    db::exec($c, "CREATE TABLE IF NOT EXISTS coupons (id INTEGER PRIMARY KEY AUTOINCREMENT, code VARCHAR(40) UNIQUE, kind VARCHAR(10) DEFAULT 'percent', value VARCHAR(20) DEFAULT '0', active INTEGER DEFAULT 1)", []);
    db::exec($c, "CREATE TABLE IF NOT EXISTS categories (id INTEGER PRIMARY KEY AUTOINCREMENT, name VARCHAR(120), slug VARCHAR(120) UNIQUE, parent_id INTEGER DEFAULT 0)", []);
    // parent_id fikri hiyerarşi için: 0 = üst kategori yok (kök). Eski kurulumlarda
    // tablo parent_id'siz oluşmuş olabilir → sütunu idempotent şekilde ekle (tabloyu
    // asla düşürme/yeniden yaratma). PRAGMA ile var mı bak, yoksa ALTER ADD COLUMN.
    $has_parent = false;
    foreach (db::query($c, "PRAGMA table_info(categories)", []) as $col) {
        if ($col["name"] == "parent_id") { $has_parent = true; }
    }
    if (!$has_parent) {
        db::exec($c, "ALTER TABLE categories ADD COLUMN parent_id INTEGER DEFAULT 0", []);
    }
    // order_items: varyant adı + sku (nullable). Eski kurulumlarda sütun yok → PRAGMA ile
    // idempotent ekle; tablo ASLA düşürülmez/yeniden yaratılmaz.
    commerce_ensure_col($c, "order_items", "variant_name", "VARCHAR(120)");
    commerce_ensure_col($c, "order_items", "variant_sku", "VARCHAR(80)");
    // Sipariş ↔ üye bağı (audit LP-07): sipariş geçmişi e-posta eşleşmesiyle DEĞİL,
    // giriş yapmış üyenin id'siyle listelenir. 0 = misafir siparişi.
    commerce_ensure_col($c, "orders", "member_id", "INTEGER DEFAULT 0");
}
// SQLite'ta ADD COLUMN IF NOT EXISTS yok → PRAGMA table_info ile bak, yoksa ALTER.
function commerce_ensure_col($c, $table, $col, $decl) {
    $found = false;
    foreach (db::query($c, "PRAGMA table_info(" . $table . ")", []) as $ci) {
        if ($ci["name"] == $col) { $found = true; }
    }
    if (!$found) { db::exec($c, "ALTER TABLE " . $table . " ADD COLUMN " . $col . " " . $decl, []); }
}

// ── modül tanımları (yapısal, seed bayrağından BAĞIMSIZ, idempotent) ──────────
// "marka" içerik tipi: ürünün ilişki (relation) hedefi. config_json sütunu spine dilimiyle
// geliyor; henüz yoksa (eski DB / sıralama) config'siz INSERT'e düşülür — try/catch + yeniden kontrol.
function commerce_ensure_brand_type($c) {
    $fields = json::encode([
        ["name" => "title",       "label" => "Marka adı", "type" => "text",     "required" => true],
        ["name" => "logo",        "label" => "Logo",      "type" => "image",    "required" => false],
        ["name" => "website",     "label" => "Web sitesi","type" => "url",      "required" => false],
        ["name" => "description", "label" => "Açıklama",  "type" => "textarea", "required" => false]
    ]);
    $config = json::encode(["group" => "ecommerce", "icon" => "🏷️", "plural" => "Markalar", "singular" => "Marka", "order" => 30]);
    $ex = db::query($c, "SELECT id FROM content_types WHERE slug = 'marka'", []);
    if (count($ex) == 0) {
        try {
            db::exec($c, "INSERT INTO content_types (slug, label, url_pattern, fields_json, config_json) VALUES ('marka', 'Markalar', '/marka/{slug}', ?, ?)", [$fields, $config]);
        } catch ($e) { $ex = []; }
        // config_json sütunu yoksa yukarıdaki INSERT ya fırlatır ya da sessizce başarısız olur → yeniden bak.
        $ex = db::query($c, "SELECT id FROM content_types WHERE slug = 'marka'", []);
        if (count($ex) == 0) {
            db::exec($c, "INSERT INTO content_types (slug, label, url_pattern, fields_json) VALUES ('marka', 'Markalar', '/marka/{slug}', ?)", [$fields]);
        }
        return;
    }
    // Tip var: config_json boşsa doldur (sütun yoksa sessizce geç).
    try {
        $row = db::query($c, "SELECT config_json FROM content_types WHERE slug = 'marka'", []);
        $cur = $row[0]["config_json"];
        if ($cur == null || $cur == "" || $cur == "null") {
            db::exec($c, "UPDATE content_types SET config_json = ? WHERE slug = 'marka'", [$config]);
        }
    } catch ($e) { $cur = ""; }
}
// Ürün tipine marka/özellik/varyant alanlarını ekle — SADECE yoksa (mevcut alanlara ve
// içeriğe dokunmaz). Ürün tipi hiç yoksa no-op.
function commerce_ensure_product_fields($c) {
    $ex = db::query($c, "SELECT fields_json FROM content_types WHERE slug = 'product'", []);
    if (count($ex) == 0) { return; }
    $defs = json::decode($ex[0]["fields_json"]);
    if ($defs == null) { $defs = []; }
    $have = array::new_assoc();
    foreach ($defs as $f) { try { $have["" . $f["name"]] = true; } catch ($e) { $have = $have; } }
    $changed = false;
    if ($have["marka"] == null) {
        $defs = array::push($defs, ["name" => "marka", "label" => "Marka", "type" => "relation", "to" => "marka", "required" => false]);
        $changed = true;
    }
    if ($have["stok"] == null) {
        $defs = array::push($defs, ["name" => "stok", "label" => "Stok (varyantsız ürün; boş = takip yok)", "type" => "int", "required" => false]);
        $changed = true;
    }
    if ($have["ozellikler"] == null) {
        $defs = array::push($defs, ["name" => "ozellikler", "label" => "Özellikler", "type" => "attributes", "required" => false]);
        $changed = true;
    }
    if ($have["varyantlar"] == null) {
        $defs = array::push($defs, ["name" => "varyantlar", "label" => "Varyantlar", "type" => "variants", "required" => false]);
        $changed = true;
    }
    if ($changed) { db::exec($c, "UPDATE content_types SET fields_json = ? WHERE slug = 'product'", [json::encode($defs)]); }
}

// Demo seed (opt-in: LOOKPRESS_SEED=1) — the product type + fixtures the smoke suite asserts.
function xp_seed($c) {
    // Yapısal kısım seed bayrağından BAĞIMSIZ: marka modülü + ürün tipine yeni alanlar
    // (ürün tipi yoksa alan ekleme no-op). Demo veri yalnız LOOKPRESS_SEED=1 ile.
    commerce_ensure_brand_type($c);
    if (env("LOOKPRESS_SEED", "0") == "1") { commerce_seed_demo($c); }
    commerce_ensure_product_fields($c);
}
function commerce_seed_demo($c) {
    $ex = db::query($c, "SELECT id FROM content_types WHERE slug = 'product'", []);
    if (count($ex) == 0) {
        db::exec($c, "INSERT INTO content_types (slug, label, url_pattern, fields_json) VALUES ('product', 'Product', '/product/{slug}', ?)",
            [json::encode([
                ["name" => "title", "type" => "text",     "required" => true],
                ["name" => "body",  "type" => "markdown", "required" => false],
                ["name" => "price", "type" => "text",     "required" => true],
                ["name" => "sku",      "type" => "text",     "required" => false],
                ["name" => "image",    "type" => "image",    "required" => false],
                ["name" => "category", "type" => "category", "required" => false]
            ])]);
    }
    $hcat = db::query($c, "SELECT id FROM categories LIMIT 1", []);
    if (count($hcat) == 0) {
        // Kök kategoriler (parent_id = 0).
        db::exec($c, "INSERT INTO categories (name, slug, parent_id) VALUES ('Giyim', 'giyim', 0)", []);
        $giyim_id = db::last_id($c);
        db::exec($c, "INSERT INTO categories (name, slug, parent_id) VALUES ('Aksesuar', 'aksesuar', 0)", []);
        // Demo alt kategori: "Giyim > Tişört" — hiyerarşiyi gösterir.
        db::exec($c, "INSERT INTO categories (name, slug, parent_id) VALUES ('Tişört', 'tisort', ?)", [$giyim_id]);
    }
    // Demo marka (tr) — ürünler "marka" ilişkisiyle buna bağlanır.
    $brand_id = commerce_seed_content($c, "marka", "lookwear", "tr", "LookWear", "LookPress demo markası.", ["logo" => "", "website" => "https://codlook.com", "description" => "LookPress demo markası."]);
    $have = db::query($c, "SELECT id FROM content WHERE type = 'product' LIMIT 1", []);
    if (count($have) == 0) {
        // Özellikler: [{"k","v"}] listesi; varyantlar: [{"ad","sku","fiyat","stok"}] listesi (JSON string olarak saklanır).
        // Not: kirmizi-tisort VARYANTSIZ kalır (smoke testi slug-only /cart/add yapar) — varyant demo'su mavi-kot'ta.
        $attrs = json::encode([["k" => "Kumaş", "v" => "%100 pamuk"], ["k" => "Kesim", "v" => "Rahat"]]);
        $variants = json::encode([
            ["ad" => "30 Beden", "sku" => "JN-BLU-002-30", "fiyat" => "",       "stok" => "5"],
            ["ad" => "32 Beden", "sku" => "JN-BLU-002-32", "fiyat" => "",       "stok" => "8"],
            ["ad" => "34 Beden", "sku" => "JN-BLU-002-34", "fiyat" => "419.00", "stok" => "0"]
        ]);
        commerce_seed_product($c, "kirmizi-tisort", "tr", "Kırmızı Tişört", "Yüzde 100 pamuk, rahat kesim.", ["price" => "249.90", "sku" => "TS-RED-001", "image" => "", "category" => "giyim", "marka" => "" . $brand_id, "ozellikler" => $attrs, "varyantlar" => ""]);
        commerce_seed_product($c, "kirmizi-tisort", "en", "Red T-Shirt", "100% cotton, comfortable fit.", ["price" => "249.90", "sku" => "TS-RED-001", "image" => "", "category" => "giyim", "marka" => "" . $brand_id, "ozellikler" => $attrs, "varyantlar" => ""]);
        commerce_seed_product($c, "mavi-kot",       "tr", "Mavi Kot Pantolon", "Slim fit, dayanıklı kumaş.", ["price" => "399.00", "sku" => "JN-BLU-002", "image" => "", "category" => "giyim", "marka" => "" . $brand_id, "ozellikler" => "", "varyantlar" => $variants]);
    }
    $hc = db::query($c, "SELECT id FROM coupons LIMIT 1", []);
    if (count($hc) == 0) {
        db::exec($c, "INSERT INTO coupons (code, kind, value, active) VALUES ('WELCOME10', 'percent', '10', 1)", []);
    }
}
function commerce_seed_product($c, $slug, $lang, $title, $body, $fields) {
    return commerce_seed_content($c, "product", $slug, $lang, $title, $body, $fields);
}
// Herhangi bir tipte yayınlanmış demo içerik (idempotent: slug+lang varsa MEVCUT id döner,
// yoksa yaratır ve yeni id döner) — marka ilişkisi için id gerekir.
function commerce_seed_content($c, $type, $slug, $lang, $title, $body, $fields) {
    $ex = db::query($c, "SELECT id FROM content WHERE type = ? AND slug = ? AND lang = ?", [$type, $slug, $lang]);
    if (count($ex) > 0) { return type::to_int($ex[0]["id"]); }
    $ts = date::timestamp();
    db::exec($c, "INSERT INTO content (type, slug, lang, status, created_at, updated_at) VALUES (?, ?, ?, 'published', ?, ?)", [$type, $slug, $lang, $ts, $ts]);
    $cid = db::last_id($c);
    db::exec($c, "INSERT INTO revisions (content_id, rev_no, title, body_md, body_html, fields_json, author_id, created_at, note) VALUES (?, 1, ?, ?, ?, ?, 0, ?, 'demo seed')", [$cid, $title, $body, "<p>" . $body . "</p>", json::encode($fields), $ts]);
    $rid = db::last_id($c);
    db::exec($c, "UPDATE content SET current_rev = ?, published_rev = ? WHERE id = ?", [$rid, $rid, $cid]);
    return type::to_int($cid);
}
